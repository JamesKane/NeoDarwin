load("//rules:disk.bzl", "gpt_disk_image")
load("//rules:ramdisk.bzl", "hfs_ramdisk")

package(default_visibility = ["//visibility:public"])

# The HFS+ root of P1-08a: the static PID 1 test program as /sbin/launchd,
# and /dev for devfs. neoboot loads it as \NeoDarwin\ramdisk; the kernel
# roots on it as md0 (//kernel:sbsa_boot_test).
hfs_ramdisk(
    name = "pid1_root",
    dirs = ["dev"],
    files = {"//tests/qemu/pid1": "sbin/launchd"},
)

# The HFS+ root of P1-08b: the userland base built from Apple source
# (//base:root: dyld, libSystem and the libraries under it) and the
# dynamically linked hello world as /sbin/launchd. Booted by
# //kernel:sbsa_dyld_boot_test.
hfs_ramdisk(
    name = "hello_root",
    dirs = ["dev"],
    files = {"//tests/qemu/hello": "sbin/launchd"},
    trees = ["//base:root"],
)

# The HFS+ roots of P1-08 (docs/base/session.md): the system root (runtime
# libraries, commands and /etc) with macOS's layout.
_SYSTEM_DIRS = [
    "dev",
    "private/tmp",
    "private/var/audit",
    "private/var/db/launchd.db/com.apple.launchd",
    "private/var/empty",
    "private/var/log/com.apple.launchd",
    "private/var/root",
    "private/var/run",
    "private/var/tmp",
]

# /etc/resolv.conf is macOS's link to /var/run/resolv.conf, which the DHCP
# client writes (docs/kernel/network.md, "Name resolution"); it dangles
# until then.
_SYSTEM_LINKS = {
    "etc": "private/etc",
    "private/etc/resolv.conf": "/var/run/resolv.conf",
    "tmp": "private/tmp",
    "var": "private/var",
}

# netconfigd and its job and configuration (docs/kernel/network.md,
# "Bringing interfaces up"): every en* interface takes a DHCP lease at boot.
# The NTP client's job (docs/base/pf-ntp.md), Disabled; sntp and
# /etc/ntp.conf are in //base:system_root.
_NETWORK_FILES = {
    "//base/netconfigd": "usr/libexec/netconfigd",
    "//base/netconfigd:com.neodarwin.netconfigd.plist": "System/Library/LaunchDaemons/com.neodarwin.netconfigd.plist",
    "//base/netconfigd:netconfigd.conf": "private/etc/netconfigd.conf",
    "//base/sntp_wrapper": "usr/libexec/sntp-wrapper",
    "//base/sntp_wrapper:com.neodarwin.sntp.plist": "System/Library/LaunchDaemons/com.neodarwin.sntp.plist",
}

_NETWORK_MODES = {
    "System/Library/LaunchDaemons/com.neodarwin.netconfigd.plist": "0644",
    "System/Library/LaunchDaemons/com.neodarwin.sntp.plist": "0644",
    "private/etc/netconfigd.conf": "0644",
}

_SYSTEM_MODES = {
    "private/etc/master.passwd": "0600",
    "private/etc/security/audit_control": "0400",
    "private/etc/security/audit_user": "0400",
    "private/etc/security/audit_warn": "0555",
    "private/tmp": "1777",
    "private/var/audit": "0700",
    "private/var/tmp": "1777",
    "usr/bin/chfn": "4555",
    "usr/bin/chpass": "4555",
    "usr/bin/chsh": "4555",
    "usr/bin/lock": "4555",
    "usr/bin/login": "4555",
    "usr/bin/passwd": "4555",
    "usr/bin/su": "4755",
    "usr/bin/top": "4555",
    "usr/sbin/traceroute": "4555",
    "usr/sbin/traceroute6": "4555",
}

# P1-15's code-signing probes (tests/qemu/cs_probe): `listed` is in the
# image's trust cache; `unlisted` and `unlisted.dylib` are left out of it,
# so under enforcement the kernel refuses them.
_CS_PROBES = {
    "//tests/qemu/cs_probe:listed": "usr/local/libexec/cs_probe/listed",
    "//tests/qemu/cs_probe:unlisted": "usr/local/libexec/cs_probe/unlisted",
    "//tests/qemu/cs_probe:unlisted_dylib": "usr/local/libexec/cs_probe/unlisted.dylib",
}

_CS_PROBES_UNLISTED = [
    "usr/local/libexec/cs_probe/unlisted",
    "usr/local/libexec/cs_probe/unlisted.dylib",
]

# launchd-842 as PID 1. It runs /bin/launchctl bootstrap -S System, which
# loads com.apple.getty.plist. Booted by //kernel:sbsa_session_boot_test.
hfs_ramdisk(
    name = "session_root",
    dirs = _SYSTEM_DIRS,
    files = {
        "//base/launchctl": "bin/launchctl",
        "//base/sshd_keygen_wrapper": "usr/libexec/sshd-keygen-wrapper",
    } | _NETWORK_FILES | _CS_PROBES,
    links = _SYSTEM_LINKS,
    modes = _NETWORK_MODES,
    tree_modes = _SYSTEM_MODES,
    trees = [
        "//base:system_root",
        "//base:launchd_daemon",
    ],
    trust_cache_exclude = _CS_PROBES_UNLISTED,
)

# P2-01's run-time trust grant (tests/qemu/pkg_trust): session_root with
# ndpkg (entitled to load trust caches), a probe no static trust cache
# lists, the probe's package, its trust cache and grant, and wrongly signed
# variants: a package and grant chained to other-root, and the grant with
# its signatures zeroed. Booted by //kernel:sbsa_pkg_trust_test and
# //kernel:sbsa_pkg_trust_no_root_test.
_PKG_TRUST = "usr/local/share/pkg_trust/"

_PKG_TRUST_DATA = {
    "//tests/qemu/pkg_trust:probe_pkg": _PKG_TRUST + "pkg-probe.ndpkg",
    "//tests/qemu/pkg_trust:probe_pkg_trustcache": _PKG_TRUST + "pkg-probe.trustcache",
    "//tests/qemu/pkg_trust:probe_pkg_grant": _PKG_TRUST + "pkg-probe.grant",
    "//tests/qemu/pkg_trust:probe_pkg_other_root": _PKG_TRUST + "other-root.ndpkg",
    "//tests/qemu/pkg_trust:probe_pkg_other_root_grant": _PKG_TRUST + "other-root.grant",
    "//tests/qemu/pkg_trust:unsigned_grant": _PKG_TRUST + "unsigned.grant",
}

hfs_ramdisk(
    name = "pkg_trust_root",
    dirs = _SYSTEM_DIRS,
    files = {
        "//base/launchctl": "bin/launchctl",
        "//base/sshd_keygen_wrapper": "usr/libexec/sshd-keygen-wrapper",
        "//tests/qemu/pkg_trust:ndpkg": "usr/local/sbin/ndpkg",
        "//tests/qemu/pkg_trust:pkg_probe": "usr/local/libexec/pkg_probe/pkg-probe",
    } | _NETWORK_FILES | _PKG_TRUST_DATA,
    links = _SYSTEM_LINKS,
    modes = _NETWORK_MODES | {path: "0644" for path in _PKG_TRUST_DATA.values()},
    tree_modes = _SYSTEM_MODES,
    trees = [
        "//base:system_root",
        "//base:launchd_daemon",
    ],
    trust_cache_exclude = ["usr/local/libexec/pkg_probe"],
)

# The same system with a test-only PID 1 that runs getty itself, without
# launchd. Booted by //kernel:sbsa_getty_boot_test.
hfs_ramdisk(
    name = "getty_root",
    dirs = _SYSTEM_DIRS,
    files = {"//tests/qemu/getty_init": "sbin/launchd"},
    links = _SYSTEM_LINKS,
    tree_modes = _SYSTEM_MODES,
    trees = ["//base:system_root"],
)

# PAM (docs/base/session.md, "PAM"): session_root with two test accounts in
# its user and group databases (tests/qemu/pam), test (group admin) and
# guest, and their home directories, which they own, and chpass_editor, an
# EDITOR for chpass. Booted by //kernel:sbsa_pam_session_test and
# //kernel:sbsa_accounts_test, and by the net tests, for which its
# /etc/netconfigd.conf also asks for DHCPv6 (tests/qemu/net).
hfs_ramdisk(
    name = "pam_session_root",
    dirs = _SYSTEM_DIRS + [
        "Users/guest",
        "Users/test",
    ],
    files = {
        "//base/launchctl": "bin/launchctl",
        "//base/sshd_keygen_wrapper": "usr/libexec/sshd-keygen-wrapper",
        "//tests/qemu/pam:chpass_editor": "usr/local/bin/chpass_editor",
        "//tests/qemu/pam:group": "private/etc/group",
        "//tests/qemu/pam:master.passwd": "private/etc/master.passwd",
        "//tests/qemu/pam:passwd": "private/etc/passwd",
    } | {k: v for k, v in _NETWORK_FILES.items() if v != "private/etc/netconfigd.conf"} | {
        # The net tests' (tests/qemu/net): stateless DHCPv6, which slirp's
        # router advertisements don't ask for.
        "//tests/qemu/net:netconfigd_conf": "private/etc/netconfigd.conf",
    },
    links = _SYSTEM_LINKS,
    modes = {
        "private/etc/group": "0644",
        "private/etc/master.passwd": "0600",
        "private/etc/passwd": "0644",
        "usr/local/bin/chpass_editor": "0755",
    } | _NETWORK_MODES,
    owners = {
        "Users/guest": "502:20",
        "Users/test": "501:20",
    },
    tags = ["manual"],
    tree_modes = _SYSTEM_MODES,
    trees = [
        "//base:system_root",
        "//base:launchd_daemon",
    ],
)

# P1-10 (docs/kernel/storage.md): the session system on a disk instead of a
# ramdisk. The same files as session_root in a journaled 192 MiB volume
# (a writable root must be journaled: HFS won't mount a dirty volume
# read-write without a journal), and a GPT disk image around it: partition 1
# an EFI System Partition with neoboot and the kernel collection (no
# ramdisk; the volume's static trust cache), partition 2 this volume.
# neoboot passes partition 2's unique
# GUID as /chosen boot-uuid; the kernel roots on /dev/disk0s2. Booted from
# virtio-blk by //kernel:sbsa_disk_boot_test. Manual: 230 MiB of image,
# built when a disk test runs.
hfs_ramdisk(
    name = "session_root_volume",
    dirs = _SYSTEM_DIRS,
    files = {
        "//base/launchctl": "bin/launchctl",
        "//base/sshd_keygen_wrapper": "usr/libexec/sshd-keygen-wrapper",
    } | _NETWORK_FILES | _CS_PROBES,
    journaled = True,
    links = _SYSTEM_LINKS,
    modes = _NETWORK_MODES,
    volume_size = "192m",
    tags = ["manual"],
    tree_modes = _SYSTEM_MODES,
    trees = [
        "//base:system_root",
        "//base:launchd_daemon",
    ],
    trust_cache_exclude = _CS_PROBES_UNLISTED,
)

# The ESP has the root's static trust cache (P1-15): neoboot passes it to
# the kernel, which then enforces code signing.
gpt_disk_image(
    name = "session_disk",
    esp = {
        "//boot/neoboot": "EFI/BOOT/BOOTAA64.EFI",
        "//kernel:sbsa_kc": "NeoDarwin/kernelcache",
        ":session_root_volume_trustcache": "NeoDarwin/trustcache",
    },
    root = ":session_root_volume",
    tags = ["manual"],
)

# The session volume as a data disk that firmware can't boot: its ESP has
# no \EFI\BOOT\BOOTAA64.EFI (only a README), so EDK2 boots the test's own
# ESP and this disk is just a second disk with a GPT and an HFS+ partition
# (//kernel:sbsa_nvme_readonly_test).
gpt_disk_image(
    name = "data_disk",
    esp = {"README.md": "README.md"},
    root = ":session_root_volume",
    tags = ["manual"],
)

# The same disk with boot.cfg nd_pci_msi=0 on its ESP: the disk runs on INTx
# (//kernel:sbsa_disk_intx_boot_test).
gpt_disk_image(
    name = "session_disk_intx",
    esp = {
        "//boot/neoboot": "EFI/BOOT/BOOTAA64.EFI",
        "//boot/neoboot:testdata/pci-msi-off.cfg": "NeoDarwin/boot.cfg",
        "//kernel:sbsa_kc": "NeoDarwin/kernelcache",
        ":session_root_volume_trustcache": "NeoDarwin/trustcache",
    },
    root = ":session_root_volume",
    tags = ["manual"],
)

# P3-01 (docs/architecture/filesystems.md §7): the session disk with zfs.kext
# in its kernel collection (//kernel:sbsa_zfs_kc) and zpool and zfs at /sbin
# (//kexts/zfs:zfs_commands), for //kernel:sbsa_zfs_pool_test.
hfs_ramdisk(
    name = "zfs_session_root_volume",
    dirs = _SYSTEM_DIRS,
    files = {
        "//base/launchctl": "bin/launchctl",
        "//base/sshd_keygen_wrapper": "usr/libexec/sshd-keygen-wrapper",
    } | _NETWORK_FILES,
    journaled = True,
    links = _SYSTEM_LINKS,
    modes = _NETWORK_MODES,
    volume_size = "192m",
    tags = ["manual"],
    tree_modes = _SYSTEM_MODES,
    trees = [
        "//base:system_root",
        "//base:launchd_daemon",
        "//kexts/zfs:zfs_commands",
    ],
)

gpt_disk_image(
    name = "zfs_session_disk",
    esp = {
        "//boot/neoboot": "EFI/BOOT/BOOTAA64.EFI",
        "//kernel:sbsa_zfs_kc": "NeoDarwin/kernelcache",
        ":zfs_session_root_volume_trustcache": "NeoDarwin/trustcache",
    },
    root = ":zfs_session_root_volume",
    tags = ["manual"],
)

# P3-01 checkpoint 2 (docs/architecture/filesystems.md §7): the ZFS session
# disk plus the OpenZFS test suite: ksh at /bin/ksh (//base:ksh_shell, only
# in this image), the suite's scripts and nd-zfs-tests in /usr/share/zfs
# (//kexts/zfs:zfs_test_suite) and its helpers in
# /usr/share/zfs/zfs-tests/bin (//kexts/zfs:zfs_test_commands), for
# //kernel:sbsa_zfs_suite_test.
hfs_ramdisk(
    name = "zfs_test_root_volume",
    # /etc/zfs: zpool.cache, which the kernel writes and zdb -C reads.
    dirs = _SYSTEM_DIRS + [
        "private/etc/zfs",
        "private/var/tmp/zts",
    ],
    files = {
        "//base/launchctl": "bin/launchctl",
        "//base/sshd_keygen_wrapper": "usr/libexec/sshd-keygen-wrapper",
    } | _NETWORK_FILES,
    journaled = True,
    links = _SYSTEM_LINKS,
    modes = _NETWORK_MODES,
    volume_size = "256m",
    tags = ["manual"],
    tree_modes = _SYSTEM_MODES,
    trees = [
        "//base:system_root",
        "//base:launchd_daemon",
        "//base:ksh_shell",
        "//kexts/zfs:zfs_commands",
        "//kexts/zfs:zfs_test_commands",
        "//kexts/zfs:zfs_test_suite",
    ],
)

gpt_disk_image(
    name = "zfs_test_disk",
    esp = {
        "//boot/neoboot": "EFI/BOOT/BOOTAA64.EFI",
        "//kernel:sbsa_zfs_kc": "NeoDarwin/kernelcache",
        ":zfs_test_root_volume_trustcache": "NeoDarwin/trustcache",
    },
    root = ":zfs_test_root_volume",
    tags = ["manual"],
)

# P4-21 checkpoint 7 (docs/architecture/freebsd-parity.md §2.1): the session
# disk plus FreeBSD's /usr/tests for the pilot's programs
# (//base:freebsd_tests; kyua, atf-sh and atf-check are in the base), for
# //kernel:sbsa_freebsd_tests_test.
hfs_ramdisk(
    name = "freebsd_test_root_volume",
    dirs = _SYSTEM_DIRS,
    files = {
        "//base/launchctl": "bin/launchctl",
        "//base/sshd_keygen_wrapper": "usr/libexec/sshd-keygen-wrapper",
    } | _NETWORK_FILES,
    journaled = True,
    links = _SYSTEM_LINKS,
    modes = _NETWORK_MODES,
    volume_size = "256m",
    tags = ["manual"],
    tree_modes = _SYSTEM_MODES,
    trees = [
        "//base:system_root",
        "//base:launchd_daemon",
        "//base:freebsd_tests",
    ],
)

gpt_disk_image(
    name = "freebsd_test_disk",
    esp = {
        "//boot/neoboot": "EFI/BOOT/BOOTAA64.EFI",
        "//kernel:sbsa_kc": "NeoDarwin/kernelcache",
        ":freebsd_test_root_volume_trustcache": "NeoDarwin/trustcache",
    },
    root = ":freebsd_test_root_volume",
    tags = ["manual"],
)
