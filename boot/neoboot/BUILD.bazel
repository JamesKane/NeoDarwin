load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//rules:cc.bzl", "lang_audit_test")
load("//rules:efi.bzl", "swift_embedded_uefi_binary")

package(default_visibility = ["//visibility:public"])

swift_embedded_uefi_binary(
    name = "neoboot",
    srcs = glob(["Sources/*.swift"]),
    c_srcs = ["runtime/mem.c"],
    hdrs = [
        "UEFI/module.modulemap",
        "UEFI/uefi.h",
    ],
    out = "BOOTAA64.EFI",
)

lang_audit_test(
    name = "neoboot_lang_audit",
    srcs = [
        "UEFI/uefi.h",
        "runtime/mem.c",
    ],
)

# P0-09 exit: the Embedded Swift EFI application boots as \EFI\BOOT\BOOTAA64.EFI
# on QEMU virt with EDK2, prints through the firmware console and directly to
# the PL011, and powers the machine off. Needs QEMU with its EDK2 firmware.
sh_test(
    name = "neoboot_qemu_test",
    size = "small",
    srcs = ["//tools/efi:qemu_efi_test.sh"],
    args = [
        "$(rootpath :neoboot)",
        "45",
        "'neoboot: Embedded Swift on UEFI (ConOut)'",
        "'neoboot: Embedded Swift on UEFI (PL011)'",
    ],
    data = [":neoboot"],
    tags = ["qemu"],
)
