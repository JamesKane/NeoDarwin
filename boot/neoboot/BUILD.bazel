# The loader starts, reads QEMU's ACPI tables, finds no
# \NeoDarwin\kernelcache on an ESP that has none, and says so. Fast and
# kernel-free, so it runs in the default suite; the kernel boot itself is
# //kernel:sbsa_boot_test. Needs QEMU with its EDK2 firmware.
sh_test(
    name = "neoboot_qemu_test",
    size = "small",
    srcs = ["//tools/efi:qemu_efi_test.sh"],
    args = [
        "--until-lines",
        "$(rootpath :neoboot)",
        "45",
        "'neoboot 0.1: loading NeoDarwin'",
        "'neoboot: ACPI: 1 CPUs enabled of 1 GICCs; boot CPU MPIDR 0x0'",
        "'neoboot: ACPI: GICv3 GICD 0x8000000, GICR 0x80a0000 (1 frames in a GICR range)'",
        "'neoboot: ACPI: timer PPI 27 level, UART PL011 at 0x9000000, PSCI HVC'",
        # QEMU virt without EL3 has one security state: the timer stays a FIQ.
        "'DS=1 (Group 0 open to Non-secure); timer PPI 27 on Group 0 (FIQ)'",
        # QEMU's own PSCI, behind HVC since there is no EL3 (P1-06).
        "'neoboot: PSCI conduit: HVC, as the FADT says'",
        # No display device, so no GOP: the kernel's console is serial only.
        "'neoboot: GOP: none; the console is serial only'",
        "'neoboot: no \\NeoDarwin\\kernelcache on the boot volume'",
    ],
    data = [":neoboot"],
    tags = ["qemu"],
)

# boot.cfg's timer-group=1 puts the timer on Group 1 (an IRQ) although the
# GIC would allow Group 0: the path TrustZone boards take, on plain QEMU
# (P1-05). //kernel:sbsa_timer_group1_boot_test boots the kernel this way.
sh_test(
    name = "neoboot_timer_group1_qemu_test",
    size = "small",
    srcs = ["//tools/efi:qemu_efi_test.sh"],
    args = [
        "--esp NeoDarwin/boot.cfg=$(rootpath testdata/timer-group1.cfg)",
        "--until-lines",
        "$(rootpath :neoboot)",
        "45",
        "'timer PPI 27 on Group 1 (IRQ), forced by timer-group=1'",
        "'neoboot: no \\NeoDarwin\\kernelcache on the boot volume'",
    ],
    data = [
        ":neoboot",
        "testdata/timer-group1.cfg",
    ],
    tags = ["qemu"],
)

# QEMU's ramfb is a linear framebuffer EDK2 drives through GOP (QemuRamfbDxe):
# neoboot reports its mode for boot_args.Video (arm64-sbsa-bringup.md §2.1.7).
# The other tests have no display device, and so no GOP.
sh_test(
    name = "neoboot_gop_qemu_test",
    size = "small",
    srcs = ["//tools/efi:qemu_efi_test.sh"],
    args = [
        "--device ramfb",
        "--screendump screen.ppm",
        "--until-lines",
        "$(rootpath :neoboot)",
        "45",
        # EDK2's QemuRamfbDxe offers three modes and starts in 800x600.
        "'neoboot: GOP: 800x600 BGRx, mode 1 of 3, 3200 bytes per row, framebuffer 0x'",
        "'neoboot: no \\NeoDarwin\\kernelcache on the boot volume'",
    ],
    data = [":neoboot"],
    tags = ["qemu"],
)

# boot.cfg's uart=off: neoboot treats the SPCR UART as absent, as on a
# board whose UART the kernel has no driver for (the Q8B's GENI UART,
# SPCR type 0x13). With ramfb's GOP the kernel's console is the framebuffer
# alone (DT-ABI v1.1); //kernel:sbsa_fb_only_boot_test boots it this way.
sh_test(
    name = "neoboot_uart_off_qemu_test",
    size = "small",
    srcs = ["//tools/efi:qemu_efi_test.sh"],
    args = [
        "--device ramfb",
        "--esp NeoDarwin/boot.cfg=$(rootpath testdata/uart-off.cfg)",
        "--until-lines",
        "$(rootpath :neoboot)",
        "45",
        "'neoboot: GOP: 800x600 BGRx'",
        "'neoboot: SPCR UART not used (uart=off); console on the framebuffer only'",
        "'neoboot: no \\NeoDarwin\\kernelcache on the boot volume'",
    ],
    data = [
        ":neoboot",
        "testdata/uart-off.cfg",
    ],
    tags = ["qemu"],
)

# Negative: uart=off without a display device, so without a GOP. The kernel
# would have no console, and neoboot refuses to boot.
sh_test(
    name = "neoboot_uart_off_no_gop_qemu_test",
    size = "small",
    srcs = ["//tools/efi:qemu_efi_test.sh"],
    args = [
        "--esp NeoDarwin/boot.cfg=$(rootpath testdata/uart-off.cfg)",
        "--until-lines",
        "$(rootpath :neoboot)",
        "45",
        "'neoboot: GOP: none; the console is serial only'",
        "'neoboot: uart=off in boot.cfg, and there is no GOP framebuffer: the kernel would have no console'",
        "'neoboot: cannot boot without a console'",
    ],
    data = [
        ":neoboot",
        "testdata/uart-off.cfg",
    ],
    tags = ["qemu"],
)

# QEMU virt with a Secure world: TF-A at EL3 (BL1, BL2, BL31) hands over to
# EDK2 at Non-secure EL1, and the GIC has two security states, as on SBSA
# boards (docs/kernel/qemu-secure.md). neoboot reads GICD_CTLR.DS as 0 and
# puts the timer on Group 1. QEMU's FADT reports no PSCI when firmware owns
# EL3, although TF-A implements it; neoboot then chooses SMC because the CPU
# implements EL3.
sh_test(
    name = "neoboot_secure_qemu_test",
    size = "small",
    srcs = ["//tools/efi:qemu_efi_test.sh"],
    args = [
        "--machine virt-secure",
        "--firmware $(rootpath //third_party/qemu_firmware:virt_secure_flash)",
        "--until-lines",
        "$(rootpath :neoboot)",
        "60",
        "'NOTICE:  BL31: v2.15.0(release)'",
        "'neoboot 0.1: loading NeoDarwin'",
        "'neoboot: ACPI: 1 CPUs enabled of 1 GICCs; boot CPU MPIDR 0x0'",
        "'neoboot: ACPI: GICv3 GICD 0x8000000, GICR 0x80a0000 (1 frames in a GICR range)'",
        "'neoboot: ACPI: timer PPI 27 level, UART PL011 at 0x9000000, PSCI absent'",
        "'DS=0 (two security states; Group 0 is Secure); timer PPI 27 on Group 1 (IRQ)'",
        # The FADT says no PSCI, but the CPU has EL3: SMC to TF-A (P1-06).
        "'neoboot: PSCI conduit: SMC: the FADT reports none, but the CPU implements EL3'",
        "'neoboot: no \\NeoDarwin\\kernelcache on the boot volume'",
    ],
    data = [
        ":neoboot",
        "//third_party/qemu_firmware:virt_secure_flash",
    ],
    tags = ["qemu"],
)

# QEMU sbsa-ref (docs/kernel/qemu-sbsa-ref.md): TF-A PLAT=qemu_sbsa and EDK2
# SbsaQemu, which runs at EL2, with the machine's four neoverse-n2 CPUs.
# SbsaQemu's own ACPI tables: the GIC at 0x40060000 with a redistributor
# frame per CPU in its 64 MiB range, the PL011 at 0x60000000, PSCI over SMC
# as the FADT says, DS=0 under TF-A; the DRAM window at 1 TiB. The tree is
# checked by //tools/dtdump:qemu_sbsa_ref_smp4_test.
sh_test(
    name = "neoboot_sbsa_ref_qemu_test",
    size = "small",
    srcs = ["//tools/efi:qemu_efi_test.sh"],
    args = [
        "--machine sbsa-ref",
        "--firmware $(rootpath //third_party/qemu_firmware:sbsa_ref_flash0.fd)",
        "--firmware-ns $(rootpath //third_party/qemu_firmware:sbsa_ref_flash1.fd)",
        "--smp 4",
        "--until-lines",
        "$(rootpath :neoboot)",
        "90",
        "'NOTICE:  BL31: v2.15.0(release)'",
        "'neoboot 0.1: loading NeoDarwin'",
        "'neoboot: ACPI: 4 CPUs enabled of 4 GICCs; boot CPU MPIDR 0x0'",
        "'neoboot: ACPI: GICv3 GICD 0x40060000, GICR 0x40080000 (4 frames in a GICR range)'",
        "'neoboot: ACPI: timer PPI 27 level, UART PL011 at 0x60000000, PSCI SMC'",
        "'DS=0 (two security states; Group 0 is Secure)'",
        "'neoboot: PSCI conduit: SMC, as the FADT says'",
        "'neoboot: no \\NeoDarwin\\kernelcache on the boot volume'",
    ],
    data = [
        ":neoboot",
        "//third_party/qemu_firmware:sbsa_ref_flash0.fd",
        "//third_party/qemu_firmware:sbsa_ref_flash1.fd",
    ],
    tags = ["qemu"],
)

# Four CPUs: one GICC and one redistributor frame each (the tree itself is
# checked by //tools/dtdump:qemu_virt_smp4_test).
sh_test(
    name = "neoboot_smp4_qemu_test",
