load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//rules:cc.bzl", "lang_audit_test")
load("//rules:efi.bzl", "swift_embedded_uefi_binary")

package(default_visibility = ["//visibility:public"])

swift_embedded_uefi_binary(
    name = "neoboot",
    srcs = glob(["Sources/*.swift"]),
    c_srcs = [
        "runtime/arm64.c",
        "runtime/mem.c",
    ],
    hdrs = [
        "UEFI/module.modulemap",
        "UEFI/uefi.h",
    ],
    out = "BOOTAA64.EFI",
)

lang_audit_test(
    name = "neoboot_lang_audit",
    srcs = [
        "UEFI/uefi.h",
        "runtime/arm64.c",
        "runtime/mem.c",
    ],
)

# The loader starts, finds no \NeoDarwin\kernelcache on an ESP that has none,
# and says so. Fast and kernel-free, so it runs in the default suite; the
# kernel boot itself is //kernel:sbsa_boot_test. Needs QEMU with its EDK2
# firmware.
sh_test(
    name = "neoboot_qemu_test",
    size = "small",
    srcs = ["//tools/efi:qemu_efi_test.sh"],
    args = [
        "--until-lines",
        "$(rootpath :neoboot)",
        "45",
        "'neoboot 0.1: loading NeoDarwin'",
        "'neoboot: no \\NeoDarwin\\kernelcache on the boot volume'",
    ],
    data = [":neoboot"],
    tags = ["qemu"],
)
