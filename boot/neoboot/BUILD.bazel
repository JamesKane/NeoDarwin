        "'neoboot: ACPI: 4 CPUs enabled of 4 GICCs; boot CPU MPIDR 0x0'",
        "'neoboot: ACPI: GICv3 GICD 0x8000000, GICR 0x80a0000 (4 frames in a GICR range)'",
        "'neoboot: PSCI conduit: HVC, as the FADT says'",
        "'neoboot: no \\NeoDarwin\\kernelcache on the boot volume'",
    ],
    data = [":neoboot"],
    tags = ["qemu"],
)

# boot.cfg's dump-acpi lists every table in acpidump's format, which is
# how testdata/*.acpidump were captured (see //tools/dtdump).
sh_test(
    name = "neoboot_dump_acpi_qemu_test",
    size = "small",
    srcs = ["//tools/efi:qemu_efi_test.sh"],
    args = [
        "--esp NeoDarwin/boot.cfg=$(rootpath testdata/dump-acpi.cfg)",
        "--until-lines",
        "$(rootpath :neoboot)",
        "60",
        "'neoboot: dump-acpi: begin'",
        "'RSDP @ 0x'",
        "'    0000: 52 53 44 20 50 54 52 20'",
        "'APIC @ 0x'",
        "'SPCR @ 0x'",
        "'neoboot: dump-acpi: end'",
        "'neoboot: no \\NeoDarwin\\kernelcache on the boot volume'",
    ],
    data = [
        ":neoboot",
        "testdata/dump-acpi.cfg",
    ],
    tags = ["qemu"],
)

# The target-independent half of neoboot: ACPI parsing, device-tree
# synthesis, writing and the DT-ABI check. dtdump compiles the same files
# for the host (//tools/dtdump), so both build the same tree from the same
# tables.
# P1-15: \NeoDarwin\trustcache. A module //tools/trustcache wrote (one
# entry) is checked and reported before the kernelcache is looked for; a
# module the kernel would refuse (version 2) stops the boot, since the
# kernel panics on a static trust cache it can't load.
sh_test(
    name = "neoboot_trust_cache_qemu_test",
    size = "small",
    srcs = ["//tools/efi:qemu_efi_test.sh"],
    args = [
        "--esp NeoDarwin/trustcache=$(rootpath //kernel/neodarwin/amfi:tc_fixture.module)",
        "--until-lines",
        "$(rootpath :neoboot)",
        "45",
        "'neoboot: trust cache: 1 entries, UUID '",
        "'neoboot: no \\NeoDarwin\\kernelcache on the boot volume'",
    ],
    data = [
        ":neoboot",
        "//kernel/neodarwin/amfi:tc_fixture.module",
    ],
    tags = ["qemu"],
)

genrule(
    name = "bad_trust_cache",
    testonly = True,
    outs = ["testdata/bad-trustcache.bin"],
    # A version 2 header with no entries: 24 bytes.
    cmd = "printf '\\002\\000\\000\\000' > $@ && head -c 20 /dev/zero >> $@",
)

sh_test(
    name = "neoboot_bad_trust_cache_qemu_test",
    size = "small",
    srcs = ["//tools/efi:qemu_efi_test.sh"],
    args = [
        "--esp NeoDarwin/trustcache=$(rootpath :bad_trust_cache)",
        "--until-lines",
        "$(rootpath :neoboot)",
        "45",
        "'neoboot: \\NeoDarwin\\trustcache: not version 1'",
        "'neoboot: the trust cache is not one the kernel can load; not booting without it'",
    ],
    data = [
        ":bad_trust_cache",
        ":neoboot",
    ],
    tags = ["qemu"],
)

filegroup(
    name = "portable_srcs",
    srcs = glob(["Sources/Portable/*.swift"]),
)

exports_files(glob(["testdata/*"]))
