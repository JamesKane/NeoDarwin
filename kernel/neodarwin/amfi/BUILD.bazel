# ndamfi: NeoDarwin's provider for XNU's AMFI and Image4 interfaces
# (docs/kernel/amfi-provider.md). nd_amfi.c registers them in the kernel;
# the trust-cache engine also builds on the host for its tests.
load("//rules:cc.bzl", "lang_audit_test", "nd_cc_library", "nd_cc_test")

package(default_visibility = ["//visibility:public"])

nd_cc_library(
    name = "img4_test_stub",
    hdrs = ["test/include/img4/firmware.h"],
    includes = ["test/include"],
    testonly = True,
)

# The trust-cache engine alone: it needs no kernel headers.
nd_cc_library(
    name = "trustcache_host",
    testonly = True,
    srcs = [
        "nd_tc_lookup.c",
        "nd_trustcache.c",
    ],
    hdrs = ["nd_trustcache.h"],
    deps = [
        ":img4_test_stub",
        "//kernel:trustcache_shim",
        "@apple_xnu_corecrypto//:kern_trustcache_headers",
    ],
)

# ndsign's documents and Ed25519 (P2-01, docs/architecture/packaging.md §4):
# the code ndamfi's grant verifier runs, built for the host, where
# //tools/ndsign signs with it and the tests check it. OpenSSH's Ed25519
# compiles unmodified through nd_ed25519.c, without NeoDarwin's warnings.
nd_cc_library(
    name = "ed25519_host",
    srcs = ["nd_ed25519.c"],
    hdrs = ["nd_ndsign.h"],
    copts = ["-w"],
    deps = ["@apple_openssh//:ed25519_src"],
)

nd_cc_library(
    name = "ndsign_host",
    srcs = ["nd_ndsign.c"],
    hdrs = ["nd_ndsign.h"],
    deps = [":ed25519_host"],
)

# RFC 8032's vectors, and a grant //tools/ndsign wrote (the test chain,
# tools/ndsign/testdata/test_keys: TEST-ONLY) checked as the kernel does.
filegroup(
    name = "pciconf_pkg_trustcache",
    testonly = True,
    srcs = ["//tools/ndsign:pciconf_pkg"],
    output_group = "trustcache",
)

filegroup(
    name = "pciconf_pkg_grant",
    testonly = True,
    srcs = ["//tools/ndsign:pciconf_pkg"],
    output_group = "grant",
)

nd_cc_test(
    name = "ndsign_test",
    size = "small",
    srcs = ["test/ndsign_test.c"],
    args = [
        "$(rootpath :pciconf_pkg_trustcache)",
        "$(rootpath :pciconf_pkg_grant)",
        "$(rootpath //tools/ndsign:testdata/test_keys/root.pub)",
        "$(rootpath //tools/ndsign:testdata/test_keys/other-root.pub)",
    ],
    data = [
        ":pciconf_pkg_grant",
        ":pciconf_pkg_trustcache",
        "//tools/ndsign:testdata/test_keys/other-root.pub",
        "//tools/ndsign:testdata/test_keys/root.pub",
    ],
    deps = [":ndsign_host"],
)

# A module //tools/trustcache writes, listing the tool itself (an ad hoc,
# linker-signed arm64 binary), and the tool's cdhash for it: trustcache_test
# round-trips it through the engine.
genrule(
    name = "tc_fixture",
    testonly = True,
    outs = [
        "tc_fixture.module",
        "tc_fixture.cdhash",
    ],
    cmd = "mkdir -p $(@D)/tc_fixture_root && cp $(execpath //tools/trustcache) $(@D)/tc_fixture_root/tool && " +
          "$(execpath //tools/trustcache) create $(execpath tc_fixture.module) $(@D)/tc_fixture_root > /dev/null && " +
          "$(execpath //tools/trustcache) cdhash $(@D)/tc_fixture_root/tool > $(execpath tc_fixture.cdhash)",
    tools = ["//tools/trustcache"],
)

nd_cc_test(
    name = "trustcache_test",
    size = "small",
    srcs = ["test/tc_test.c"],
    args = [
        "$(rootpath tc_fixture.module)",
        "$(rootpath tc_fixture.cdhash)",
    ],
    data = [
        "tc_fixture.cdhash",
        "tc_fixture.module",
    ],
    deps = [":trustcache_host"],
)

# The DER entitlements reader alone, for its host test.
nd_cc_library(
    name = "entitlements_host",
    testonly = True,
    srcs = ["nd_entitlements.c"],
    hdrs = ["nd_entitlements.h"],
)

nd_cc_test(
    name = "entitlements_test",
    size = "small",
    srcs = ["test/ent_test.c"],
    deps = [":entitlements_host"],
)

# Overlaid at bsd/ndamfi by the kernel build (kernel/BUILD.bazel, patch 0005).
filegroup(
    name = "kernel_srcs",
    srcs = [
        "nd_amfi.c",
        "nd_amfi_internal.h",
        "nd_amfi_policy.c",
        "nd_entitlements.c",
        "nd_entitlements.h",
        "nd_entitlements_os.cpp",
        "nd_tc_lookup.c",
        "nd_trustcache.c",
        "nd_trustcache.h",
    ],
)

# The kernel-only sources' language justifications (the host libraries
# audit the rest).
lang_audit_test(
    name = "kernel_srcs_lang_audit",
    srcs = [
        "nd_amfi.c",
        "nd_amfi_internal.h",
        "nd_amfi_policy.c",
        "nd_entitlements_os.cpp",
    ],
)
