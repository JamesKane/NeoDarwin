+# Apple-SoC-only interfaces whose implementations are not published and have
+# no meaning on generic hardware: Apple IOMMUs (DART, SART, UAT, NVMe PPL),
+# the Unified Address Translator, and PPL code-signing monitor queries.
+# One exported (mangled) name per line, exactly as in config/*.exports.
+_pmap_iommu_init
+_pmap_iommu_iovmalloc
+_pmap_iommu_map
+_pmap_iommu_unmap
+_pmap_iommu_iovmfree
+_pmap_iommu_ioctl
+_pmap_iommu_alloc_contiguous_pages
+_nvme_ppl_get_desc
+_sart_get_desc
