--- a/iokit/conf/Makefile.template
+++ b/iokit/conf/Makefile.template
@@ -57,6 +57,20 @@
 %SFILES
 
 %MACHDEP
+
+# NeoDarwin's ACPI platform (patch 0018). ACPICA's objects read acnd.h, its
+# host configuration, before anything else: it stands in for the platform
+# header ACPICA would choose for __APPLE__ and, with ND_ACPICA_CORE, gives
+# ACPICA's own C library (utclib.c, utprint.c) names of its own. -w:
+# upstream warnings are not NeoDarwin's to fix here (BUILD_WERROR is off for
+# xnu anyway). NeoDarwin's three files see ACPICA's public headers and the
+# IOKit/acpi headers.
+ND_ACPI = $(SRCROOT)/iokit/ndacpi
+ND_ACPICA = $(ND_ACPI)/acpica/source
+ND_ACPICA_OBJS = $(patsubst %.c,%.o,$(notdir $(wildcard $(ND_ACPICA)/components/*/*.c)))
+$(foreach o,$(ND_ACPICA_OBJS),$(eval $(o)_CFLAGS_ADD += -DND_ACPICA_CORE -include $(ND_ACPI)/acnd.h -I$(ND_ACPICA)/include -w))
+$(foreach o,nd_acpi_osl.o NeoDarwinACPIPlatform.cpo IOACPIPlatformDevice.cpo,$(eval $(o)_CFLAGS_ADD += \
+	-I$(ND_ACPI) -I$(ND_ACPI)/include -I$(ND_ACPICA)/include))
 
 #
 # Diagnostic opt-outs.  We need to make this list empty.
