From: NeoDarwin
Subject: [PATCH] IOPCIFamily: build fixes, and 64-bit BARs above 4 GiB on arm64

Two upstream errors stop IOPCIFamily-726.0.5 compiling with xnu's C++
flags: isDescendant() returns NULL from a bool function, and
IOPCIHostBridgeData::restartPowerAssertionTimer() returns a value from a
void one.

IOPCIConfigurator::addHostBridge() clears kIOPCIConfiguratorPFM64 on
every architecture but Intel, where it clears it only for some chipsets
and virtual machines. Without it every BAR must lie below 4 GiB: 64-bit
BARs that firmware placed above 4 GiB are moved below it, and a host
bridge whose windows are all above 4 GiB can place none. The Radxa Dragon
Q8B's seven host bridges decode memory only above 4 GiB (0x7_1000_0000 and
up on segment 0); QEMU virt has a 512 GiB window at 0x80_0000_0000 where
EDK2 puts 64-bit BARs. On arm64 the flag now stays set when the host
bridge reports memory above 4 GiB.

Applies to the overlaid IOPCIFamily at iokit/ndpci/IOPCIFamily (patch 0022).

Rebase-risk: low (two one-line fixes and one moved #endif).
---
--- a/iokit/ndpci/IOPCIFamily/IOPCIBridge.cpp
+++ b/iokit/ndpci/IOPCIFamily/IOPCIBridge.cpp
@@ -532,7 +532,7 @@
 
 	if (entry == NULL)
 	{
-		return NULL;
+		return false;
 	}
 
 	entry = entry->getParentEntry(gIOServicePlane);
@@ -574,8 +574,6 @@
 
 		return kIOReturnSuccess;
 	});
-
-    return true;
 }
 
 void IOPCIHostBridgeData::disablePowerAssertion(void)
--- a/iokit/ndpci/IOPCIFamily/IOPCIConfigurator.cpp
+++ b/iokit/ndpci/IOPCIFamily/IOPCIConfigurator.cpp
@@ -634,8 +634,8 @@
       || (0x27AC8086 == fRootVendorProduct)
       || (0x25C08086 == fRootVendorProduct)
       || (CPUID_FEATURE_VMM & cpuid_features()))
-#endif
         fFlags &= ~kIOPCIConfiguratorPFM64;
+#endif
     DLOG("root id 0x%x, flags 0x%x\n", fRootVendorProduct, (int) fFlags);
 
     range = IOPCIRangeAlloc();
@@ -676,6 +676,14 @@
             }
         }
     }
+
+#if !defined(__i386__) && !defined(__x86_64__)
+	// NeoDarwin: 64-bit BARs may be placed, or left where the firmware
+	// put them, above 4 GiB when the host bridge decodes memory there.
+	if (!hasHost64)
+		fFlags &= ~kIOPCIConfiguratorPFM64;
+	DLOG("host bridge 64-bit memory %s, flags 0x%x\n", hasHost64 ? "yes" : "no", (int) fFlags);
+#endif
 
 #if ACPI_SUPPORT
 	if (bridge->acpiDevice)
