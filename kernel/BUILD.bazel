        "--esp NeoDarwin/ramdisk=$(rootpath //images:pid1_root)",
        "--esp NeoDarwin/trustcache=$(rootpath //images:pid1_root_trustcache)",
        "--esp NeoDarwin/boot.cfg=$(rootpath //boot/neoboot:testdata/pci-its-nc-flat.cfg)",
    ] + PCI_DEVICES + [
        "--until-lines",
        "$(rootpath //boot/neoboot)",
        "150",
        "'pid1: all checks passed'",
        "'NeoDarwinPCIHostBridge: \\_SB.PCI0: _OSC control 0x1d of 0x3d with MSI; DMA coherent (_CCA, 64 address bits); requester IDs to SMMUv3'",
        "'NeoDarwinGICv3: LPIs: 8192 LPIs, configuration table at 0x'",
        "' non-shareable, non-cacheable (cleaned to PoC); enabled on 1 of 1 redistributors'",
        "'NeoDarwinGICv3ITS: ITS 0: GITS_BASER0: device table, 8-byte entries, 8 x 64 KiB pages at 0x'",
        "'flat device table; 1 collection by processor number; non-cacheable command queue'",
        "'DeviceID 0x20 on ITS 0 via SMMUv3 at 0x9050000 as stream 0x20 (bypass)'",
        "'DeviceID 0x18 on ITS 0 via SMMUv3 at 0x9050000 as stream 0x18 (bypass)'",
    ] + PCI_LINES + MSI_LINES,
    data = [
        ":sbsa_kc",
        "//boot/neoboot",
        "//boot/neoboot:testdata/pci-its-nc-flat.cfg",
        "//images:pid1_root",
        "//images:pid1_root_trustcache",
    ],
    tags = ["manual", "kernel", "qemu"],
)

