# ---------------------------------------------------------------------------
# P1-19 checkpoints 1 and 2: bring-up Ethernet, DHCP and name resolution
# (docs/kernel/network.md). IONetworkingFamily and NeoDarwinVirtioNet on
# QEMU's user-mode network (slirp: DHCP gives the guest 10.0.2.15/24, the
# gateway 10.0.2.2 and the DNS proxy 10.0.2.3), configured at boot by
# netconfigd and dhclient; names resolve through Libinfo, mDNSResponder and
# /etc/hosts. The harness's --user-net puts the
# NIC on it, --hostfwd forwards a free port on the host's 127.0.0.1 to the
# guest's sshd, and --host-cmd-after runs the host's ssh against it with a
# key it made for the run (--host-setup), which root installs for the
# guest's test user ({hostfile:...}).

NET_MAC = "52:54:00:12:34:56"

# A name resolved through slirp's DNS proxy, which forwards to the host's
# resolver: the guest's lookup is checked only when the host can resolve it.
# The guest tries three times, 10 s each: under a loaded parallel run the
# forwarded query can take longer than one short attempt allows.
NET_DNS_NAME = "example.com"

# The host's ssh: this run's key only, no user configuration, agent or
# known hosts; BatchMode, so it never asks for anything.
NET_SSH = ("ssh -F /dev/null -i id_ed25519 -o IdentitiesOnly=yes -o IdentityAgent=none -o BatchMode=yes " +
           "-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR -o ConnectTimeout=60 " +
           "-p $$ND_HOSTFWD_PORT test@127.0.0.1")

# A lookup through slirp's IPv6 DNS proxy alone ("IPv6 DNS: RDNSS and
# DHCPv6"): with the DHCP lease's servers withdrawn (resolvconf -d en0),
# resolv.conf names only fec0::3, and mDNSResponder asks it over IPv6. slirp
# forwards fec0::3 only to an IPv6 name server of the host's, and puts RDNSS
# in its advertisements only then: the guest looks the name up only when an
# RDNSS record (en0:slaac) came, and the host checks the answer
# only when it has an IPv6 name server and can resolve the name itself.
NET_DNS6 = [
    "--send-after 'root@localhost ~ # ' 'case $$(resolvconf -l) in *en0:slaac*) resolvconf -l en0 > /tmp/en0.rc; resolvconf -d en0; cat /etc/resolv.conf; " +
    "for i in 1 2 3; do ping -c 1 -t 10 " + NET_DNS_NAME + " > /tmp/dns6.txt 2>&1; case $$(cat /tmp/dns6.txt) in PING*) break;; esac; sleep 2; done; " +
    "resolvconf -a en0 < /tmp/en0.rc;; *) echo \"no RDNSS on en0\" > /tmp/dns6.txt;; esac; cat /tmp/dns6.txt\\n'",
]

NET_DNS6_HOST = (
    "--host-cmd-after 'host: exit' 'if ! scutil --dns 2>/dev/null | grep nameserver | grep -q \" : .*:\"; then " +
    "echo \"dns6: skipped: the host has no IPv6 name server, so slirp sends no RDNSS and fec0::3 forwards nowhere\"; " +
    "elif ! host -W 5 " + NET_DNS_NAME + " > /dev/null 2>&1; then echo \"dns6: skipped: the host resolves no names (no network?)\"; " +
    "elif " + NET_SSH + " cat /tmp/dns6.txt | grep -q \"^PING " + NET_DNS_NAME + " (\"; then echo \"dns6: " + NET_DNS_NAME + " resolved through fec0::3\"; " +
    "else echo \"dns6: FAILED: the host has an IPv6 name server and resolves " + NET_DNS_NAME + ", the guest did not through fec0::3\"; fi'"
)

# P4-24 (docs/kernel/network.md, "P4-24: the rest of network_cmds and
# IPv6"): the rest of network_cmds and IPv6 autoconfiguration. netconfigd
# starts SLAAC on en0 and runs rtsold; slirp's router (fe80::2, the gateway
# fec0::2) advertises fec0::/64. The image's netconfigd.conf asks for
# stateless DHCPv6 (tests/qemu/net: slirp's advertisements set neither M
# nor O), which slirp answers with its DNS proxy, fec0::3 ("IPv6 DNS: RDNSS
# and DHCPv6"). Wait for dhcp6c's reply and the IPv6 default route, then:
# the gateway in the ARP table, traceroute to it by
# ICMP (slirp answers an echo to 10.0.2.2 whatever its hop limit; UDP
# probes to it would reach the host's loopback), traceroute run by test
# (setuid root: -I needs a raw socket), en0's link-local and EUI-64 SLAAC
# addresses, the router in the neighbour cache, the IPv6 routes, and ping6
# to the gateway.
NET_TOOLS = [
    "--send-after 'root@localhost ~ # ' 'for i in {1..30}; do case $$(cat /var/log/netconfigd.log; netstat -rn -f inet6) in " +
    "*\"dhcp6c-script: en0: INFOREQ\"*default*) break;; esac; sleep 1; done; cat /var/log/netconfigd.log\\n'",
    "--send-after 'root@localhost ~ # ' 'ping -c 1 10.0.2.2 > /dev/null; arp -an; traceroute -n -I -m 3 10.0.2.2\\n'",
    "--send-after 'root@localhost ~ # ' 'su test -c \"traceroute -n -I -m 1 10.0.2.2\" > /tmp/tr.txt 2>&1; " +
    "case $$(cat /tmp/tr.txt) in *\" 1  10.0.2.2 \"*) echo traceroute-as-test-$$((6*7));; *) cat /tmp/tr.txt;; esac\\n'",
    "--send-after 'root@localhost ~ # ' 'ifconfig en0 inet6; ndp -an; netstat -rn -f inet6; ping6 -c 2 fec0::2\\n'",
    "--send-after 'root@localhost ~ # ' 'resolvconf -l; cat /etc/resolv.conf\\n'",
] + NET_DNS6 + [
]

NET_TOOLS_LINES = [
    "'netconfigd: en0: IPv6 autoconfiguration (link-local address started, router advertisements accepted)'",
    "'netconfigd: en0: IPv6 autoconfiguration (rtsold -f -R /sbin/resolvconf -A /usr/libexec/dhcp6c-other en0, pid '",
    "'dhcp6c-other: en0: DHCPv6 (other) for router fe80::2: dhcp6c -f -d -c /var/run/dhcp6c.en0.conf en0'",
    "'client6_recvreply: no server ID option in a reply to Information-Request; taken'",
    "'dhcp6c-script: en0: INFOREQ: name servers fec0::3'",
    "'? (10.0.2.2) at 52:55:a:0:2:2 on en0 ifscope [ethernet]'",
    "'traceroute to 10.0.2.2 (10.0.2.2), 3 hops max, 48 byte packets'",
    "' 1  10.0.2.2  '",
    "'traceroute-as-test-42'",
    "'inet6 fe80::5054:ff:fe12:3456%en0 prefixlen 64 scopeid 0x'",
    "'inet6 fec0::5054:ff:fe12:3456 prefixlen 64 autoconf'",
    "'fe80::2%en0                             52:56:0:0:0:2        en0 '",
    "'default                                 fe80::2%en0                             UGcIg                 en0'",
    "'fec0::/64                               link#'",
    "'16 bytes from fec0::2, icmp_seq=1 hlim=255 '",
    "'--- fec0::2 ping6 statistics ---'",
    "'# resolv.conf from en0:dhcp6'",
    "'# Generated by resolvconf'",
    "'nameserver fec0::3'",
]

# Log in as root and wait for en0's DHCP lease: netconfigd runs dhclient
# at boot, which configures en0 and the default route and writes
# /var/run/resolv.conf (/etc/resolv.conf's target), and mDNSResponder
# rereads it. Look at the interface, the routes and resolv.conf, ping the
# gateway, and resolve names through Libinfo: localhost from /etc/hosts,
# and nd-test.local, an address record dns-sd registers with mDNSResponder
# (multicast DNS, answered inside the guest). A name through slirp's DNS
# proxy (10.0.2.3, which asks the host's resolver) is looked up too, and
# checked only if the host itself can resolve it (below). Then turn on
# Remote Login and install the run's key for test; the host runs uname over
# ssh, copies a 1.5 MB file back through it, and checks the guest's lookup.
NET_SESSION = [
    "--hostfwd 22",
    "--host-setup 'ssh-keygen -q -t ed25519 -N \"\" -C nd-net-test -f id_ed25519'",
    "--send-after 'login: ' 'root\\n'",
    "--send-after 'root@localhost ~ # ' 'until [ -s /var/run/resolv.conf ]; do sleep 1; done; cat /var/log/netconfigd.log; echo lease-$$((6*7))\\n'",
    "--send-after 'lease-42' 'ifconfig en0; netstat -rn -f inet; cat /etc/resolv.conf\\n'",
    "--send-after 'root@localhost ~ # ' 'ping -c 2 10.0.2.2\\n'",
    "--send-after 'root@localhost ~ # ' 'ping -c 1 localhost\\n'",
    "--send-after 'root@localhost ~ # ' 'dns-sd -P nd-test _nd-test._tcp local 7 nd-test.local 10.0.2.15 > /dev/null & sleep 3; ping -c 1 -t 5 nd-test.local; kill %1\\n'",
    "--send-after 'root@localhost ~ # ' 'for i in 1 2 3; do ping -c 1 -t 10 " + NET_DNS_NAME + " > /tmp/dns.txt 2>&1; case $$(cat /tmp/dns.txt) in PING*) break;; esac; sleep 2; done; cat /tmp/dns.txt\\n'",
] + NET_TOOLS + [
    "--send-after 'root@localhost ~ # ' 'launchctl load -w /System/Library/LaunchDaemons/ssh.plist\\n'",
    "--send-after 'root@localhost ~ # ' 'mkdir -p /Users/test/.ssh && echo \"{hostfile:id_ed25519.pub}\" > /Users/test/.ssh/authorized_keys && echo key-$$((6*7))\\n'",
    "--host-cmd-after 'key-42' '" + NET_SSH + " uname -a'",
