# the root complex's requester IDs to the SMMU and the SMMU's stream IDs to
# the ITS; the SMMU is left in bypass, as QEMU resets it. boot.cfg also
# forces the paths a GIC that is not coherent would take (nd_gic_lpi_nc=1:
# non-cacheable tables and command queue, every write cleaned to PoC) and a
# flat device table (nd_its_flat=1).
sh_test(
    name = "sbsa_pci_smmu_boot_test",
    size = "medium",
    srcs = ["//tools/efi:qemu_efi_test.sh"],
