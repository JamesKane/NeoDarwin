# Loopback and sshd (docs/base/session.md, "Loopback and sshd") on
# //images:pam_session_root, under code-signing enforcement. launchctl's
# bootstrap gave lo0 127.0.0.1/8 and ::1, which ifconfig shows and ping
# reaches. As root: load ssh.plist with -w (Remote Login is off, as on
# macOS); launchctl creates the job's listening sockets and launchd runs
# launchproxy, then sshd-keygen-wrapper (host keys) and sshd -i for each
# connection. test logs in over ssh to 127.0.0.1 with its password
# (keyboard-interactive through PAM's pam_unix) and runs id; a wrong
# password is refused; root's new ed25519 key in test's authorized_keys
# logs in without one. libcrypto (OpenSSL 3.5) gives its version and known
# answers, and RSA and ECDSA keys log in too. sshd's log has each attempt.
sh_test(
    name = "sbsa_ssh_session_test",
    size = "medium",
    srcs = ["//tools/efi:qemu_efi_test.sh"],
    args = [
        "--cpu neoverse-n2",
        "--mem 2G",
        "--esp NeoDarwin/kernelcache=$(rootpath :sbsa_kc)",
        "--esp NeoDarwin/ramdisk=$(rootpath //images:pam_session_root)",
        "--esp NeoDarwin/trustcache=$(rootpath //images:pam_session_root_trustcache)",
        "--until-lines",
        "--absent 'ndamfi: refused'",
        # launchctl's loopback set-up and socket creation report failures.
        "--absent 'launchctl: lo0'",
        "--absent 'launchctl: com.openssh.sshd'",
        "--send-after 'login: ' 'root\\n'",
        "--send-after 'root@localhost ~ # ' 'ifconfig lo0; ping -c 1 127.0.0.1\\n'",
        "--send-after 'root@localhost ~ # ' 'launchctl load -w /System/Library/LaunchDaemons/ssh.plist; launchctl list\\n'",
        "--send-after 'root@localhost ~ # ' 'ssh -o StrictHostKeyChecking=no test@127.0.0.1 id\\n'",
        "--send-after 'Password:' 'neodarwin\\n'",
        "--send-after 'root@localhost ~ # ' 'ssh -o NumberOfPasswordPrompts=1 -o PreferredAuthentications=keyboard-interactive test@127.0.0.1 id; echo ssh-status=$$?\\n'",
        "--send-after 'Password:' 'wrong\\n'",
        "--send-after 'root@localhost ~ # ' 'ssh-keygen -q -t ed25519 -N \"\" -f /var/root/.ssh/id_ed25519 && mkdir -p /Users/test/.ssh && cp /var/root/.ssh/id_ed25519.pub /Users/test/.ssh/authorized_keys\\n'",
        "--send-after 'root@localhost ~ # ' 'ssh -o BatchMode=yes test@127.0.0.1 echo key-\\$$UID; echo key-status=$$?\\n'",
        # libcrypto (OpenSSL): the versions, known answers (SHA-256, AES-128
        # through the arm64 assembly, MD4 from the legacy provider, which
        # libcrypto dlopens), and RSA and ECDSA keys, which log in too.
        "--send-after 'root@localhost ~ # ' 'openssl version; ssh -V; printf abc | openssl dgst -sha256; printf abc | openssl dgst -provider legacy -md4\\n'",
        "--send-after 'root@localhost ~ # ' 'head -c 64 /dev/zero | openssl enc -aes-128-ecb -K 000102030405060708090a0b0c0d0e0f -nopad | openssl dgst -sha256\\n'",
        "--send-after 'root@localhost ~ # ' 'for t in rsa ecdsa; do ssh-keygen -q -t $$t -N \"\" -f /var/root/.ssh/id_$$t && ssh-keygen -l -f /var/root/.ssh/id_$$t.pub && cat /var/root/.ssh/id_$$t.pub >> /Users/test/.ssh/authorized_keys; done; ssh-keygen -l -f /var/root/.ssh/id_ed25519.pub\\n'",
        "--send-after 'root@localhost ~ # ' 'for t in rsa ecdsa; do ssh -o BatchMode=yes -i /var/root/.ssh/id_$$t test@127.0.0.1 echo $$t-\\$$UID; done\\n'",
        "--send-after 'root@localhost ~ # ' 'cat /var/log/sshd.log\\n'",
        "$(rootpath //boot/neoboot)",
        "240",
        "'ndamfi: code-signing enforcement on (a static trust cache from the loader)'",
        "'inet 127.0.0.1 netmask 0xff000000'",
        "'inet6 ::1 prefixlen 128'",
        "'1 packets transmitted, 1 packets received, 0.0% packet loss'",
        "'com.openssh.sshd'",
        "'Warning: Permanently added '",
        "'uid=501(test) gid=20(staff)'",
        "'test@127.0.0.1: Permission denied'",
        "'ssh-status=255'",
        "'key-501'",
        "'key-status=0'",
        "'OpenSSL 3.5.9 29 Sep 2026 (Library: OpenSSL 3.5.9 29 Sep 2026)'",
        "'OpenSSH_10.0p2, OpenSSL 3.5.9 29 Sep 2026'",
        "'SHA2-256(stdin)= ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad'",
        "'MD4(stdin)= a448017aaf21d8525fc10ae87aa6729d'",
        "'SHA2-256(stdin)= 8e1802533cd0c0f00ce645b44502c8bb664e7ed823fdd5271a1bfa26f57f12f2'",
        "'root@localhost (RSA)'",
        "'root@localhost (ECDSA)'",
        "'root@localhost (ED25519)'",
        "'rsa-501'",
        "'ecdsa-501'",
        "'Accepted keyboard-interactive/pam for test from 127.0.0.1'",
        "'PAM: authentication error for test from 127.0.0.1'",
        "'Accepted publickey for test from 127.0.0.1'",
    ],
    data = [
        ":sbsa_kc",
        "//boot/neoboot",
        "//images:pam_session_root",
        "//images:pam_session_root_trustcache",
    ],
    tags = ["manual", "kernel", "qemu"],
)

# P1-15's exit (docs/kernel/amfi-provider.md §4): the session disk under
# code-signing enforcement. neoboot passes the root's static trust cache
# (\\NeoDarwin\\trustcache on the image's ESP); the kernel loads it and
# enforces. The listed probe runs as a platform binary with the entitlements
# its signature carries, which the kernel honours (as uid -2 it may force
# case-sensitive lookups), and dlopens a listed library; the library and the
# binary the trust cache leaves out are refused.
CS_PROBE = "/usr/local/libexec/cs_probe"

sh_test(
    name = "sbsa_cs_enforcement_test",
    size = "medium",
    srcs = ["//tools/efi:qemu_efi_test.sh"],
    args = [
        "--cpu neoverse-n2",
        "--mem 2G",
        "--disk $(rootpath //images:session_disk)",
        "--until-lines",
        "--absent 'cs_probe: not a platform binary'",
        "--send-after 'login: ' 'root\\n'",
        "--send-after 'root@localhost ~ # ' '" + CS_PROBE + "/listed --dlopen /usr/lib/libutil.dylib\\n'",
        "--send-after 'root@localhost ~ # ' '" + CS_PROBE + "/listed --dlopen " + CS_PROBE + "/unlisted.dylib\\n'",
        "--send-after 'root@localhost ~ # ' '" + CS_PROBE + "/unlisted; echo unlisted-status=$$?\\n'",
        "--send-after 'root@localhost ~ # ' 'sysctl security.codesigning.neodarwin security.codesigning.trustcaches.num_static\\n'",
        "-",
        "240",
        "'neoboot: trust cache: '",
        "'ndamfi: code-signing enforcement on (a static trust cache from the loader)'",
        "'ndamfi: static trust cache '",
        "'loaded external trust cache module: 0'",
        "'BSD root: disk0s2, major'",
        "'cs_probe: platform binary, valid, CS_KILL'",
        "'cs_probe: entitlements granted: '",
        "'com.apple.private.iopol.case_sensitivity among them'",
        "'cs_probe: dlopen /usr/lib/libutil.dylib: loaded'",
        "'cs_probe: case-sensitivity policy as uid -2: granted by the kernel'",
        "'ndamfi: refused unlisted.dylib (cdhash '",
        "'cs_probe: dlopen " + CS_PROBE + "/unlisted.dylib: refused: '",
        "'ndamfi: refused unlisted (cdhash '",
        # The exec fails past its point of no return: SIGKILL.
        "'zsh: killed     " + CS_PROBE + "/unlisted'",
        "'unlisted-status=137'",
        "'security.codesigning.neodarwin.enforcement: 1'",
        "'security.codesigning.trustcaches.num_static: 1'",
    ],
    data = ["//images:session_disk"],
    tags = ["manual", "kernel", "qemu"],
)

