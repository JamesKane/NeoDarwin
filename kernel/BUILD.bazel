# mount and fsck (docs/base/session.md): launchctl checks the read-only root
# with `fsck -q` (fsck_hfs) and remounts it with `mount -uw /` (mount_hfs).
# In the session, mount lists the root by its device; a second, blank
# virtio-blk disk (the whole disk with no partition map) gets a journaled
# HFS+ volume from newfs_hfs, is mounted with mount -t hfs, written,
# unmounted, checked with fsck_hfs -fn, mounted again and read back, and
# unmounted. The two disks register in either order, so the root is
# disk0s2 or disk1s2 here, and the scratch disk the other whole disk
# (sbsa_disk_boot_test, with one disk, checks /dev/disk0s2).
sh_test(
    name = "sbsa_disk_mount_boot_test",
    size = "medium",
    srcs = ["//tools/efi:qemu_efi_test.sh"],
    args = [
        "--cpu neoverse-n2",
        "--mem 2G",
        "--disk $(rootpath //images:session_disk)",
        "--drive scratch=64M",
        "--device virtio-blk-pci,drive=scratch,disable-legacy=on",
        "--until-lines",
        "--absent 'fsck failed!'",
        "--absent 'Running safe fsck'",
        "--send-after 'login: ' 'root\\n'",
        "--send-after 'root@localhost ~ # ' 'mount\\n'",
        "--send-after 'root@localhost ~ # ' 'd=; for x in /dev/disk[0-9]; do [ -e $${x}s1 ] || d=$$x; done; echo scratch-disk=$$d\\n'",
        "--send-after 'root@localhost ~ # ' 'newfs_hfs -J -v Scratch $$d && echo newfs-$$((6*7))\\n'",
        "--send-after 'root@localhost ~ # ' 'mkdir -p /Volumes/Scratch && mount -t hfs $$d /Volumes/Scratch && mount\\n'",
        "--send-after 'root@localhost ~ # ' 'echo round-trip-$$((6*7)) > /Volumes/Scratch/file && umount /Volumes/Scratch && fsck_hfs -fn $${d/disk/rdisk} && echo checked-$$((6*7))\\n'",
        "--send-after 'root@localhost ~ # ' 'mount -t hfs $$d /Volumes/Scratch && cat /Volumes/Scratch/file && umount /Volumes/Scratch && echo unmounted-$$((6*7))\\n'",
        "-",
        "180",
        "'s2, major'",
        "'launchctl: Running fsck on the boot volume...'",
        "'s2 on / (hfs, local, journaled)'",
        "'devfs on /dev (devfs, local'",
        "'scratch-disk=/dev/disk'",
        "' case-insensitive HFS Plus volume with a '",
        "'newfs-42'",
        "' on /Volumes/Scratch (hfs, local, journaled)'",
        "'The volume Scratch appears to be OK.'",
        "'checked-42'",
        "'round-trip-42'",
        "'unmounted-42'",
    ],
    data = ["//images:session_disk"],
    tags = ["manual", "kernel", "qemu"],
)

