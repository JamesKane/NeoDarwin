# XNU kernel builds (docs/kernel/arm64-sbsa-bringup.md, docs/repository.md §3).
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//rules:kc.bzl", "kext_collection")
load("//rules:xnu.bzl", "libfirehose_kernel", "nd_build_sdk", "xnu_headers", "xnu_kernel")

package(default_visibility = ["//visibility:public"])

DARWIN_VERSION = "25.0.0"  # macOS 26.0 release set; see upstream.lock

filegroup(
    name = "sdk_shims",
    srcs = glob(["sdk/**"]),
)

# NeoDarwin's libTrustCache interface (a kernel SDK shim), for host tests.
cc_library(
    name = "trustcache_shim",
    hdrs = ["sdk/usr/local/include/TrustCache/API.h"],
    strip_include_prefix = "sdk/usr/local/include",
)

# NeoDarwin additions to the host SDK: availability.pl, the kernel firehose
# header, and the shims under kernel/sdk.
nd_build_sdk(
    name = "build_sdk",
    availability_versions = "@apple_availability_versions//:all",
    libdispatch = "@apple_libdispatch//:all",
    shim_root = "sdk",
    shims = ":sdk_shims",
)

xnu_headers(
    name = "headers",
    darwin_version = DARWIN_VERSION,
    sdk = ":build_sdk",
    srcs = "@apple_xnu//:all",
)

libfirehose_kernel(
    name = "firehose_kernel",
    headers = ":headers",
    libdispatch = "@apple_libdispatch//:all",
    sdk = ":build_sdk",
)

# Apple's public VMAPPLE configuration with no NeoDarwin patches. Every source
# compiles; the link fails on symbols Apple ships only in closed archives.
# The report lists them: this is the gap Phase 1 drives to zero.
xnu_kernel(
    name = "vmapple_release_gaps",
    darwin_version = DARWIN_VERSION,
    firehose = ":firehose_kernel",
    link_gap_report = True,
    machine_config = "VMAPPLE",
    sdk = ":build_sdk",
    srcs = "@apple_xnu//:all",
)

load("@rules_shell//shell:sh_test.bzl", "sh_test")

# The gap may only shrink. Heavy (a full kernel build), so it runs in the
# kernel CI job (ci/kernel.sh), not in the default `bazel test //...`.
sh_test(
    name = "vmapple_link_gap_ratchet",
    size = "small",
    srcs = ["//tools/xnu:gap_ratchet.sh"],
    args = [
        "$(rootpath :vmapple_release_gaps)",
        "$(rootpath link_gaps/vmapple_release.txt)",
    ],
    data = [
        "link_gaps/vmapple_release.txt",
        ":vmapple_release_gaps",
    ],
    tags = ["manual", "kernel"],
)

# ---------------------------------------------------------------------------
# SBSA: NeoDarwin's generic Arm board config (docs/kernel/arm64-sbsa-bringup.md
# §2.3). Plain arm64 (no Apple PAC ABI) and no BTI, per the bring-up design.

SBSA_PATCHES = [
    "patches/0001-config-build-arm64-machine-code-and-pmap-from-source.patch",
    "patches/0002-sbsa-board-config.patch",
    "patches/0003-osfmk-generic-arm64-guards.patch",
    "patches/0004-config-sbsa-exports.patch",
    "patches/0005-bsd-build-ndamfi.patch",
    "patches/0006-sbsa-no-apple-implementation-registers.patch",
    "patches/0007-kalloc-enforce-per-size-class-zone-limit.patch",
    "patches/0008-libkern-build-ndcrypto.patch",
    "patches/0009-iokit-build-neodarwin-platform.patch",
    "patches/0010-libkern-build-libpthread-kern.patch",
    "patches/0011-mockfs-sbsa-root.patch",
    "patches/0012-iokit-publish-hidden-media-without-iomedia.patch",
    "patches/0013-mach-loader-static-pid1-on-sbsa.patch",
    "patches/0014-sleh-ack-group0-on-generic-gicv3.patch",
    "patches/0015-libkern-build-hfs.patch",
    "patches/0016-gicv3-timer-on-group1.patch",
    "patches/0017-generic-arm64-smp-psci-cpu-on.patch",
    "patches/0018-iokit-build-acpica-and-acpi-platform.patch",
    "patches/0019-sbsa-armv8.2-baseline.patch",
    "patches/0020-generic-arm64-cpu-id-from-full-mpidr.patch",
    "patches/0021-generic-arm64-framebuffer-console.patch",
]

# NeoDarwin-owned kernel sources added to the xnu tree before patching.
SBSA_OVERLAYS = {
    "//kernel/neodarwin/acpi:kernel_srcs": "iokit/ndacpi",
    "@acpica//:kernel_srcs": "iokit/ndacpi/acpica",
    "//kernel/neodarwin/amfi:kernel_srcs": "bsd/ndamfi",
    "//kernel/neodarwin/crypto:kernel_srcs": "libkern/ndcrypto",
    "//kernel/neodarwin/hfs:kernel_srcs": "libkern/ndhfs",
    "@apple_hfs//:kernel_srcs": "libkern/ndhfs/hfs",
    "//kernel/neodarwin/platform:kernel_srcs": "iokit/ndplatform",
    "//kernel/neodarwin/pthread:kernel_srcs": "libkern/ndpthread",
    "@apple_libpthread//:kernel_srcs": "libkern/ndpthread/libpthread",
    "@freebsd_crypto//:all": "libkern/ndcrypto/freebsd",
}

libfirehose_kernel(
    name = "firehose_kernel_arm64",
    arch = "arm64",
    headers = ":headers",
    libdispatch = "@apple_libdispatch//:all",
    sdk = ":build_sdk",
)

xnu_kernel(
    name = "sbsa_release",
    darwin_version = DARWIN_VERSION,
    firehose = ":firehose_kernel_arm64",
    machine_config = "SBSA",
    overlays = SBSA_OVERLAYS,
    make_vars = [
        "ARCH_STRING_FOR_CURRENT_MACHINE_CONFIG=arm64",
        "BTI_BUILD=0",
    ],
    patches = SBSA_PATCHES,
    sdk = ":build_sdk",
    srcs = "@apple_xnu//:all",
)

# The kernel is a fully linked arm64 Mach-O with no undefined symbols.
sh_test(
    name = "sbsa_kernel_test",
    size = "small",
    srcs = ["//tools/xnu:check_kernel.sh"],
    args = [
        "$(rootpaths :sbsa_release)",
        "arm64",
    ],
    data = [":sbsa_release"],
    tags = ["manual", "kernel"],
)

# ISA audit: no implementation-defined system registers, HVC, AMX or GXF in
# the SBSA kernel, and no instruction past the Armv8.2 baseline (P1-17): the
# ISA both the Q8B's Cortex-X1C/A78C and QEMU's cortex-a76 implement, v8.2
# with RCpc, dot product, AES, SHA-1/SHA-2 and FP16. The baseline file lists
# what is allowed by name, each entry guarded at run time; nothing may be
# added to it.
sh_test(
    name = "sbsa_isa_audit",
    size = "small",
    srcs = ["//tools/xnu:isa_audit.sh"],
    args = [
        "--mattr +v8.2a,+rcpc,+dotprod,+aes,+sha2,+fullfp16",
        "$(rootpaths :sbsa_release)",
        "$(rootpath isa_audit/sbsa_release.txt)",
    ],
    data = [
        "isa_audit/sbsa_release.txt",
        ":sbsa_release",
    ],
    tags = ["manual", "kernel"],
)

# ---------------------------------------------------------------------------
# Boot kernel collection: the SBSA kernel alone in an MH_FILESET, the format
# neoboot loads (arm64-sbsa-bringup.md §2.1). The kernel applies the chained
# fixups itself at arm_init; kcheck verifies them and round-trips the kernel.
kext_collection(
    name = "sbsa_kc",
    kernel = ":sbsa_release",
    out = "kernelcache.release.sbsa",
)

sh_test(
    name = "sbsa_kc_check",
    size = "small",
    srcs = ["//tools/kcheck:kcheck_test.sh"],
    args = [
        "$(rootpath //tools/kcheck)",
        "$(rootpath :sbsa_kc)",
        "$(rootpaths :sbsa_release)",
    ],
    data = [
        ":sbsa_kc",
        ":sbsa_release",
        "//tools/kcheck",
    ],
    tags = ["manual", "kernel"],
)

# P1-03: neoboot boots the collection on QEMU virt and the kernel reaches the
# listed serial lines, on neoverse-n2 (Armv9.0). The kernel's baseline is
# Armv8.2 since P1-17; the sbsa_a76_* tests boot it on cortex-a76.
sh_test(
    name = "sbsa_boot_test",
    size = "medium",
    srcs = ["//tools/efi:qemu_efi_test.sh"],
    args = [
        "--cpu neoverse-n2",
        "--mem 2G",
        "--esp NeoDarwin/kernelcache=$(rootpath :sbsa_kc)",
        "--esp NeoDarwin/ramdisk=$(rootpath //images:pid1_root)",
        "--until-lines",
        "$(rootpath //boot/neoboot)",
        "120",
        "'Darwin Kernel Version 25.0.0'",
        "'iBoot version: neoboot-0.1'",
        # Printed after ndcrypto has installed the crypto table and the kernel PRNG (P1-13).
        "'lockdown_mode: lockdown mode in nvram is off'",
        # After ndamfi has registered the AMFI and Image4 interfaces (P1-14).
        "'no external trust caches found'",
        # BSD initialisation, reached through the platform expert (P1-06).
        "'MAC Framework successfully initialized'",
        # Past bsd_init's pthread check, with libpthread's kern/ built in (P1-16).
        "'ifnet_attach: All kernel threads created for interface lo0'",
        # Rooted on HFS+ over the ramdisk (P1-08a), with PID 1 checking
        # syscalls, VM, Mach IPC and the calendar from userland (P1-07).
        "'BSD root: md0'",
        "'hfs: mounted NeoDarwin on device'",
        "'pid1: hello from userland: PID 1 on /dev/console'",
        "'pid1: mach: message round trip through mach_msg2'",
        "'pid1: all checks passed'",
        # ACPICA in the kernel, publishing IOACPIPlatformDevice nubs from
        # QEMU's DSDT (P1-09, docs/kernel/acpi.md): the PCI host bridge with
        # its windows, _CBA and _PRT read through the nub, the UART and the
        # last virtio-mmio slot with their _CRS registers and GIC INTIDs.
        "'NeoDarwinACPIPlatform: ACPICA 20260408; 9 tables (FACP DSDT APIC PPTT GTDT MCFG SPCR DBG2 IORT); 44 devices published, 3 more in IOACPIPlane'",
        "'NeoDarwinACPIPlatform: \\_SB.PCI0 PNP0A08 (PNP0A03) uid 0 bus 0-255 memory 0x10000000+0x2eff0000 io 0x3eff0000+0x10000 memory 0x8000000000+0x8000000000'",
        "'NeoDarwinACPIPlatform: \\_SB.PCI0: PCI segment 0, bus 0, ECAM 0x4010000000 (_CBA); _PRT 128 routes'",
        "'NeoDarwinACPIPlatform: \\_SB.COM0 ARMH0011 uid 0 mem 0x9000000+0x1000 irq 33'",
        "'NeoDarwinACPIPlatform: \\_SB.VR31 LNRO0005 uid 31 mem 0xa003e00+0x200 irq 79'",
        "'NeoDarwinACPIPlatform: \\_SB.GED ACPI0013 uid GED irq 41 edge'",
    ],
    data = [
        ":sbsa_kc",
        "//boot/neoboot",
        "//images:pid1_root",
    ],
    tags = ["manual", "kernel", "qemu"],
)

# P1-05's exit: the session boot on QEMU virt with a Secure world, TF-A at
# EL3 and the GIC's two security states (GICD_CTLR.DS == 0), as on SBSA
# boards (docs/kernel/qemu-secure.md). Group 0 is Secure there: Non-secure
# writes to its group and enable bits are ignored, so the timer ticks only on
# Group 1, as an IRQ. neoboot chooses Group 1 itself from GICD_CTLR (no
# boot.cfg), and a timed 1 s sleep in zsh proves the ticks.
sh_test(
    name = "sbsa_secure_boot_test",
    size = "medium",
    srcs = ["//tools/efi:qemu_efi_test.sh"],
    args = [
        "--machine virt-secure",
        "--firmware $(rootpath //third_party/qemu_firmware:virt_secure_flash)",
        "--cpu neoverse-n2",
        "--mem 2G",
        "--esp NeoDarwin/kernelcache=$(rootpath :sbsa_kc)",
        "--esp NeoDarwin/ramdisk=$(rootpath //images:session_root)",
        "--until-lines",
        "--send-after 'login: ' 'root\\n'",
        "--send-after 'root@localhost ~ # ' 'zmodload zsh/datetime && t=$$EPOCHREALTIME && sleep 1 && echo slept-$$(( EPOCHREALTIME - t >= 1 ))\\n'",
        "$(rootpath //boot/neoboot)",
        "180",
        "'NOTICE:  BL31: v2.15.0(release)'",
        "'DS=0 (two security states; Group 0 is Secure); timer PPI 27 on Group 1 (IRQ)'",
        "'NeoDarwinGICv3: timer PPI 27 on Group 1 (IRQ); '",
        "'hfs: mounted NeoDarwin on device'",
        "'com.apple.launchd'",
        "'slept-1'",
        # ACPICA and the ACPI nubs under TF-A (P1-09): the same DSDT.
        "'NeoDarwinACPIPlatform: ACPICA 20260408; 9 tables (FACP DSDT APIC PPTT GTDT MCFG SPCR DBG2 IORT); 44 devices published, 3 more in IOACPIPlane'",
        "'NeoDarwinACPIPlatform: \\_SB.PCI0: PCI segment 0, bus 0, ECAM 0x4010000000 (_CBA); _PRT 128 routes'",
    ],
    data = [
        ":sbsa_kc",
        "//boot/neoboot",
        "//images:session_root",
        "//third_party/qemu_firmware:virt_secure_flash",
    ],
    tags = ["manual", "kernel", "qemu"],
)

# P1-08b: the same boot with the userland base on the HFS+ root. PID 1 is a
# dynamically linked program that dyld starts with NeoDarwin's libSystem.
sh_test(
    name = "sbsa_dyld_boot_test",
    size = "medium",
    srcs = ["//tools/efi:qemu_efi_test.sh"],
    args = [
        "--cpu neoverse-n2",
        "--mem 2G",
        "--esp NeoDarwin/kernelcache=$(rootpath :sbsa_kc)",
        "--esp NeoDarwin/ramdisk=$(rootpath //images:hello_root)",
        "--until-lines",
        "$(rootpath //boot/neoboot)",
        "180",
        "'Darwin Kernel Version 25.0.0'",
        "'BSD root: md0'",
        "'hfs: mounted NeoDarwin on device'",
        "'hello: hello, world from dyld and libSystem, as PID 1'",
        "'hello: malloc: allocated, filled and freed'",
        "'hello: pthread: created and joined'",
        "'hello: dyld: dlopen and dlsym answer'",
        "'hello: dispatch: ran a function on a global queue'",
        "'hello: all checks passed'",
    ],
    data = [
        ":sbsa_kc",
        "//boot/neoboot",
        "//images:hello_root",
    ],
    tags = ["manual", "kernel", "qemu"],
)

# P1-08's exit: launchd-842 is PID 1 and starts getty from its LaunchDaemon
# plist; the test logs in over serial and runs commands in root's shell,
# zsh. Each step waits for zsh's prompt itself, since its PROMPT_SP line
# also starts with "#".
sh_test(
    name = "sbsa_session_boot_test",
    size = "medium",
    srcs = ["//tools/efi:qemu_efi_test.sh"],
    args = [
        "--cpu neoverse-n2",
        "--mem 2G",
        "--esp NeoDarwin/kernelcache=$(rootpath :sbsa_kc)",
        "--esp NeoDarwin/ramdisk=$(rootpath //images:session_root)",
        "--until-lines",
        "--send-after 'login: ' 'root\\n'",
        "--send-after 'root@localhost ~ # ' 'echo hi-$$((6*7))\\n'",
        "--send-after 'root@localhost ~ # ' 'uname -sm; ls /usr/libexec; tty; launchctl list\\n'",
        "--send-after 'root@localhost ~ # ' 'echo shell=$${(U)ZSH_NAME}-$$ZSH_VERSION\\n'",
        "--send-after 'root@localhost ~ # ' 'zmodload zsh/datetime && strftime %Y $$EPOCHSECONDS | read y && echo datetime-$$(( y > 2024 ))\\n'",
        "$(rootpath //boot/neoboot)",
        "180",
        "'hfs: mounted NeoDarwin on device'",
        "'hi-42'",
        "'Darwin arm64'",
        "'/dev/console'",
        "'com.apple.getty'",
        # zsh 5.9 is root's shell; loading a module dlopens its bundle.
        "'shell=ZSH-5.9'",
        "'datetime-1'",
    ],
    data = [
        ":sbsa_kc",
        "//boot/neoboot",
        "//images:session_root",
    ],
    tags = ["manual", "kernel", "qemu"],
)

# P1-05: the session boot with the timer on GIC Group 1, as an IRQ, which
# TrustZone boards need (GICD_CTLR.DS == 0 makes Group 0 Secure). QEMU virt
# without EL3 would allow Group 0, so boot.cfg forces timer-group=1; it
# replaces neoboot's default command line, so it repeats it. When it
# attaches, NeoDarwinGICv3 logs the timer's group and how many timer IRQs
# sleh_irq has taken before it; later ticks go through the controller, and a
# 1 s sleep from zsh must wake up with at least a second on the calendar.
sh_test(
    name = "sbsa_timer_group1_boot_test",
    size = "medium",
    srcs = ["//tools/efi:qemu_efi_test.sh"],
    args = [
        "--cpu neoverse-n2",
        "--mem 2G",
        "--esp NeoDarwin/kernelcache=$(rootpath :sbsa_kc)",
        "--esp NeoDarwin/ramdisk=$(rootpath //images:session_root)",
        "--esp NeoDarwin/boot.cfg=$(rootpath //boot/neoboot:testdata/timer-group1.cfg)",
        "--until-lines",
        "--send-after 'login: ' 'root\\n'",
        "--send-after 'root@localhost ~ # ' 'zmodload zsh/datetime && t=$$EPOCHREALTIME && sleep 1 && echo slept-$$(( EPOCHREALTIME - t >= 1 ))\\n'",
        "$(rootpath //boot/neoboot)",
        "180",
        "'timer PPI 27 on Group 1 (IRQ), forced by timer-group=1'",
        "'NeoDarwinGICv3: timer PPI 27 on Group 1 (IRQ); '",
        "'hfs: mounted NeoDarwin on device'",
        "'com.apple.launchd'",
        "'slept-1'",
    ],
    data = [
        ":sbsa_kc",
        "//boot/neoboot",
        "//boot/neoboot:testdata/timer-group1.cfg",
        "//images:session_root",
    ],
    tags = ["manual", "kernel", "qemu"],
)

