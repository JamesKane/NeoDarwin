    "'ALL tcp 10.0.2.15:22 <- 10.0.2.2:'",
    "'1/1 addresses added.'",
    "'   192.0.2.2'",
    "'tables-42'",
    "'pf disabled'",
    "'ping-passed-42'",
    "'year-2000'",
    "'sntp-wrapper: 10.0.2.2:'",
    "' 10.0.2.2 s1 no-leap'",
    "'synced-42'",
    "'host: clock-ok'",
    "'host: sntp-responder: answered 127.0.0.1:'",
    "'Accepted publickey for test from 10.0.2.2'",
]

sh_test(
    name = "sbsa_pf_ntp_test",
    size = "medium",
    srcs = ["//tools/efi:qemu_efi_test.sh"],
    args = [
        "--esp NeoDarwin/kernelcache=$(rootpath :sbsa_kc)",
        "--esp NeoDarwin/ramdisk=$(rootpath //images:pam_session_root)",
        "--esp NeoDarwin/trustcache=$(rootpath //images:pam_session_root_trustcache)",
