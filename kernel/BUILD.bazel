# P1-05: the session boot with the timer on GIC Group 1, as an IRQ, which
# TrustZone boards need (GICD_CTLR.DS == 0 makes Group 0 Secure). QEMU virt
# without EL3 would allow Group 0, so boot.cfg forces timer-group=1; it
# replaces neoboot's default command line, so it repeats it. When it
# attaches, NeoDarwinGICv3 logs the timer's group and how many timer IRQs
# sleh_irq has taken before it; later ticks go through the controller, and a
# 1 s sleep from zsh must wake up with at least a second on the calendar.
sh_test(
    name = "sbsa_timer_group1_boot_test",
    size = "medium",
    srcs = ["//tools/efi:qemu_efi_test.sh"],
    args = [
        "--cpu neoverse-n2",
        "--mem 2G",
        "--esp NeoDarwin/kernelcache=$(rootpath :sbsa_kc)",
        "--esp NeoDarwin/ramdisk=$(rootpath //images:session_root)",
        "--esp NeoDarwin/trustcache=$(rootpath //images:session_root_trustcache)",
        "--esp NeoDarwin/boot.cfg=$(rootpath //boot/neoboot:testdata/timer-group1.cfg)",
        "--until-lines",
        "--send-after 'login: ' 'root\\n'",
        "--send-after 'root@localhost ~ # ' 'zmodload zsh/datetime && t=$$EPOCHREALTIME && sleep 1 && echo slept-$$(( EPOCHREALTIME - t >= 1 ))\\n'",
        "$(rootpath //boot/neoboot)",
        "180",
        "'timer PPI 27 on Group 1 (IRQ), forced by timer-group=1'",
        "'NeoDarwinGICv3: timer PPI 27 on Group 1 (IRQ); '",
        "'hfs: mounted NeoDarwin on device'",
        "'com.apple.launchd'",
        "'slept-1'",
    ],
    data = [
        ":sbsa_kc",
        "//boot/neoboot",
        "//boot/neoboot:testdata/timer-group1.cfg",
        "//images:session_root",
        "//images:session_root_trustcache",
    ],
    tags = ["manual", "kernel", "qemu"],
)

# An IRQ before NeoDarwinGICv3 has attached to XNU's
# PassthruInterruptController, whose pointer (AppleARMSMP's gCPUIC) is NULL
# until cpu_boot_thread creates it (bring-up doc §2.1.11, patch 0047). With
# nd_gic_early_irq_test=1 the GIC driver sends its CPU SGI 15 from
# initWithNode, when that controller cannot exist yet; sleh_irq must hand it
# to the GIC's own IRQ loop. Before patch 0047 this boot took a data abort in
# PE_handle_ext_interrupt. QEMU virt: the timer on Group 0, as in the panic.
sh_test(
    name = "sbsa_early_irq_boot_test",
    size = "medium",
    srcs = ["//tools/efi:qemu_efi_test.sh"],
    args = [
        "--cpu neoverse-n2",
        "--mem 2G",
        "--esp NeoDarwin/kernelcache=$(rootpath :sbsa_kc)",
        "--esp NeoDarwin/ramdisk=$(rootpath //images:pid1_root)",
        "--esp NeoDarwin/trustcache=$(rootpath //images:pid1_root_trustcache)",
        "--esp NeoDarwin/boot.cfg=$(rootpath //boot/neoboot:testdata/early-irq.cfg)",
        "--absent 'NOT taken'",
        "--absent 'sleh_irq: stray INTID'",
        "--until-lines",
        "$(rootpath //boot/neoboot)",
        "120",
        "'NeoDarwinGICv3: early IRQ test: SGI 15 taken and completed before the CPU interrupt controller existed'",
        "' IRQs taken before the CPU interrupt controller existed, 0 of them strays'",
        "'NeoDarwinGICv3: timer PPI 27 on Group 0 (FIQ)'",
        "'pid1: all checks passed'",
    ],
    data = [
        ":sbsa_kc",
        "//boot/neoboot",
        "//boot/neoboot:testdata/early-irq.cfg",
        "//images:pid1_root",
        "//images:pid1_root_trustcache",
    ],
    tags = ["manual", "kernel", "qemu"],
)

