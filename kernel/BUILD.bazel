# The write policy for NVMe that isn't QEMU's (the Q8B's disk holds other
# systems): nd_nvme_rw=0 applies it to QEMU's controller. The session boots
# from its ramdisk with //images:data_disk (the session volume on a GPT
# disk firmware can't boot) as a second disk on NVMe: the
# namespace is published read-only (write-protected), its partitions still
# appear and read (the HFS+ signature at byte 1024 of disk?s2), and opening
# one for writing fails.
sh_test(
    name = "sbsa_nvme_readonly_test",
    size = "medium",
    srcs = ["//tools/efi:qemu_efi_test.sh"],
    args = [
        "--cpu neoverse-n2",
        "--mem 2G",
        "--esp NeoDarwin/kernelcache=$(rootpath :sbsa_kc)",
