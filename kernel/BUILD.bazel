# P1-08's exit: launchd-842 is PID 1 and starts getty from its LaunchDaemon
# plist; the test logs in over serial and runs commands in root's shell,
# zsh. Each step waits for zsh's prompt itself, since its PROMPT_SP line
# also starts with "#".
qemu_test(
    name = "sbsa_session_boot_test",
    cpu = "neoverse-n2",
    mem = "2G",
    esp = {
        ":sbsa_kc": "NeoDarwin/kernelcache",
        "//images:session_root": "NeoDarwin/ramdisk",
        "//images:session_root_trustcache": "NeoDarwin/trustcache",
    },
    send_after = [
        ("login: ", "root\\n"),
        ("root@localhost ~ # ", "echo hi-$((6*7))\\n"),
        ("root@localhost ~ # ", "uname -sm; ls /usr/libexec; tty; launchctl list\\n"),
        ("root@localhost ~ # ", "echo shell=${(U)ZSH_NAME}-$ZSH_VERSION\\n"),
        ("root@localhost ~ # ", "zmodload zsh/datetime && strftime %Y $EPOCHSECONDS | read y && echo datetime-$(( y > 2024 ))\\n"),
        # The ACPI platform's "ACPI Tables" (docs/kernel/acpi.md), which
        # acpidump reads: its keys, and the RSDP's signature in its data.
        ("root@localhost ~ # ", "ioreg -rd1 -k \"ACPI Tables\" -w0 | grep -oE \"[A-Z0-9]{4}(-[0-9]+)?.=<\" | " +
                                "sed \"s/.=<//\" | sort | paste -sd, - | sed s/^/a\"\"t-/; " +
                                "ioreg -rd1 -k \"ACPI Tables\" -w0 | grep -c \"RSDP.=<5253442050545220\" | sed s/^/rs\"\"dp-/\\n"),
    ],
    timeout_s = 180,
    expect = [
        "hfs: mounted NeoDarwin on device",
        "hi-42",
        "Darwin arm64",
        "/dev/console",
        "com.apple.getty",
        # zsh 5.9 is root's shell; loading a module dlopens its bundle.
        "shell=ZSH-5.9",
        "datetime-1",
        "rsdp-1",
        # QEMU virt's tables (P1-09's nine, the DSDT included), RSDP and XSDT.
        "at-APIC,DBG2,DSDT,FACP,GTDT,IORT,MCFG,PPTT,RSDP,SPCR,XSDT",
    ],
    tags = ["manual", "kernel", "qemu"],
)

