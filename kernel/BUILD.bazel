# ---------------------------------------------------------------------------
# QEMU sbsa-ref (docs/kernel/qemu-sbsa-ref.md): the SBSA reference machine,
# booted by TF-A PLAT=qemu_sbsa and EDK2 SbsaQemu built from pinned source
# (//third_party/qemu_firmware:sbsa_ref_flash), with its own ACPI tables.
# DRAM at 1 TiB (patch 0030: TCR_EL1.IPS), UEFI at EL2 (patch 0031: the
# secondaries' reset vector leaves EL2), GIC with an ITS at 0x40060000,
# PL011 at 0x60000000, PSCI over SMC; four neoverse-n2 CPUs, as the machine
# has by default.
SBSA_REF = [
    "--machine sbsa-ref",
    "--firmware $(rootpath //third_party/qemu_firmware:sbsa_ref_flash0.fd)",
    "--firmware-ns $(rootpath //third_party/qemu_firmware:sbsa_ref_flash1.fd)",
    "--smp 4",
]

SBSA_REF_FIRMWARE = [
    "//third_party/qemu_firmware:sbsa_ref_flash0.fd",
    "//third_party/qemu_firmware:sbsa_ref_flash1.fd",
]

# What every sbsa-ref boot shows: the firmware, neoboot's reading of
