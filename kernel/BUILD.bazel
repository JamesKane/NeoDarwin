# The base's command-line programs (P4-21, docs/architecture/freebsd-parity.md
# §2.1): a sample of each project's, run as root on //images:session_root.
# text_cmds: jot's, rev's, base64's, md5's and sha256's output, and ed
# editing a file; patch_cmds: patch applying diff -u's output, diff3 and
# sdiff; shell_cmds: apply, yes, realpath, uptime (w), getopt, a locate
# database built by locate.mklocatedb and searched, and time; file_cmds:
# pathchk, ipcs; misc_cmds: cal, tsort, units, ncal -e, calendar on a
# one-line file; system_cmds: pagesize, dmesg (the kernel's message buffer),
# zdump, zic, shutdown -s (refused: no IOPMLib, patch 0006); basic_cmds:
# mesg, write to the console; remote_cmds: logger, wall. Compression and
# archives (cp2): gzip, bzip2, xz, xzdec and zstd round trips and lzmainfo;
# tar cf/tf, czf/xzf and bsdcat; cpio -o, -it and -id; zgrep, bzgrep and
# grep --xz; unzip -l and -p on a zip made on the host (base64 in the typed
# line). The interactive essentials (cp3): bc and dc, file on a Mach-O,
# less -F and lessecho; man -w, man formatting with mandoc and paging
# through less, soelim; tput and infocmp on vt100; iconv from UTF-8 to
# Latin-1; nc -z to an nc -l on loopback; tcsh and csh -c; mail reading a
# one-message mailbox; locale -a and charmap in en_US.UTF-8 and C.UTF-8,
# and cal without a setlocale warning in en_US.UTF-8. Man pages: man -w,
# man ls, apropos and whatis. vi (vis): its version line, an edit written
# without a keyboard, and its Lua runtime loading LPeg and a lexer. Each expected
# line is output the typed text can't contain ("" splits the words that
# would match). FreeBSD's leaf utilities (cp4): nproc, uuidgen, m4,
# perror, ident, ministat, xo, getaddrinfo, daemon and pwait, nmtree,
# bsdiff and bspatch, fifolog, fsync, ts, domainname.
sh_test(
    name = "sbsa_base_commands_test",
    size = "medium",
    srcs = ["//tools/efi:qemu_efi_test.sh"],
    args = [
        "--cpu neoverse-n2",
        "--mem 2G",
        "--esp NeoDarwin/kernelcache=$(rootpath :sbsa_kc)",
        "--esp NeoDarwin/ramdisk=$(rootpath //images:session_root)",
        "--esp NeoDarwin/trustcache=$(rootpath //images:session_root_trustcache)",
        # A blank 16 MB virtio disk for cp6's disk tools and iostat's
        # IOBlockStorageDriver statistics.
        "--drive disk0=16M",
        "--device virtio-blk-pci,drive=disk0",
        "--until-lines",
        "--absent 'setlocale: Bad'",
        "--send-after 'login: ' 'root\\n'",
        "--send-after 'root@localhost ~ # ' 'jot -s, 3 7; echo abc-rev | rev; echo hi | base64; md5 -s x; sha256 -q -s x\\n'",
        "--send-after '2d711642b726b04401627ca9fbac32f5c8530fb1903cc4db02258717921a4881' " +
        "'echo ndx > /tmp/e; (echo s/x/xxx/; echo w; echo q) | ed -s /tmp/e; cat /tmp/e\\n'",
        "--send-after 'ndxxx' 'echo patch > /tmp/p1; echo old >> /tmp/p1; echo patch > /tmp/p2; echo new >> /tmp/p2; " +
        "diff -u /tmp/p1 /tmp/p2 > /tmp/d; patch -s /tmp/p1 < /tmp/d; paste -sd= /tmp/p1; " +
        "diff3 /tmp/p1 /tmp/p2 /tmp/p2 && echo diff3-o\"\"k; sdiff -s /tmp/p1 /tmp/p2 && echo sdiff-o\"\"k\\n'",
        "--send-after 'sdiff-ok' 'apply \"echo ap-%1\" q r; yes yy | head -2 | paste -sd. -; realpath /etc; uptime; " +
        "getopt ab: -a -b x; printf /zz/loc%s fnd > /tmp/l; echo >> /tmp/l; " +
        "/usr/libexec/locate.mklocatedb < /tmp/l > /tmp/db; locate -d /tmp/db fnd; /usr/bin/time true; " +
        "pathchk -p /ok/path && echo pathchk-o\"\"k; ipcs | head -1\\n'",
        "--send-after 'IPC status from' 'cal 1 2026; echo \"a b\" | tsort | paste -sd- -; units -t \"1 mile\" ft; " +
        "ncal -e 2026; pagesize; mesg\\n'",
        "--send-after 'is y' 'dmesg | grep -q \"kprintf initialized\" && echo dmesg-o\"\"k; " +
        "zdump UTC | sed \"s/ .* / <> /\"; zic --version; logger lg-x && echo logger-o\"\"k; echo wall-\"\"x | wall; " +
        "echo wr-\"\"x | write root console; printf \"01/01\\tcy\"\"-x\" > /tmp/c; echo >> /tmp/c; " +
        "calendar -f /tmp/c -t 01.01.2026; shutdown -s now\\n'",
        "--send-after 'sleep is not supported' 'echo gz-r\"\"t | gzip | gzip -d; echo bz-r\"\"t | bzip2 | bzcat; " +
        "echo xz-r\"\"t | xz | xzcat; echo xd-r\"\"t | xz | xzdec; echo lz | lzma | lzmainfo; " +
        "echo zs-r\"\"t | zstd | unzstd\\n'",
        "--send-after 'zs-rt' 'mkdir -p /tmp/t/d && cd /tmp/t && echo tar-\"\"a1 > d/f1 && echo tar-\"\"b2 > d/f2 && " +
        "tar cf x.tar d && tar tf x.tar | paste -sd, - && tar czf x.tgz d && rm -r d && tar xzf x.tgz && " +
        "cat d/f2 && bsdcat x.tgz | tar tf - | paste -sd: -\\n'",
        "--send-after 'd/:d/f1:d/f2' 'find d | cpio -o > x.cpio && cpio -it < x.cpio | paste -sd+ - && mkdir c && " +
        "cd c && cpio -id < ../x.cpio && cmp d/f1 ../d/f1 && echo cpio-\"\"ok; cd /tmp\\n'",
        "--send-after 'cpio-ok' 'echo zg-ne\"\"edle | gzip > /tmp/z.gz; zgrep ne\"\"edle /tmp/z.gz; " +
        "echo bg-ne\"\"edle | bzip2 | bzgrep ne\"\"edle; echo xg-ne\"\"edle | xz | grep --xz ne\"\"edle\\n'",
        "--send-after 'xg-needle' 'echo UEsDBBQAAAAIAAAAIVxcWMj6EwAAABEAAAANAAAAdXotbWVtYmVyLnR4dCvNq8os0E3OzytJzSvRzc/m" +
        "AgBQSwECFAMUAAAACAAAACFcXFjI+hMAAAARAAAADQAAAAAAAAAAAAAApAEAAAAAdXotbWVtYmVyLnR4dFBLBQYAAAAAAQABADsAAAA+AAAA" +
        "AAA= | base64 -d > /tmp/u.zip; unzip -l /tmp/u.zip; unzip -p /tmp/u.zip\\n'",
        # lsvfs walks every type number below vfs.generic.maxtypenum: before
        # kernel patch 0044, mockfs's 'mock' made that 1.8 billion sysctls.
        "--send-after 'unzip-content-ok' 'lsvfs > /tmp/v && echo lsvfs-d\"\"one-$$(grep -c . /tmp/v)\\n'",
        # The interactive essentials (cp3).
        "--send-after 'lsvfs-done-' 'echo \"2^20\" | bc; echo \"12345 6789 * p\" | dc; file /bin/ls; " +
        "echo ls-\"\"ok | less -FX; lessecho le-\"\"echo\\n'",
        "--send-after 'le-echo' 'man -w less; man mandoc | head -1; echo .so /tmp/s2 > /tmp/s1; " +
        "echo so-\"\"inc > /tmp/s2; soelim /tmp/s1\\n'",
        "--send-after 'so-inc' 'tput -T vt100 cols | sed \"s/^/cols-/\"; infocmp -1 vt100 | grep -m1 cols; " +
        "printf \"x\\303\\251y\" | iconv -f UTF-8 -t ISO-8859-1 | od -An -tx1\\n'",
        "--send-after '78  e9  79' 'nc -l 127.0.0.1 9999 > /dev/null & sleep 1; nc -z 127.0.0.1 9999 && echo nc-\"\"ok; " +
        "kill %1 2>/dev/null; tcsh -c \"repeat 2 echo tc-\"\"rep\"; csh -c \"if (1 == 1) echo cs-\"\"if\"\\n'",
        "--send-after 'cs-if' 'echo From a@b Thu Jan 11 00:00:00 2026 > /tmp/mb; echo Subject: ml-x >> /tmp/mb; " +
        "echo >> /tmp/mb; echo bo-\"\"dy >> /tmp/mb; echo p | mail -n -f /tmp/mb\\n'",
        "--send-after 'bo-dy' 'locale -a | grep _US | sed s/^/la-/; LC_ALL=en_US.UTF-8 locale charmap | sed s/^/cm-/; " +
        "LC_ALL=C.UTF-8 locale charmap | sed s/^/cc-/; LANG=en_US.UTF-8 cal 1 2026 2>&1 | grep -c setlocale | " +
        "sed s/^/sl-/\\n'",
        # Man pages for every project (P4-21): man -w, man through mandoc to
        # cat, and apropos and whatis on the whatis file built with the image.
        "--send-after 'sl-0' 'man -w ls; MANPAGER=cat man ls | head -1; apropos gzip | grep -c Lempel | " +
        "sed s/^/ap-/; whatis ls | sed s/^/wi-/\\n'",
        # vi is vis (user decision 2026-10-05): its version line, then an
        # edit with no one at the keyboard: x/old/ c/new/ on the file, w in a
        # second window on the same file (vis shares the text) and qall in a
        # third. A visrc.lua in XDG_CONFIG_HOME, which requires
        # /usr/share/vis/vis.lua, writes /tmp/vl if LPeg and the C lexer load.
        "--send-after 'wi-ls(1)' 'vi -v; mkdir -p /tmp/vc/vis; echo \"require([[vis]]) " +
        "vis.events.subscribe(vis.events.INIT, function() local f = io.open([[/tmp/vl]], [[w]]) " +
        "f:write(vis.lexers.load([[ansi_c]]) and [[lexer-]]..[[ok]] or [[no]]) f:close() end)\" " +
        "> /tmp/vc/vis/visrc.lua; echo vi-old > /tmp/vf; TERM=vt100 XDG_CONFIG_HOME=/tmp/vc " +
        "vi \"+x/old/ c/new/\" /tmp/vf +w /tmp/vf +qall /tmp/vf; tr a-z A-Z < /tmp/vf; cat /tmp/vl; echo\\n'",
        # FreeBSD's leaf utilities (cp4): nproc (one CPU), uuidgen's length
        # and -r's version digit, m4 with eval, perror; ident on a $Id$
        # line, ministat, xo; getaddrinfo, daemon with a pidfile and pwait -v
        # on its child; an nmtree spec checked, then a change caught; bsdiff
        # and bspatch, fifolog, fsync, ts, domainname, man -w m4.
        "--send-after 'lexer-ok' 'nproc | sed s/^/n\"\"p-/; nproc --all | sed s/^/na\"\"ll-/; " +
        "uuidgen | wc -c | sed \"s/ //g;s/^/u\"\"g-/\"; uuidgen -r | cut -c15 | sed s/^/v\"\"4-/; " +
        "echo \"define(N,4)define(M,eval(N*N))m4-M\" | m4; perror 2 | sed s/^/pe\"\"rr-/\\n'",
        "--send-after 'perr-No such' 'echo \\$$Id: id\"\"t-x \\$$ > /tmp/id; ident /tmp/id; jot 4 > /tmp/ms; " +
        "ministat -n /tmp/ms | tail -1; xo --text \"x\"\"o-{:w}\" ok; echo\\n'",
        "--send-after 'xo-ok' 'getaddrinfo localhost; daemon -f -p /tmp/dp sleep 2; sleep 1; " +
        "pwait -v $$(cat /tmp/dp)\\n'",
        "--send-after 'exited with status 0.' 'mkdir -p /tmp/mt/a && echo m > /tmp/mt/a/f && " +
        "nmtree -c -K sha256digest -p /tmp/mt > /tmp/mt.spec && nmtree -p /tmp/mt -f /tmp/mt.spec && " +
        "echo mt\"\"-ok; echo x >> /tmp/mt/a/f; nmtree -p /tmp/mt -f /tmp/mt.spec | grep -c sha256 | " +
        "sed s/^/mt\"\"ch-/\\n'",
        "--send-after 'mtch-' 'jot 2000 > /tmp/o; sed s/1000/ten/ /tmp/o > /tmp/n; bsdiff /tmp/o /tmp/n /tmp/bp && " +
        "bspatch /tmp/o /tmp/n2 /tmp/bp && cmp /tmp/n /tmp/n2 && echo bsd\"\"iff-ok; fifolog_create -s 1m /tmp/fl && " +
        "echo ff\"\"log | fifolog_writer -z 0 /tmp/fl; fifolog_reader /tmp/fl | grep -c fflog | sed s/^/fl\"\"r-/; " +
        "fsync /tmp/o && echo fs\"\"ync-ok; echo t\"\"s-x | ts \"[%%]\"; domainname nd\"\"x.test; " +
        "domainname | sed s/^/dn-/; man -w m4\\n'",
        # The heavier FreeBSD programs (cp5): bmake on a two-target Makefile
        # (and sys.mk from /usr/share/mk), dtc to a blob and back, mkimg's
        # GPT header, makefs's ffs, cd9660 and msdos images, iasl, fetch of a
        # file: URL, certctl's trust store, drill's version, ip6addrctl.
        "--send-after 'man1/m4.1' 'mkdir -p /tmp/bm && cd /tmp/bm && echo \"all: a b ; @echo bm-\"\"all\" > Makefile && " +
        "echo \"a: ; @echo bm-\"\"a\" >> Makefile && echo \"b: ; @echo bm-\"\"b\" >> Makefile && make && " +
        "make -V MACHINE_ARCH | sed s/^/ma-/; cd /tmp\\n'",
        "--send-after 'ma-aarch64' 'echo \"/dts-v1/; / { n { reg = <1 2>; }; };\" > /tmp/t.dts && " +
        "dtc -O dtb -o /tmp/t.dtb /tmp/t.dts && dtc -I dtb -O dts /tmp/t.dtb | grep reg; echo x > /tmp/p; " +
        "mkimg -s gpt -p freebsd-ufs:=/tmp/p -o /tmp/g.img && head -c 520 /tmp/g.img | tail -c 8; echo\\n'",
        "--send-after 'EFI PART' 'mkdir -p /tmp/mf/d && echo mf > /tmp/mf/d/f && makefs -t ffs -s 4m /tmp/mf.ffs /tmp/mf > /dev/null && " +
        "file -b /tmp/mf.ffs | cut -c1-21; makefs -t cd9660 /tmp/mf.iso /tmp/mf > /dev/null && file -b /tmp/mf.iso | cut -c1-15; " +
        "makefs -t msdos -s 2m -o fat_type=12 /tmp/mf.fat /tmp/mf > /dev/null && file -b /tmp/mf.fat | grep -c \"FAT (12\" | " +
        "sed s/^/fat-/\\n'",
        "--send-after 'fat-1' 'echo \"DefinitionBlock (\\\"\\\", \\\"SSDT\\\", 2, \\\"ND\\\", \\\"T\\\", 1) { Name (NDX, 42) }\" > /tmp/t.asl && " +
        "iasl /tmp/t.asl | grep Compilation; wc -c < /tmp/t.aml | sed \"s/ //g;s/^/aml-/\"\\n'",
        "--send-after 'aml-43' 'fetch -q -o /tmp/h file:///etc/hosts && cmp /tmp/h /etc/hosts && echo fe\"\"tch-ok; " +
        "certctl list | wc -l | sed \"s/ //g;s/^/cc-/\"; drill -v | head -1 | sed \"s/^.*ldns/ld\"\"ns/\"; ip6addrctl show | head -2; " +
        "man -w make\\n'",
        # CoreFoundation and IOKitLib (cp6b) through ioreg: every entry's
        # properties (IORegistryEntryCreateCFProperties) with none missing,
        # the platform expert's three lines, a matching-dictionary search
        # by class (no IOMedia on this machine: an empty answer, status 0),
        # a property value under IOResources, the device tree plane, and
        # the XML property list CF writes for -a; ioreg's page.
        "--send-after 'man1/make.1' 'ioreg -l | grep -c IOPlatformExpert | sed s/^/p\"\"e-/; " +
        "ioreg -l | grep -c \"t obtain\" | sed s/^/ce\"\"rr-/; ioreg -c IOMedia > /dev/null; echo m\"\"d-rc-$$?; " +
        "ioreg -r -c IOResources -d 1 | grep -c \"Type1. = Yes\" | sed s/^/fs\"\"c-/; " +
        "ioreg -p IODeviceTree -d 2 | grep -c \"o device-.ree\" | sed s/^/dt\"\"-/; " +
        "ioreg -a -d 1 | head -8 | grep -c \"<key>IOObjectClass\" | sed s/^/a\"\"x-/; man -w ioreg\\n'",
        # cp6: vm_stat's header; an xattr written and read back; lsof on
        # this shell's working directory; host's usage (no DNS server
        # here); top's logging mode; iostat's drive columns, which come
        # from the IOKit registry. Then the disk tools on the blank 16 MB
        # disk (found by its size): diskinfo's sizes, trim -f (DKIOCUNMAP),
        # makefs's FAT image written to it and recognized by fstyp (its
        # fstyp_msdos helper), recoverdisk sizing and reading it, and diskinfo -s,
        # which xnu can't answer.
        "--send-after 'man8/ioreg.8' 'vm_stat | head -1; touch /tmp/xa; xattr -w nd.k xv-\"\"al /tmp/xa; " +
        "xattr -p nd.k /tmp/xa; lsof -a -d cwd -p $$$$ | grep -c /tmp | sed s/^/ls\"\"of-/; " +
        "host 2>&1 | grep -c \"query SOA\" | sed s/^/ho\"\"st-/; top -l 1 | head -1; iostat -c 1 | sed -n 2p\\n'",
        "--send-after 'KB/t' 'D=$$(for d in /dev/rdisk[0-9]; do [ \"$$(diskinfo $$d | cut -f3)\" = 16777216 ] && " +
        "echo $$d; done | head -1); diskinfo $$D | cut -f2-4 | tr \"[:blank:]\" \" \" | sed s/^/di-/; trim -f -l 1m $$D; " +
        "dd if=/tmp/mf.fat of=$$D bs=64k 2>/dev/null; fstyp $$D | sed s/^/ft-/; " +
        "recoverdisk $$D 2>&1 | grep -m1 total_size; " +
        "diskinfo -s $$D 2>&1 | grep -c \"not supported on Darwin\" | sed s/^/ds-/\\n'",
        # cp6b: pciconf over the registry's IOPCIDevice nubs: every function
        # listed, the virtio disks among them by their IDs, -v's class names,
        # -a by driver name, the refusal of a config-space read, and the pages of pciconf
        # and acpidump (acpidump itself waits for the kernel's "ACPI Tables":
        # //kernel:sbsa_acpidump_test).
        "--send-after 'ds-1' 'pciconf -l; pciconf -l | grep -c class= | sed s/^/pc\"\"i-/; " +
        "pciconf -l | grep -c \"vendor=0x1af4 device=0x1001\" | sed s/^/vi\"\"o-/; " +
        "pciconf -lv | grep -c \"class      = mass storage\" | sed s/^/pv\"\"-/; " +
        "pciconf -a $$(pciconf -l | grep -m1 \" vendor=0x1af4\" | cut -d@ -f1); " +
        "pciconf -r pci0:0:0:0 0 2>&1 | grep -c \"not supported on NeoDarwin\" | sed s/^/pr\"\"-/; " +
        "man -w pciconf acpidump\\n'",
        "$(rootpath //boot/neoboot)",
