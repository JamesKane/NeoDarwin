# acpidump (P4-21 checkpoint 6b, base/acpidump) against the ACPI platform's
# "ACPI Tables" (docs/kernel/acpi.md): -t's RSDP line and table headers,
# -T MCFG's allocation, -o's DSDT and -d's disassembly through iasl.
# //base/acpidump:acpidump_host_test covers the same options against a
# captured copy of these tables on the build machine.
sh_test(
    name = "sbsa_acpidump_test",
    size = "medium",
    srcs = ["//tools/efi:qemu_efi_test.sh"],
    args = [
        "--cpu neoverse-n2",
        "--mem 2G",
        "--esp NeoDarwin/kernelcache=$(rootpath :sbsa_kc)",
        "--esp NeoDarwin/ramdisk=$(rootpath //images:session_root)",
        "--esp NeoDarwin/trustcache=$(rootpath //images:session_root_trustcache)",
        "--until-lines",
        "--send-after 'login: ' 'root\\n'",
        "--send-after 'root@localhost ~ # ' 'acpidump -t; acpidump -t | grep -c \": Length=\" | sed s/^/ac\"\"t-/; " +
        "acpidump -t 2>&1 | grep -c corrupt | sed s/^/co\"\"rrupt-/\\n'",
        "--send-after 'root@localhost ~ # ' 'acpidump -T MCFG | grep Segment | sed \"s/.*=/mc\"\"fg-/\"; " +
        "acpidump -o /tmp/d.aml && head -c 4 /tmp/d.aml | sed s/^/a\"\"o-/; echo; " +
        "acpidump -d 2>/dev/null | grep -m1 -o DefinitionBlock | sed s/^/di\"\"s-/\\n'",
        "$(rootpath //boot/neoboot)",
        "180",
        "'hfs: mounted NeoDarwin on device'",
        "'RSD PTR: OEM=BOCHS, ACPI_Rev=2.0x (2)'",
        "'  XSDT: Length='",
        "'  FACP: Length='",
        "'  DSDT: Length='",
        # QEMU virt's tables, each a header: the XSDT, the FACP and DSDT,
        # and the other seven (APIC, DBG2, GTDT, IORT, MCFG, PPTT, SPCR).
        "'act-10'",
        "'corrupt-0'",
        "'mcfg-0x0000'",
        "'ao-DSDT'",
        "'dis-DefinitionBlock'",
    ],
    data = [
        ":sbsa_kc",
        "//boot/neoboot",
        "//images:session_root",
        "//images:session_root_trustcache",
    ],
    tags = ["manual", "kernel", "qemu"],
)

# PAM (docs/base/session.md, "PAM"): login and su authenticate through
# OpenPAM, its modules dlopened under code-signing enforcement. On
# //images:pam_session_root (test accounts test, in group admin, and guest,
# password "neodarwin"; test's hash is SHA-512 crypt, guest's traditional
# DES, so both of crypt(3)'s families log in): a wrong password is refused;
# test logs in and su
# makes it root without a password (root's is empty: pam_unix nullok, gated by
# pam_group); as root it writes /etc/nologin, which pam_nologin shows and
# enforces: guest is refused, root still logs in (empty password, no
# prompt). With /etc/nologin gone, guest logs in, and su refuses it: guest
# is in neither admin nor wheel.
sh_test(
    name = "sbsa_pam_session_test",
    size = "medium",
    srcs = ["//tools/efi:qemu_efi_test.sh"],
    args = [
        "--cpu neoverse-n2",
        "--mem 2G",
        "--esp NeoDarwin/kernelcache=$(rootpath :sbsa_kc)",
        "--esp NeoDarwin/ramdisk=$(rootpath //images:pam_session_root)",
        "--esp NeoDarwin/trustcache=$(rootpath //images:pam_session_root_trustcache)",
        "--until-lines",
        "--absent 'ndamfi: refused'",
        "--send-after 'login: ' 'test\\n'",
        "--send-after 'Password:' 'wrong\\n'",
        "--send-after 'login: ' 'test\\n'",
        "--send-after 'Password:' 'neodarwin\\n'",
        "--send-after 'test@localhost ~ % ' 'echo user-$$(id -un)-$$(id -u)\\n'",
        "--send-after 'test@localhost ~ % ' 'su - root -c id; echo su-status=$$?\\n'",
        "--send-after 'test@localhost ~ % ' 'su - root -c \"echo nologin-$$((6*7)) > /etc/nologin\"; exit\\n'",
        "--send-after 'login: ' 'guest\\n'",
        "--send-after 'Password:' 'neodarwin\\n'",
        "--send-after 'login: ' 'root\\n'",
        "--send-after 'root@localhost ~ # ' 'rm /etc/nologin; echo root-$$(id -u); exit\\n'",
        "--send-after 'login: ' 'guest\\n'",
        "--send-after 'Password:' 'neodarwin\\n'",
        "--send-after 'guest@localhost ~ % ' 'su - root -c id; echo su-status=$$?\\n'",
        "$(rootpath //boot/neoboot)",
        "240",
        "'ndamfi: code-signing enforcement on (a static trust cache from the loader)'",
        "'Login incorrect'",
        "'user-test-501'",
        "'uid=0(root)'",
        "'su-status=0'",
        # pam_nologin shows /etc/nologin to guest (refused) and root.
        "'nologin-42'",
        "'root-0'",
        "'su: Sorry'",
        "'su-status=1'",
    ],
    data = [
        ":sbsa_kc",
        "//boot/neoboot",
        "//images:pam_session_root",
        "//images:pam_session_root_trustcache",
    ],
    tags = ["manual", "kernel", "qemu"],
)

# BSM audit (docs/base/session.md, "BSM audit") on //images:pam_session_root.
# launchctl's bootstrap starts the trail (libauditd's audit_quick_start());
# auditd runs on demand. A wrong password and then test's own make login
# record a failed and a successful AUE_login; test becomes root with su
# (AUE_su), and test's logout records AUE_logout. root logs in and has
# auditd rotate the trail (audit -n: launchd starts auditd on demand, on the
# audit control port, which launchd patch 0006 makes possible), and praudit
# prints the records. Each expected line is praudit's or ls's, never typed:
# the startup record, the failed login's non-attributable subject (auid -1)
# and text, test's login and logout, su's record, and the identity token xnu
# adds to each user record (OpenBSM patch 0001).
sh_test(
    name = "sbsa_audit_test",
    size = "medium",
    srcs = ["//tools/efi:qemu_efi_test.sh"],
    args = [
        "--cpu neoverse-n2",
        "--mem 2G",
        "--esp NeoDarwin/kernelcache=$(rootpath :sbsa_kc)",
        "--esp NeoDarwin/ramdisk=$(rootpath //images:pam_session_root)",
        "--esp NeoDarwin/trustcache=$(rootpath //images:pam_session_root_trustcache)",
        "--until-lines",
        "--absent 'ndamfi: refused'",
        "--absent 'audit_quick_start() failed'",
        "--send-after 'login: ' 'test\\n'",
        "--send-after 'Password:' 'wrong\\n'",
        "--send-after 'login: ' 'test\\n'",
        "--send-after 'Password:' 'neodarwin\\n'",
        "--send-after 'test@localhost ~ % ' 'su - root -c id; exit\\n'",
        "--send-after 'login: ' 'root\\n'",
        "--send-after 'root@localhost ~ # ' 'audit -n; sleep 3; launchctl list; ls -l /var/audit\\n'",
        "--send-after 'root@localhost ~ # ' 'praudit -l /var/audit/2*\\n'",
        "$(rootpath //boot/neoboot)",
        "240",
        "'ndamfi: code-signing enforcement on (a static trust cache from the loader)'",
        "'Login incorrect'",
        "'uid=0(root)'",
        "'Trigger sent.'",
        # auditd, started on demand, rotated the trail.
        "'.not_terminated'",
        # praudit: the trail's first record, from audit_quick_start().
        "'audit startup,0,'",
        "'text,launchctl::Audit startup,return,success,0,'",
        # The failed login: non-attributable (auid -1), with login's text.
        "'subject_ex,-1,root,wheel,-1,nogroup,'",
        "'text,Login incorrect,return,failure : Operation not permitted,'",
        # test's login and logout, and su's successful authentication.
        "'login - local,0,'",
        "'subject_ex,test,root,wheel,test,staff,'",
        "'logout - local,0,'",
        "'su(1),0,'",
        "'subject,test,root,staff,test,staff,'",
        "'text,successful authentication,return,success,0,'",
        # The identity token xnu adds to each user record (patch 0001).
        "'identity,1,login,complete,,complete,0x'",
        "'identity,1,su,complete,,complete,0x'",
    ],
    data = [
        ":sbsa_kc",
        "//boot/neoboot",
        "//images:pam_session_root",
        "//images:pam_session_root_trustcache",
    ],
    tags = ["manual", "kernel", "qemu"],
)

# Accounts (docs/base/session.md, "passwd and chpass") on
# //images:pam_session_root. test logs in to zsh, whose /etc/zprofile ran
# path_helper: PATH is /etc/paths' entries, in order. test changes its
# password with passwd (old password, then the new one twice); the old one
# is then refused, the new one accepted. test sets its full name with chpass
# (EDITOR is tests/qemu/pam/chpass_editor; chpass asks for the password), and
# getpwnam answers with it. root changes test's shell with chpass -s:
# master.passwd has it, and the SHA-512 crypt hash passwd wrote ("$6$", a
# 16-character salt, the 86-character hash), and pwd_mkdb has written
# /etc/passwd ("*" for the password). root gives itself a password with
# passwd, and login then asks root for it.
sh_test(
    name = "sbsa_accounts_test",
    size = "medium",
    srcs = ["//tools/efi:qemu_efi_test.sh"],
    args = [
        "--cpu neoverse-n2",
        "--mem 2G",
        "--esp NeoDarwin/kernelcache=$(rootpath :sbsa_kc)",
        "--esp NeoDarwin/ramdisk=$(rootpath //images:pam_session_root)",
        "--esp NeoDarwin/trustcache=$(rootpath //images:pam_session_root_trustcache)",
        "--until-lines",
        "--absent 'ndamfi: refused'",
        "--send-after 'login: ' 'test\\n'",
        "--send-after 'Password:' 'neodarwin\\n'",
        "--send-after 'test@localhost ~ % ' 'echo path=$$PATH\\n'",
        "--send-after 'test@localhost ~ % ' 'passwd\\n'",
        "--send-after 'Old password:' 'neodarwin\\n'",
        "--send-after 'New password:' 'darwin26\\n'",
        "--send-after 'Retype new password:' 'darwin26\\n'",
        "--send-after 'test@localhost ~ % ' 'echo passwd-status=$$?; exit\\n'",
        "--send-after 'login: ' 'test\\n'",
        "--send-after 'Password:' 'neodarwin\\n'",
