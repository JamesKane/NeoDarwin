# XNU kernel builds (docs/kernel/arm64-sbsa-bringup.md, docs/repository.md §3).
load("//rules:kc.bzl", "kext_collection")
load("//rules:xnu.bzl", "libfirehose_kernel", "nd_build_sdk", "xnu_headers", "xnu_kernel")

package(default_visibility = ["//visibility:public"])

DARWIN_VERSION = "25.0.0"  # macOS 26.0 release set; see upstream.lock

filegroup(
    name = "sdk_shims",
    srcs = glob(["sdk/**"]),
)

# NeoDarwin additions to the host SDK: availability.pl, the kernel firehose
# header, and the shims under kernel/sdk.
nd_build_sdk(
    name = "build_sdk",
    availability_versions = "@apple_availability_versions//:all",
    libdispatch = "@apple_libdispatch//:all",
    shim_root = "sdk",
    shims = ":sdk_shims",
)

xnu_headers(
    name = "headers",
    darwin_version = DARWIN_VERSION,
    sdk = ":build_sdk",
    srcs = "@apple_xnu//:all",
)

libfirehose_kernel(
    name = "firehose_kernel",
    headers = ":headers",
    libdispatch = "@apple_libdispatch//:all",
    sdk = ":build_sdk",
)

# Apple's public VMAPPLE configuration with no NeoDarwin patches. Every source
# compiles; the link fails on symbols Apple ships only in closed archives.
# The report lists them: this is the gap Phase 1 drives to zero.
xnu_kernel(
    name = "vmapple_release_gaps",
    darwin_version = DARWIN_VERSION,
    firehose = ":firehose_kernel",
    link_gap_report = True,
    machine_config = "VMAPPLE",
    sdk = ":build_sdk",
    srcs = "@apple_xnu//:all",
)

load("@rules_shell//shell:sh_test.bzl", "sh_test")

# The gap may only shrink. Heavy (a full kernel build), so it runs in the
# kernel CI job (ci/kernel.sh), not in the default `bazel test //...`.
sh_test(
    name = "vmapple_link_gap_ratchet",
    size = "small",
    srcs = ["//tools/xnu:gap_ratchet.sh"],
    args = [
        "$(rootpath :vmapple_release_gaps)",
        "$(rootpath link_gaps/vmapple_release.txt)",
    ],
    data = [
        "link_gaps/vmapple_release.txt",
        ":vmapple_release_gaps",
    ],
    tags = ["manual", "kernel"],
)

# ---------------------------------------------------------------------------
# SBSA: NeoDarwin's generic Arm board config (docs/kernel/arm64-sbsa-bringup.md
# §2.3). Plain arm64 (no Apple PAC ABI) and no BTI, per the bring-up design.

SBSA_PATCHES = [
    "patches/0001-config-build-arm64-machine-code-and-pmap-from-source.patch",
    "patches/0002-sbsa-board-config.patch",
    "patches/0003-osfmk-generic-arm64-guards.patch",
    "patches/0004-config-sbsa-exports.patch",
    "patches/0005-bsd-neodarwin-trustcache-runtime.patch",
    "patches/0006-sbsa-no-apple-implementation-registers.patch",
    "patches/0007-kalloc-enforce-per-size-class-zone-limit.patch",
    "patches/0008-libkern-build-ndcrypto.patch",
]

# NeoDarwin-owned kernel sources added to the xnu tree before patching.
SBSA_OVERLAYS = {
    "//kernel/neodarwin/crypto:kernel_srcs": "libkern/ndcrypto",
    "@freebsd_crypto//:all": "libkern/ndcrypto/freebsd",
}

libfirehose_kernel(
    name = "firehose_kernel_arm64",
    arch = "arm64",
    headers = ":headers",
    libdispatch = "@apple_libdispatch//:all",
    sdk = ":build_sdk",
)

xnu_kernel(
    name = "sbsa_release",
    darwin_version = DARWIN_VERSION,
    firehose = ":firehose_kernel_arm64",
    machine_config = "SBSA",
    overlays = SBSA_OVERLAYS,
    make_vars = [
        "ARCH_STRING_FOR_CURRENT_MACHINE_CONFIG=arm64",
        "BTI_BUILD=0",
    ],
    patches = SBSA_PATCHES,
    sdk = ":build_sdk",
    srcs = "@apple_xnu//:all",
)

# The kernel is a fully linked arm64 Mach-O with no undefined symbols.
sh_test(
    name = "sbsa_kernel_test",
    size = "small",
    srcs = ["//tools/xnu:check_kernel.sh"],
    args = [
        "$(rootpaths :sbsa_release)",
        "arm64",
    ],
    data = [":sbsa_release"],
    tags = ["manual", "kernel"],
)

# Apple-ISA audit: no implementation-defined system registers, HVC, AMX or GXF
# in the SBSA kernel. The baseline is empty and must stay empty.
sh_test(
    name = "sbsa_isa_audit",
    size = "small",
    srcs = ["//tools/xnu:isa_audit.sh"],
    args = [
        "$(rootpaths :sbsa_release)",
        "$(rootpath isa_audit/sbsa_release.txt)",
    ],
    data = [
        "isa_audit/sbsa_release.txt",
        ":sbsa_release",
    ],
    tags = ["manual", "kernel"],
)

# ---------------------------------------------------------------------------
# Boot kernel collection: the SBSA kernel alone in an MH_FILESET, the format
# neoboot loads (arm64-sbsa-bringup.md §2.1). The kernel applies the chained
# fixups itself at arm_init; kcheck verifies them and round-trips the kernel.
kext_collection(
    name = "sbsa_kc",
    kernel = ":sbsa_release",
    out = "kernelcache.release.sbsa",
)

sh_test(
    name = "sbsa_kc_check",
    size = "small",
    srcs = ["//tools/kcheck:kcheck_test.sh"],
    args = [
        "$(rootpath //tools/kcheck)",
        "$(rootpath :sbsa_kc)",
        "$(rootpaths :sbsa_release)",
    ],
    data = [
        ":sbsa_kc",
        ":sbsa_release",
        "//tools/kcheck",
    ],
    tags = ["manual", "kernel"],
)

# P1-03: neoboot boots the collection on QEMU virt and the kernel reaches the
# listed serial lines. The CPU must implement Armv8.4's range TLB
# invalidation (the kernel is built for armv8.4-a); QEMU's cortex-a76 and
# neoverse-v1 models do not, so this uses neoverse-n2.
sh_test(
    name = "sbsa_boot_test",
    size = "medium",
    srcs = ["//tools/efi:qemu_efi_test.sh"],
    args = [
        "--cpu neoverse-n2",
        "--mem 2G",
        "--esp NeoDarwin/kernelcache=$(rootpath :sbsa_kc)",
        "--until-lines",
        "$(rootpath //boot/neoboot)",
        "120",
        "'Darwin Kernel Version 25.0.0'",
        "'iBoot version: neoboot-0.1'",
        # Printed after ndcrypto has installed the crypto table and the kernel PRNG (P1-13).
        "'lockdown_mode: lockdown mode in nvram is off'",
    ],
    data = [
        ":sbsa_kc",
        "//boot/neoboot",
    ],
    tags = ["manual", "kernel", "qemu"],
)
