# rtadvd (docs/kernel/network.md, "rtadvd"): two guests on a private
# Ethernet segment (the harness's --link-net and --peer-net: QEMU dgram
# netdevs over Unix sockets in the run's directory, nothing on the host's
# network). The peer is the router, with one NIC, en0, on the segment (a
# second, user-mode NIC would make the names depend on which driver
# instance attaches first). It waits for en0's link-local address, turns on
# forwarding, puts en0 in router mode (xnu's IPV6_ROUTER_MODE_EXCLUSIVE: no
# RAs accepted, no SLAAC addresses, as Apple's run-rtadvd does), gives it
# 2001:db8:1::1/64 and runs rtadvd on it, advertising the prefix (learned
# from en0's addresses), a DNS server (RDNSS) and a search domain (DNSSL),
# every 3 to 4 s. This guest is the host: its one NIC, en0, is on the
# segment, and netconfigd's IPv6 autoconfiguration takes the prefix and the
# router from the advertisements. It checks its SLAAC address, the router
# in ndp -rn and the default route, pings the router, and solicits a router
# with rtsol (a solicited RA). The router pings the host's SLAAC address
# and waits (up to 6 min) for the host's solicitation in rtadvd's log
# (the router's own rtsold solicits too, so the host's is picked out by its
# link-local address); it prints the RDNSS and
# DNSSL options' lengths in 8-octet units (3 each: 8 octets of header and
# one address; header and "example.test" encoded and padded).
RTADVD_ROUTER_MAC = "52:54:00:00:01:01"

RTADVD_HOST_MAC = "52:54:00:00:01:02"

RTADVD_ROUTER_LL = "fe80::5054:ff:fe00:101"

RTADVD_HOST_LL = "fe80::5054:ff:fe00:102"

# As ifconfig, ndp and ping6 print it (KAME's style: the zero group isn't
# compressed to ::).
RTADVD_HOST_ADDR = "2001:db8:1:0:5054:ff:fe00:102"

sh_test(
    name = "sbsa_rtadvd_test",
    size = "large",
    srcs = ["//tools/efi:qemu_efi_test.sh"],
    args = [
        "--cpu neoverse-n2",
        "--mem 2G",
        "--esp NeoDarwin/kernelcache=$(rootpath :sbsa_kc)",
        "--esp NeoDarwin/ramdisk=$(rootpath //images:pam_session_root)",
        "--esp NeoDarwin/trustcache=$(rootpath //images:pam_session_root_trustcache)",
        "--link-net virtio-net-pci,disable-legacy=on,mac=" + RTADVD_HOST_MAC,
        "--peer-net virtio-net-pci,disable-legacy=on,mac=" + RTADVD_ROUTER_MAC,
        "--until-lines",
        "--absent 'NeoDarwinInterfaceNamer: cannot'",
        "--absent 'is not a receive buffer'",
        # The router.
        "--peer-send-after 'login: ' 'root\\n'",
        "--peer-send-after 'root@localhost ~ # ' 'until case $$(ifconfig en0 inet6) in *" + RTADVD_ROUTER_LL + "*) true;; *) false;; esac; do sleep 1; done; " +
        "sysctl -w net.inet6.ip6.forwarding=1; ifconfig en0 inet6 routermode enabled; " +
        "ifconfig en0 inet6 2001:db8:1::1 prefixlen 64; ifconfig en0 inet6; ifconfig en0 inet6 routermode\\n'",
        "--peer-send-after 'root@localhost ~ # ' 'echo en0:rdnss=\\\"2001:db8:1::1\\\":dnssl=\\\"example.test\\\":rltime#1800:maxinterval#4:mininterval#3: > /tmp/rtadvd.conf; " +
        "rtadvd -f -D -c /tmp/rtadvd.conf en0 > /tmp/rtadvd.log 2>&1 & sleep 1; echo rtadvd-started-$$((6*7))\\n'",
        "--peer-send-after 'rtadvd-started-42' 'for i in {1..120}; do ping6 -c 1 " + RTADVD_HOST_ADDR + " > /tmp/p6.txt 2>&1 && break; sleep 1; done; cat /tmp/p6.txt\\n'",
        "--peer-send-after 'root@localhost ~ # ' 'for i in {1..360}; do case $$(cat /tmp/rtadvd.log) in *\"RS received from " + RTADVD_HOST_LL + " on en0\"*) break;; esac; sleep 1; done; " +
        "a=; b=; c=; while read -r l; do case $$l in *nd_opt_dnss_len*) [ -z \"$$a\" ] && echo \"$$l\"; a=1;; *nd_opt_dnssl_len*) [ -z \"$$b\" ] && echo \"$$l\"; b=1;; " +
        "*\"RS received from " + RTADVD_HOST_LL + "\"*) [ -z \"$$c\" ] && echo \"$$l\"; c=1;; esac; done < /tmp/rtadvd.log; ndp -an\\n'",
        "--peer-line 'net.inet6.ip6.forwarding: 0 -> 1'",
        "--peer-line 'inet6 2001:db8:1::1 prefixlen 64'",
        "--peer-line 'rtadvd-started-42'",
        "--peer-line '16 bytes from " + RTADVD_HOST_ADDR + ", icmp_seq=0 hlim=64 '",
        "--peer-line '<make_packet>: nd_opt_dnss_len = 3'",
        "--peer-line '<make_packet>: nd_opt_dnssl_len = 3'",
        "--peer-line '<rs_input> RS received from " + RTADVD_HOST_LL + " on en0'",
        # The host.
        "--send-after 'login: ' 'root\\n'",
        "--send-after 'root@localhost ~ # ' 'for i in {1..180}; do case $$(ifconfig en0 inet6; netstat -rn -f inet6) in " +
        "*\"" + RTADVD_HOST_ADDR + " \"*default*" + RTADVD_ROUTER_LL + "*) break;; esac; sleep 1; done; cat /var/log/netconfigd.log\\n'",
        "--send-after 'root@localhost ~ # ' 'ifconfig en0 inet6; ndp -rn; ndp -an; netstat -rn -f inet6; ping6 -c 2 2001:db8:1::1\\n'",
        "--send-after 'root@localhost ~ # ' 'rtsol en0; echo rtsol-$$?-$$((6*7)); cat /var/run/resolv.conf\\n'",
        "$(rootpath //boot/neoboot)",
        "420",
        "'netconfigd: en0: IPv6 autoconfiguration (link-local address started, router advertisements accepted)'",
        "'inet6 " + RTADVD_HOST_LL + "%en0 prefixlen 64 scopeid 0x'",
        "'inet6 " + RTADVD_HOST_ADDR + " prefixlen 64 autoconf'",
        "'" + RTADVD_ROUTER_LL + "%en0 if=en0'",
        "'default                                 " + RTADVD_ROUTER_LL + "%en0'",
        "'2001:db8:1::/64                         link#'",
        "'16 bytes from 2001:db8:1::1, icmp_seq=1 hlim=64 '",
        "'rtsol-0-42'",
        # RDNSS and DNSSL, through rtsold and resolvconf ("IPv6 DNS: RDNSS
        # and DHCPv6").
        "'nameserver 2001:db8:1::1'",
        "'search example.test'",
    ],
    data = [
        ":sbsa_kc",
        "//boot/neoboot",
        "//images:pam_session_root",
        "//images:pam_session_root_trustcache",
    ],
    tags = ["manual", "kernel", "qemu"],
)

# P4-24 (docs/base/pf-ntp.md): pf with OpenBSD 4.3's pfctl, and the NTP
# client (Apple's sntp under com.neodarwin.sntp). After the lease: pf is
# off at boot (/dev/pf, `pfctl -s info`); Remote Login and the run's key;
# com.apple.pfctl loads macOS's /etc/pf.conf (its anchors) and enables pf
# with a reference, which `-s References` lists; the host logs in over ssh
# under that ruleset. A rule appended to the ruleset blocks the guest's
# ping to the gateway; `pfctl -d` disables pf and the ping passes. Then the
# guest's clock is set to 2000, /etc/ntp.conf names the host's SNTP
# responder (tests/qemu/sntp: 127.0.0.1 on the host, a free UDP port, which
# the guest reaches as 10.0.2.2 through slirp; it stops with the run), the
# job is loaded and steps the clock, and the host checks over ssh that the
# guest's clock agrees with its own.
PF_NTP_SESSION = [
    "--hostfwd 22",
    "--host-setup 'ssh-keygen -q -t ed25519 -N \"\" -C nd-pf-test -f id_ed25519'",
    "--host-setup 'perl \"$$TEST_SRCDIR/$(rlocationpath //tests/qemu/sntp:sntp_responder.pl)\" \"$$ND_HOST_DIR\" 900 " +
    "> ntp.log 2>&1 < /dev/null & for i in $$(seq 100); do [ -s ntp_port ] && exit 0; sleep 0.1; done; exit 1'",
    "--send-after 'login: ' 'root\\n'",
    "--send-after 'root@localhost ~ # ' 'until [ -s /var/run/resolv.conf ]; do sleep 1; done; echo lease-$$((6*7))\\n'",
    "--send-after 'lease-42' 'ls -l /dev/pf; pfctl -s info\\n'",
    "--send-after 'root@localhost ~ # ' 'launchctl load -w /System/Library/LaunchDaemons/ssh.plist; mkdir -p /Users/test/.ssh && " +
    "echo \"{hostfile:id_ed25519.pub}\" > /Users/test/.ssh/authorized_keys && echo key-$$((6*7))\\n'",
    "--send-after 'key-42' 'launchctl load -w /System/Library/LaunchDaemons/com.apple.pfctl.plist; sleep 2; cat /var/log/pfctl.log; " +
    "pfctl -s info; pfctl -s References; pfctl -s rules; pfctl -s nat; pfctl -s dummynet; echo pf-on-$$((6*7))\\n'",
    "--host-cmd-after 'pf-on-42' '" + NET_SSH + " uname -a'",
    "--send-after 'host: exit' 'cp /etc/pf.conf /tmp/pf.conf; echo \"table <nd_test> persist { 192.0.2.1 }\" >> /tmp/pf.conf; " +
    "echo \"block drop out quick inet proto icmp from any to 10.0.2.2\" >> /tmp/pf.conf; " +
    "echo \"pass in quick on en0 inet proto tcp from any to any port 22 keep state\" >> /tmp/pf.conf; " +
    "pfctl -f /tmp/pf.conf; pfctl -s rules; ping -c 2 -t 4 10.0.2.2; case $$? in 0) r=passed;; *) r=blocked;; esac; echo ping-$$r-$$((6*7))\\n'",
    "--host-cmd-after 'ping-blocked-42' '" + NET_SSH + " uname -n'",
    "--send-after 'host: exit' 'pfctl -s states; pfctl -t nd_test -T add 192.0.2.2; pfctl -t nd_test -T show; pfctl -s Tables; echo tables-$$((6*7))\\n'",
    "--send-after 'tables-42' 'pfctl -d; pfctl -s info; ping -c 2 10.0.2.2; case $$? in 0) r=passed;; *) r=blocked;; esac; echo ping-$$r-$$((6*7))\\n'",
    "--send-after 'ping-passed-42' 'date 010100002000 > /dev/null; echo year-$$(date +%Y); echo \"server 10.0.2.2:{hostfile:ntp_port}\" > /etc/ntp.conf; " +
    "launchctl load -w /System/Library/LaunchDaemons/com.neodarwin.sntp.plist; " +
    "for i in {1..60}; do case $$(date +%Y) in 2000) sleep 1;; *) break;; esac; done; cat /var/log/sntp.log; echo synced-$$((6*7))\\n'",
    "--host-cmd-after 'synced-42' 'g=$$(" + NET_SSH + " date +%s); h=$$(date +%s); d=$$((h - g)); echo \"clock: guest $$g, host $$h\"; " +
    "[ $${d#-} -le 10 ] && echo clock-ok; cat ntp.log'",
    "--send-after 'host: exit' 'cat /var/log/sshd.log\\n'",
]

PF_NTP_LINES = [
    "'lease-42'",
    "'Status: Disabled'",
    "'No ALTQ support in kernel'",
    "'pf enabled'",
    "'Token : '",
    "'Status: Enabled for 0 days '",
    "'scrub-anchor \"com.apple/*\" all fragment reassemble'",
    "'anchor \"com.apple/*\" all'",
    "'nat-anchor \"com.apple/*\" all'",
    "'rdr-anchor \"com.apple/*\" all'",
