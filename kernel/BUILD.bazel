# The kernel is a fully linked arm64 Mach-O with no undefined symbols.
sh_test(
    name = "sbsa_kernel_test",
    size = "small",
    srcs = ["//tools/xnu:check_kernel.sh"],
    args = [
        "$(rootpaths :sbsa_release)",
        "arm64",
    ],
    data = [":sbsa_release"],
    tags = ["manual", "kernel"],
)

# ISA audit: no implementation-defined system registers, HVC, AMX or GXF in
# the SBSA kernel, and no instruction past the Armv8.2 baseline (P1-17): the
# ISA both the Q8B's Cortex-X1C/A78C and QEMU's cortex-a76 implement, v8.2
# with RCpc, dot product, AES, SHA-1/SHA-2 and FP16. The baseline file lists
# what is allowed by name, each entry guarded at run time; nothing may be
# added to it.
sh_test(
    name = "sbsa_isa_audit",
    size = "small",
    srcs = ["//tools/xnu:isa_audit.sh"],
    args = [
        "--mattr +v8.2a,+rcpc,+dotprod,+aes,+sha2,+fullfp16",
        "$(rootpaths :sbsa_release)",
        "$(rootpath isa_audit/sbsa_release.txt)",
    ],
    data = [
        "isa_audit/sbsa_release.txt",
        ":sbsa_release",
    ],
    tags = ["manual", "kernel"],
)

# ---------------------------------------------------------------------------
# Boot kernel collection: the SBSA kernel alone in an MH_FILESET, the format
# neoboot loads (arm64-sbsa-bringup.md §2.1). The kernel applies the chained
# fixups itself at arm_init; kcheck verifies them and round-trips the kernel.
kext_collection(
    name = "sbsa_kc",
    kernel = ":sbsa_release",
    out = "kernelcache.release.sbsa",
)

sh_test(
    name = "sbsa_kc_check",
    size = "small",
    srcs = ["//tools/kcheck:kcheck_test.sh"],
    args = [
        "$(rootpath //tools/kcheck)",
        "$(rootpath :sbsa_kc)",
        "$(rootpaths :sbsa_release)",
    ],
    data = [
        ":sbsa_kc",
        ":sbsa_release",
        "//tools/kcheck",
    ],
    tags = ["manual", "kernel"],
)

# P3-01: the same kernel with zfs.kext (//kexts/zfs), the first collection
# with a kext. kcgen moves the kernel's segments apart around the kext's
# (split-segment info, patch 0040), resolves its imports against the
# kernel's exports (IOStorageFamily's since patch 0039) and enters it, xnu's
# System.kext pseudo-kexts and IOStorageFamily as codeless kexts in
# __PRELINK_INFO (docs/architecture/filesystems.md §7).
kext_collection(
    name = "sbsa_zfs_kc",
    codeless = {"//kernel/neodarwin/storage:IOStorageFamily.plist": "/System/Library/Extensions/IOStorageFamily.kext"},
    kernel = ":sbsa_release",
    kernel_components = "@apple_xnu//:all",
    kernel_version = DARWIN_VERSION,
    kexts = ["//kexts/zfs"],
    out = "kernelcache.zfs.release.sbsa",
)

sh_test(
    name = "sbsa_zfs_kc_check",
    size = "small",
    srcs = ["//tools/kcheck:kcheck_kexts_test.sh"],
    args = [
        "$(rootpath //tools/kcheck)",
        "$(rootpath :sbsa_zfs_kc)",
    ],
    data = [
        ":sbsa_zfs_kc",
        "//tools/kcheck",
    ],
    tags = ["manual", "kernel"],
)

# P0-10's kext_swift trial (docs/architecture/language-policy.md §3): the
# kernel with NDSwiftTrial.kext (//kexts/swift_trial), Embedded Swift logic
# behind a C++ IOService. A collection of its own, so no other test boots it.
kext_collection(
    name = "sbsa_swift_trial_kc",
    kernel = ":sbsa_release",
    kernel_components = "@apple_xnu//:all",
    kernel_version = DARWIN_VERSION,
    kexts = ["//kexts/swift_trial"],
    out = "kernelcache.swift_trial.release.sbsa",
    tags = ["manual"],
)

sh_test(
    name = "sbsa_swift_trial_kc_check",
    size = "small",
    srcs = ["//tools/kcheck:kcheck_kexts_test.sh"],
    args = [
        "$(rootpath //tools/kcheck)",
        "$(rootpath :sbsa_swift_trial_kc)",
    ],
    data = [
        ":sbsa_swift_trial_kc",
        "//tools/kcheck",
    ],
    tags = ["manual", "kernel"],
)

# The kernel matches the kext's IOResources personality at boot and its
# C++ start() calls the Swift: a well-formed table walks (0) and a
# corrupted one fails its checksum (-2), through typed throws.
qemu_test(
    name = "sbsa_swift_trial_test",
    cpu = "cortex-a76",
    mem = "2G",
    esp = {
        ":sbsa_swift_trial_kc": "NeoDarwin/kernelcache",
        "//images:pid1_root": "NeoDarwin/ramdisk",
        "//images:pid1_root_trustcache": "NeoDarwin/trustcache",
    },
    timeout_s = 120,
    expect = [
        "NDSwiftTrial: starting; calling Embedded Swift",
        "NDSwiftTrial: table bytes 20",
        "NDSwiftTrial: records 4",
        "NDSwiftTrial: payload bytes 6",
        "NDSwiftTrial: kind 1 records 2",
        "NDSwiftTrial: well-formed table: Swift returned 0",
        "NDSwiftTrial: bad checksum, expected 2501889715",
        "NDSwiftTrial: corrupted table: Swift returned -2",
        "NDSwiftTrial: kernel KPIs from Swift: returned 42, counter 42",
        "pid1: all checks passed",
    ],
    extra_args = ["--absent 'panic('"],
    tags = ["manual", "kernel", "qemu"],
)

# P1-03: neoboot boots the collection on QEMU virt and the kernel reaches the
# listed serial lines, on neoverse-n2 (Armv9.0). The kernel's baseline is
# Armv8.2 since P1-17; the sbsa_a76_* tests boot it on cortex-a76.
qemu_test(
    name = "sbsa_boot_test",
    cpu = "neoverse-n2",
    mem = "2G",
    esp = {
        ":sbsa_kc": "NeoDarwin/kernelcache",
        "//images:pid1_root": "NeoDarwin/ramdisk",
        "//images:pid1_root_trustcache": "NeoDarwin/trustcache",
    },
    timeout_s = 120,
    expect = [
        "Darwin Kernel Version 25.0.0",
        "iBoot version: neoboot-0.1",
        # Printed after ndcrypto has installed the crypto table and the kernel PRNG (P1-13).
        "lockdown_mode: lockdown mode in nvram is off",
        # After ndamfi has registered the AMFI and Image4 interfaces (P1-14),
        # the ramdisk's static trust cache from neoboot, and code signing
        # enforced with it (P1-15): PID 1 is listed.
        "neoboot: trust cache: ",
        "ndamfi: code-signing enforcement on (a static trust cache from the loader)",
        "ndamfi: static trust cache ",
        "loaded external trust cache module: 0",
        # BSD initialisation, reached through the platform expert (P1-06).
        "MAC Framework successfully initialized",
        # Past bsd_init's pthread check, with libpthread's kern/ built in (P1-16).
        "ifnet_attach: All kernel threads created for interface lo0",
        # Rooted on HFS+ over the ramdisk (P1-08a), with PID 1 checking
        # syscalls, VM, Mach IPC and the calendar from userland (P1-07).
        "BSD root: md0",
        "hfs: mounted NeoDarwin on device",
        "pid1: hello from userland: PID 1 on /dev/console",
        "pid1: mach: message round trip through mach_msg2",
        "pid1: all checks passed",
        # ACPICA in the kernel, publishing IOACPIPlatformDevice nubs from
        # QEMU's DSDT (P1-09, docs/kernel/acpi.md): the PCI host bridge with
        # its windows, _CBA and _PRT read through the nub, the UART and the
        # last virtio-mmio slot with their _CRS registers and GIC INTIDs.
        "NeoDarwinACPIPlatform: ACPICA 20260408; 9 tables (FACP DSDT APIC PPTT GTDT MCFG SPCR DBG2 IORT); 44 devices published, 3 more in IOACPIPlane",
        "NeoDarwinACPIPlatform: \\_SB.PCI0 PNP0A08 (PNP0A03) uid 0 bus 0-255 memory 0x10000000+0x2eff0000 io 0x3eff0000+0x10000 memory 0x8000000000+0x8000000000",
        "NeoDarwinACPIPlatform: \\_SB.PCI0: PCI segment 0, bus 0, ECAM 0x4010000000 (_CBA); _PRT 128 routes",
        "NeoDarwinACPIPlatform: \\_SB.COM0 ARMH0011 uid 0 mem 0x9000000+0x1000 irq 33",
        "NeoDarwinACPIPlatform: \\_SB.VR31 LNRO0005 uid 31 mem 0xa003e00+0x200 irq 79",
        "NeoDarwinACPIPlatform: \\_SB.GED ACPI0013 uid GED irq 41 edge",
    ],
    tags = ["manual", "kernel", "qemu"],
)

# P1-05's exit: the session boot on QEMU virt with a Secure world, TF-A at
# EL3 and the GIC's two security states (GICD_CTLR.DS == 0), as on SBSA
# boards (docs/kernel/qemu-secure.md). Group 0 is Secure there: Non-secure
# writes to its group and enable bits are ignored, so the timer ticks only on
# Group 1, as an IRQ. neoboot chooses Group 1 itself from GICD_CTLR (no
# boot.cfg), and a timed 1 s sleep in zsh proves the ticks.
sh_test(
    name = "sbsa_secure_boot_test",
    size = "medium",
    srcs = ["//tools/efi:qemu_efi_test.sh"],
    args = [
        "--machine virt-secure",
        "--firmware $(rootpath //third_party/qemu_firmware:virt_secure_flash)",
        "--cpu neoverse-n2",
        "--mem 2G",
        "--esp NeoDarwin/kernelcache=$(rootpath :sbsa_kc)",
        "--esp NeoDarwin/ramdisk=$(rootpath //images:session_root)",
        "--esp NeoDarwin/trustcache=$(rootpath //images:session_root_trustcache)",
        "--until-lines",
        "--send-after 'login: ' 'root\\n'",
        "--send-after 'root@localhost ~ # ' 'zmodload zsh/datetime && t=$$EPOCHREALTIME && sleep 1 && echo slept-$$(( EPOCHREALTIME - t >= 1 ))\\n'",
        "$(rootpath //boot/neoboot)",
        "180",
        "'NOTICE:  BL31: v2.15.0(release)'",
        "'DS=0 (two security states; Group 0 is Secure); timer PPI 27 on Group 1 (IRQ)'",
        "'NeoDarwinGICv3: timer PPI 27 on Group 1 (IRQ); '",
        "'hfs: mounted NeoDarwin on device'",
        "'com.apple.launchd'",
        "'slept-1'",
        # ACPICA and the ACPI nubs under TF-A (P1-09): the same DSDT.
        "'NeoDarwinACPIPlatform: ACPICA 20260408; 9 tables (FACP DSDT APIC PPTT GTDT MCFG SPCR DBG2 IORT); 44 devices published, 3 more in IOACPIPlane'",
        "'NeoDarwinACPIPlatform: \\_SB.PCI0: PCI segment 0, bus 0, ECAM 0x4010000000 (_CBA); _PRT 128 routes'",
    ],
    data = [
        ":sbsa_kc",
        "//boot/neoboot",
        "//images:session_root",
        "//images:session_root_trustcache",
        "//third_party/qemu_firmware:virt_secure_flash",
    ],
    tags = ["manual", "kernel", "qemu"],
)

# P1-09 checkpoint 2 (docs/kernel/pci.md): IOPCIFamily enumerates QEMU virt's
# PCIe through NeoDarwinPCIHostBridge (ECAM, _CRS windows, _OSC, firmware BARs
# kept, 64-bit ones above 4 GiB too) with a transitional virtio-blk and an
# NVMe controller on the root bus, a PCIe root port with a modern virtio-blk
# behind it on bus 1, and another with a second edu device on bus 2. INTx:
# _PRT and link devices give each device its GSIV. QEMU's edu device raises
# INTA, which reaches its handler through the GIC SPI NeoDarwinGICv3
# configured; behind the second root port it shares the port's own line.
PCI_DEVICES = [
    "--drive disk0=16M",
    "--device virtio-blk-pci,drive=disk0",
    "--drive nvm0=16M",
    "--device nvme,serial=nd0,drive=nvm0",
    "--device edu",
    "--device pcie-root-port,id=rp0,chassis=1",
    "--drive disk1=16M",
    "--device virtio-blk-pci,drive=disk1,bus=rp0",
    "--device pcie-root-port,id=rp1,chassis=2",
    "--device edu,bus=rp1",
]

PCI_LINES = [
    "'NeoDarwinPCIHostBridge: \\_SB.PCI0: segment 0, buses 0-255, ECAM 0x4010000000 (_CBA); mem 0x10000000+0x2eff0000, io 0x1000+0xf000 at 0x3eff1000, mem 0x8000000000+0x8000000000'",
    # virtio-blk, transitional on the root bus: its I/O BAR is MMIO in the
    # host bridge's I/O window at 0x3eff0000.
    "'1af4:1001 class 010000 bar0 io 0x3eff1'",
    # NVMe: EDK2 put its 64-bit BAR above 4 GiB, and it stays there.
    "'0000:00:03.0 1b36:0010 class 010802 bar0 mem 0x80'",
    # Each device's MSI or MSI-X capability: NVMe's table has 65 entries.
    "' INTA gsiv 38 msi-x 65'",
    "'1234:11e8 class 00ff00 bar0 mem 0x10400000+0x100000 INTA gsiv 35 msi 1'",
    "'0000:00:05.0 1b36:000c class 060400 bridge to buses 1-1'",
    # virtio-blk, modern behind the root port: INTA swizzled to the port's.
    "'0000:01:00.0 1af4:1042 class 010000'",
    "'NeoDarwinPCIEduTest: 00:04.0: edu 0x010000ed: INTA on GSIV 35 (level) reached its handler in '",
    # Behind the second root port, INTA swizzles to the port's INTA (slot 6,
    # L002, GSIV 37), which the port's own driver registers too.
    "'0000:00:06.0 1b36:000c class 060400 bridge to buses 2-2'",
    "'NeoDarwinGICv3: SPI 37: shared for '",
    "'NeoDarwinPCIEduTest: 02:00.0: edu 0x010000ed: INTA on GSIV 37 (level) reached its handler in '",
    "'NeoDarwinPCIHostBridge: \\_SB.PCI0: segment 0: 10 devices (2 PCI-to-PCI bridges) on buses 0-2, 9 with INTx, 9 capable of MSI or MSI-X'",
    # P1-10 (docs/kernel/storage.md): NeoDarwinVirtioBlock drives both blank
    # disks, the transitional one through its modern interface.
    "'NeoDarwinVirtioBlock: 00:02.0: virtio-blk 1af4:1001: 32768 512-byte blocks (16 MiB); features 0x100000a44; queue 256, 8 slots of 30 segments; '",
    "'NeoDarwinVirtioBlock: 01:00.0: virtio-blk 1af4:1042: 32768 512-byte blocks (16 MiB); '",
    # P1-10 checkpoint 2: NeoDarwinNVMeController drives the blank NVMe disk.
    "'NeoDarwinNVMeController: 00:03.0: NVMe 1.4, 1b36:0010, model \"QEMU NVMe Ctrl\", serial \"nd0\", firmware '",
    "'NeoDarwinNVMeNamespace: 00:03.0: namespace 1: 32768 512-byte blocks (16 MiB); read-write'",
]

# P1-09 checkpoint 3 (docs/kernel/gic-its.md): MSI and MSI-X through the
# GIC ITS. The ITS from the MADT, its tables and collections; LPIs on the
# redistributors; each device's requester ID through the IORT to a DeviceID.
# edu's MSI (after its INTA) and the NVMe controller's MSI-X vectors (P1-10's
# NeoDarwinNVMeController: the admin queue on vector 0, an I/O queue per
# CPU on the others, one LPI each) reach their handlers. The LPI numbers
# depend on the order drivers start, so the lines match around them.
MSI_LINES = [
    "'NeoDarwinPCIMSI: ITS 0 at 0x8080000 (IIDR 0x0000043b): 16 DeviceID bits, 16 EventID bits, ITT entries 12 bytes, '",
