# Packet capture (docs/kernel/network.md, "libpcap and tcpdump"), its own
# run so the net tests keep their time: log in as root and wait for en0's
# DHCP address, then tcpdump sees the guest's own ping to the gateway on en0 and
# lists en0 (-D); /dev/bpf0 is root's, mode 0600, and test's tcpdump is
# refused it; traceroute's TCP probes (-P tcp) get their answer through
# libpcap. They go to 10.0.2.2 at this run's --hostfwd port (no sshd needs
# to listen behind it): slirp passes a TCP connection to the gateway to the
# host's loopback, where QEMU's own forward listens (a port no other
# program has), and answers the SYN once it connects.
NET_CAPTURE = [
    "--hostfwd 22",
    "--host-setup 'echo $$ND_HOSTFWD_PORT > hostfwd_port'",
    "--send-after 'login: ' 'root\\n'",
    "--send-after 'root@localhost ~ # ' 'until case $$(ifconfig en0) in *\"inet 10.0.2.15 \"*) true;; *) false;; esac; do sleep 1; done; " +
    "echo lease-$$((6*7))\\n'",
    "--send-after 'lease-42' 'tcpdump -n -c 2 -i en0 icmp > /tmp/td.txt 2> /tmp/td.err & sleep 3; " +
    "ping -c 2 10.0.2.2 > /dev/null; sleep 1; kill %1 2> /dev/null; wait; cat /tmp/td.err /tmp/td.txt; tcpdump -D\\n'",
    "--send-after 'root@localhost ~ # ' 'ls -l /dev/bpf0; su test -c \"tcpdump -n -c 1 -i en0\" > /tmp/tdu.txt 2>&1; " +
    "case $$(cat /tmp/tdu.txt) in *\"/dev/bpf0: Permission denied\"*) echo bpf-denied-$$((6*7));; *) cat /tmp/tdu.txt;; esac\\n'",
    "--send-after 'root@localhost ~ # ' 'traceroute -n -e -P tcp -p {hostfile:hostfwd_port} -m 3 -q 1 10.0.2.2 > /tmp/trt.txt 2>&1; " +
    "case $$(cat /tmp/trt.txt) in *\" 1  10.0.2.2 \"*) echo traceroute-tcp-$$((6*7));; esac; cat /tmp/trt.txt\\n'",
]

NET_CAPTURE_LINES = [
    "'lease-42'",
    "'listening on en0, link-type EN10MB (Ethernet), '",
    "' IP 10.0.2.15 > 10.0.2.2: ICMP echo request, id '",
    "' IP 10.0.2.2 > 10.0.2.15: ICMP echo reply, id '",
    "'2 packets captured'",
    "'1.en0 [Up, Running'",
    "'crw-------  1 root  wheel '",
    "'bpf-denied-42'",
    "'traceroute-tcp-42'",
]

