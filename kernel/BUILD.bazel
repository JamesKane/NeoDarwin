        "--esp NeoDarwin/trustcache=$(rootpath //images:session_root_trustcache)",
        "--esp NeoDarwin/boot.cfg=$(rootpath //boot/neoboot:testdata/nvme-ro.cfg)",
        "--drive nvm0=$(rootpath //images:data_disk)",
        "--device nvme,serial=nd1,drive=nvm0",
        # Rooted on the ramdisk (md0), never on the NVMe disk.
        "--absent 'BSD root: disk'",
        "--until-lines",
        "--send-after 'login: ' 'root\\n'",
        "--send-after 'root@localhost ~ # ' 'zmodload zsh/system; for d in /dev/disk*s2; do sysopen -r -u 3 $$d && sysseek -u 3 1024 && sysread -i 3 -s 2 sig && echo \"read $$d sig-$$sig\"; exec 3<&-; sysopen -w -u 4 $$d || echo write-refused-$$((6*7)); done\\n'",
        "$(rootpath //boot/neoboot)",
        "180",
        "'hfs: mounted NeoDarwin on device'",
        "'NeoDarwinNVMeController: 00:02.0: NVMe 1.4, 1b36:0010, model \"QEMU NVMe Ctrl\", serial \"nd1\", firmware '",
        "'; read-only: nd_nvme_rw=0'",
        "'NeoDarwinNVMeNamespace: 00:02.0: namespace 1: '",
