        "--send-after 'root@localhost ~ # ' 'r=($$(/usr/sbin/sysctl -n hw.ncpu hw.activecpu)) && echo ncpu-$${r[1]}-$${r[2]}\\n'",
        "$(rootpath //boot/neoboot)",
        "300",
        "'neoboot: ACPI: 18 CPUs enabled of 18 GICCs; boot CPU MPIDR 0x0'",
        "'NeoDarwinPSCI: CPU_ON cpu 16, MPIDR 0x100'",
        "'NeoDarwinPSCI: CPU_ON cpu 17, MPIDR 0x101'",
        "'NeoDarwinPlatformExpert: 18 of 18 CPUs online'",
        "'NeoDarwinPlatformExpert: IPI round trip from cpu 0 to cpu 16: median '",
        "'NeoDarwinPlatformExpert: IPI round trip from cpu 0 to cpu 17: median '",
        "'hfs: mounted NeoDarwin on device'",
