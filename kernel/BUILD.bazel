# P1-06's exit: four CPUs on QEMU virt, all online. neoboot takes the PSCI
# conduit from the FADT (HVC: QEMU's own PSCI, with no EL3) and no longer
# caps the kernel at one CPU; NeoDarwinPSCI starts the secondaries with
# CPU_ON, NeoDarwinGICv3 gives each CPU its own SGI vectors, and the
# platform expert times an IPI round trip to every other CPU. From root's
# shell, sysctl (system_cmds) reads hw.ncpu and hw.activecpu: both must be
# the MADT's four.
sh_test(
    name = "sbsa_smp_boot_test",
    size = "medium",
    srcs = ["//tools/efi:qemu_efi_test.sh"],
    args = [
        "--cpu neoverse-n2",
        "--mem 2G",
        "--smp 4",
        "--esp NeoDarwin/kernelcache=$(rootpath :sbsa_kc)",
        "--esp NeoDarwin/ramdisk=$(rootpath //images:session_root)",
        "--until-lines",
        "--send-after 'login: ' 'root\\n'",
        "--send-after 'root@localhost ~ # ' 'r=($$(/usr/sbin/sysctl -n hw.ncpu hw.activecpu)) && echo ncpu-$${r[1]}-$${r[2]}\\n'",
        "$(rootpath //boot/neoboot)",
        "180",
        "'neoboot: ACPI: 4 CPUs enabled of 4 GICCs; boot CPU MPIDR 0x0'",
        "'neoboot: PSCI conduit: HVC, as the FADT says'",
        "'NeoDarwinPSCI: PSCI 1.1 over HVC'",
        "'NeoDarwinPlatformExpert: 4 of 4 CPUs online'",
        "'NeoDarwinPlatformExpert: IPI round trip from cpu 0 to cpu 1: median '",
        "'NeoDarwinPlatformExpert: IPI round trip from cpu 0 to cpu 2: median '",
        "'NeoDarwinPlatformExpert: IPI round trip from cpu 0 to cpu 3: median '",
        "'hfs: mounted NeoDarwin on device'",
        "'ncpu-4-4'",
    ],
    data = [
        ":sbsa_kc",
        "//boot/neoboot",
        "//images:session_root",
    ],
    tags = ["manual", "kernel", "qemu"],
)

# The same on QEMU virt with TF-A at EL3 (docs/kernel/qemu-secure.md): the
# FADT reports no PSCI, since QEMU turns its own off when firmware owns EL3,
# but the CPU implements EL3, so neoboot chooses SMC and TF-A's BL31 starts
# the CPUs. The GIC has two security states (DS == 0): the timer is on
# Group 1, and TF-A resets each redistributor's SGIs and PPIs as it powers
# the CPU on, so NeoDarwinGICv3 programs them again on the CPU itself.
sh_test(
    name = "sbsa_secure_smp_boot_test",
    size = "medium",
    srcs = ["//tools/efi:qemu_efi_test.sh"],
    args = [
        "--machine virt-secure",
        "--firmware $(rootpath //third_party/qemu_firmware:virt_secure_flash)",
        "--cpu neoverse-n2",
        "--mem 2G",
        "--smp 4",
        "--esp NeoDarwin/kernelcache=$(rootpath :sbsa_kc)",
        "--esp NeoDarwin/ramdisk=$(rootpath //images:session_root)",
        "--until-lines",
        "--send-after 'login: ' 'root\\n'",
        "--send-after 'root@localhost ~ # ' 'r=($$(/usr/sbin/sysctl -n hw.ncpu hw.activecpu)) && echo ncpu-$${r[1]}-$${r[2]}\\n'",
        "--send-after 'root@localhost ~ # ' 'zmodload zsh/datetime && t=$$EPOCHREALTIME && sleep 1 && echo slept-$$(( EPOCHREALTIME - t >= 1 ))\\n'",
        "$(rootpath //boot/neoboot)",
        "240",
        "'NOTICE:  BL31: v2.15.0(release)'",
        "'neoboot: ACPI: timer PPI 27 level, UART PL011 at 0x9000000, PSCI absent'",
        "'neoboot: PSCI conduit: SMC: the FADT reports none, but the CPU implements EL3'",
        "'NeoDarwinPSCI: PSCI 1.1 over SMC'",
        "'NeoDarwinGICv3: timer PPI 27 on Group 1 (IRQ); '",
        "'NeoDarwinPlatformExpert: 4 of 4 CPUs online'",
        "'NeoDarwinPlatformExpert: IPI round trip from cpu 0 to cpu 3: median '",
        "'ncpu-4-4'",
        "'slept-1'",
    ],
    data = [
        ":sbsa_kc",
        "//boot/neoboot",
        "//images:session_root",
        "//third_party/qemu_firmware:virt_secure_flash",
    ],
    tags = ["manual", "kernel", "qemu"],
)

# P1-17's exit: the Armv8.2 kernel (patch 0019) on QEMU's cortex-a76, the
# class of core the Radxa Dragon Q8B has (Cortex-X1C/A78C, no FEAT_TLBIRANGE,
# no FEAT_DIT), with eight CPUs, booted to root's shell.
sh_test(
    name = "sbsa_a76_smp8_boot_test",
    size = "medium",
    srcs = ["//tools/efi:qemu_efi_test.sh"],
    args = [
        "--cpu cortex-a76",
        "--mem 2G",
        "--smp 8",
        "--esp NeoDarwin/kernelcache=$(rootpath :sbsa_kc)",
        "--esp NeoDarwin/ramdisk=$(rootpath //images:session_root)",
        "--until-lines",
        "--send-after 'login: ' 'root\\n'",
        "--send-after 'root@localhost ~ # ' 'r=($$(/usr/sbin/sysctl -n hw.ncpu hw.activecpu)) && echo ncpu-$${r[1]}-$${r[2]}\\n'",
        "$(rootpath //boot/neoboot)",
        "240",
        "'neoboot: ACPI: 8 CPUs enabled of 8 GICCs; boot CPU MPIDR 0x0'",
        "'NeoDarwinPlatformExpert: 8 of 8 CPUs online'",
        "'NeoDarwinPlatformExpert: IPI round trip from cpu 0 to cpu 7: median '",
        "'hfs: mounted NeoDarwin on device'",
        "'ncpu-8-8'",
    ],
    data = [
        ":sbsa_kc",
        "//boot/neoboot",
        "//images:session_root",
    ],
    tags = ["manual", "kernel", "qemu"],
)

# CPUs numbered in MPIDR Aff1 (patch 0020). DynamIQ cores, like the Q8B's
# (MPIDR 0x000-0x700), number themselves in Aff1 with Aff0 = 0. QEMU virt
# can't do that: it gives 16 CPUs per Aff1 value whatever -smp's topology
# (hw/arm/virt.c virt_cpu_mp_affinity), so 18 CPUs make cpu 16 and 17
# MPIDR 0x100 and 0x101. 0x100 has Aff0 = 0, like the boot CPU: before 0020
# start.s matched it to the boot CPU's cpu_data. Each must come up on its
# own, take IPIs addressed through ICC_SGI1R_EL1's Aff1 field, and count.
sh_test(
    name = "sbsa_a76_aff1_boot_test",
    size = "medium",
    srcs = ["//tools/efi:qemu_efi_test.sh"],
    args = [
        "--cpu cortex-a76",
        "--mem 2G",
        "--smp 18",
        "--esp NeoDarwin/kernelcache=$(rootpath :sbsa_kc)",
        "--esp NeoDarwin/ramdisk=$(rootpath //images:session_root)",
        "--until-lines",
        "--send-after 'login: ' 'root\\n'",
        "--send-after 'root@localhost ~ # ' 'r=($$(/usr/sbin/sysctl -n hw.ncpu hw.activecpu)) && echo ncpu-$${r[1]}-$${r[2]}\\n'",
        "$(rootpath //boot/neoboot)",
        "300",
        "'neoboot: ACPI: 18 CPUs enabled of 18 GICCs; boot CPU MPIDR 0x0'",
        "'NeoDarwinPSCI: CPU_ON cpu 16, MPIDR 0x100'",
        "'NeoDarwinPSCI: CPU_ON cpu 17, MPIDR 0x101'",
        "'NeoDarwinPlatformExpert: 18 of 18 CPUs online'",
        "'NeoDarwinPlatformExpert: IPI round trip from cpu 0 to cpu 16: median '",
        "'NeoDarwinPlatformExpert: IPI round trip from cpu 0 to cpu 17: median '",
        "'hfs: mounted NeoDarwin on device'",
        "'ncpu-18-18'",
    ],
    data = [
        ":sbsa_kc",
        "//boot/neoboot",
        "//images:session_root",
    ],
    tags = ["manual", "kernel", "qemu"],
)

# The Armv8.2 kernel with eight cortex-a76 CPUs under TF-A (PSCI over SMC,
# two GIC security states, the timer on Group 1), as on the Q8B. TF-A's
# QEMU platform stops at eight cores.
sh_test(
    name = "sbsa_a76_secure_smp8_boot_test",
