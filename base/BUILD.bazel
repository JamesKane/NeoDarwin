# The userland base built from Apple source: docs/base/libsystem.md.
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//rules:base.bzl", "base_library", "base_root", "base_sysroot")
load("//rules:cc.bzl", "lang_audit_test")

package(default_visibility = ["//visibility:public"])

base_sysroot(
    name = "sysroot",
    availability = "@apple_availability_versions//:all",
    dyld = "@apple_dyld//:all",
    launchd = "@apple_launchd//:all",
    libc = "@apple_libc//:all",
    dispatch_headers_script = "libdispatch/install_headers.sh",
    libclosure = "@apple_libclosure//:all",
    libdispatch = "@apple_libdispatch//:all",
    llvm = "@llvm_project//:all",
    llvm_headers_script = "llvm/install_headers.sh",
    mdns_headers_script = "mdnsresponder/install_headers.sh",
    mdns_patches = glob(["mdnsresponder/patches/*.patch"]),
    mdnsresponder = "@apple_mdnsresponder//:all",
    objc4 = "@apple_objc4//:all",
    libinfo = "@apple_libinfo//:all",
    libmalloc = "@apple_libmalloc//:all",
    libplatform = "@apple_libplatform//:all",
    libpthread = "@apple_libpthread//:all",
    shims = "//base/sdk:headers",
    shims_root = "base/sdk",
    xnu = "@apple_xnu//:all",
    xnu_headers = "//kernel:headers",
)

base_library(
    name = "libsystem_kernel",
    data = glob(["libsyscall/**"]),
    script = "libsyscall/build.sh",
    srcs = "@apple_xnu//:all",
    sysroot = ":sysroot",
)

base_library(
    name = "libsystem_platform",
    data = glob(["libplatform/**"]),
    deps = [":libsystem_kernel"],
    script = "libplatform/build.sh",
    srcs = "@apple_libplatform//:all",
    sysroot = ":sysroot",
)

base_library(
    name = "libsystem_pthread",
    data = glob(["libpthread/**"]),
    deps = [":libsystem_kernel", ":libsystem_platform"],
    script = "libpthread/build.sh",
    srcs = "@apple_libpthread//:all",
    sysroot = ":sysroot",
)

base_library(
    name = "libsystem_malloc",
    data = glob(["libmalloc/**"]),
    deps = [":libsystem_kernel", ":libsystem_platform", ":libsystem_pthread"],
    script = "libmalloc/build.sh",
    srcs = "@apple_libmalloc//:all",
    sysroot = ":sysroot",
)

base_library(
    name = "libsystem_c",
    data = glob(["libc/**"]),
    deps = [":libsystem_kernel", ":libsystem_platform", ":libsystem_pthread", ":libsystem_malloc"],
    script = "libc/build.sh",
    srcs = "@apple_libc//:all",
    sysroot = ":sysroot",
)

base_library(
    name = "libsystem_blocks",
    data = glob(["libclosure/**"]),
    deps = [":libsystem_kernel", ":libsystem_platform", ":libsystem_malloc"],
    script = "libclosure/build.sh",
    srcs = "@apple_libclosure//:all",
    sysroot = ":sysroot",
)

base_library(
    name = "libmacho",
    data = glob(["cctools/**"]),
    deps = [":libsystem_kernel", ":libsystem_malloc", ":libsystem_c"],
    script = "cctools/build.sh",
    srcs = "@apple_cctools//:all",
    sysroot = ":sysroot",
)

# Named for the image: a target named libdispatch would put its output where
# the libdispatch/ sources are.
base_library(
    name = "libdispatch_dylib",
    data = glob(["libdispatch/**"]),
    deps = [":libsystem_kernel", ":libsystem_platform", ":libsystem_pthread", ":libsystem_malloc", ":libsystem_c", ":libsystem_blocks"],
    script = "libdispatch/build.sh",
    srcs = "@apple_libdispatch//:all",
    sysroot = ":sysroot",
)

base_library(
    name = "libsystem_asl",
    data = glob(["syslog/**"]),
    deps = [":libsystem_kernel", ":libsystem_platform", ":libsystem_pthread", ":libsystem_malloc", ":libsystem_c", ":libsystem_blocks"],
    script = "syslog/build.sh",
    srcs = "@apple_syslog//:all",
    sysroot = ":sysroot",
)

base_library(
    name = "libsystem_notify",
    data = glob(["libnotify/**"]),
    deps = [":libsystem_kernel", ":libsystem_platform", ":libsystem_pthread", ":libsystem_malloc", ":libsystem_c", ":libsystem_blocks"],
    script = "libnotify/build.sh",
    srcs = "@apple_libnotify//:all",
    sysroot = ":sysroot",
)

base_library(
    name = "libsystem_info",
    data = glob(["libinfo/**"]),
    deps = [":libsystem_kernel", ":libsystem_platform", ":libsystem_pthread", ":libsystem_malloc", ":libsystem_c", ":libsystem_blocks",
            ":llvm_runtimes", ":libdispatch_dylib", ":libsystem_dnssd", ":libsystem_notify", ":libsystem_darwin", ":standin_libs", ":libxpc"],
    script = "libinfo/build.sh",
    srcs = "@apple_libinfo//:all",
    sysroot = ":sysroot",
)

base_library(
    name = "libobjc",
    data = glob(["objc4/**"]),
    script = "objc4/build.sh",
    srcs = "@apple_objc4//:all",
    sysroot = ":sysroot",
)

base_library(
    name = "llvm_runtimes",
    data = glob(["llvm/**"]),
    deps = [":libsystem_kernel", ":libsystem_platform", ":libsystem_pthread", ":libsystem_malloc", ":libsystem_c"],
    script = "llvm/build.sh",
    srcs = "@llvm_project//:all",
    sysroot = ":sysroot",
)

base_library(
    name = "libsystem_m",
    data = glob(["libm/**"]),
    script = "libm/build.sh",
    srcs = "@freebsd_msun//:all",
    sysroot = ":sysroot",
)

base_library(
    name = "libsystem_darwin",
    data = glob(["libdarwin/**"]),
    deps = [":libsystem_kernel", ":libsystem_platform", ":libsystem_pthread", ":libsystem_malloc", ":libsystem_c",
            ":libsystem_blocks", ":libdispatch_dylib", ":libmacho", ":libsystem_m", ":llvm_runtimes", ":standin_libs", ":libxpc"],
    script = "libdarwin/build.sh",
    srcs = "@apple_libc//:all",
    sysroot = ":sysroot",
)

base_library(
    name = "libsystem_collections",
    data = glob(["libcollections/**"]),
    deps = [":libsystem_kernel", ":libsystem_malloc", ":libsystem_c", ":libsystem_blocks", ":llvm_runtimes"],
    script = "libcollections/build.sh",
    srcs = "@apple_libc//:all",
    sysroot = ":sysroot",
)

base_library(
    name = "libcopyfile",
    data = glob(["copyfile/**"]),
    deps = [":libsystem_kernel", ":libsystem_platform", ":libsystem_malloc", ":libsystem_c", ":libsystem_blocks",
            ":libsystem_asl", ":libsystem_info", ":libdispatch_dylib", ":llvm_runtimes", ":standin_libs", ":libxpc"],
    script = "copyfile/build.sh",
    srcs = "@apple_copyfile//:all",
    sysroot = ":sysroot",
)

base_library(
    name = "libremovefile",
    data = glob(["removefile/**"]),
    deps = [":libsystem_kernel", ":libsystem_platform", ":libsystem_malloc", ":libsystem_c", ":llvm_runtimes"],
    script = "removefile/build.sh",
    srcs = "@apple_removefile//:all",
    sysroot = ":sysroot",
)

base_library(
    name = "libsystem_dnssd",
    data = glob(["mdnsresponder/**"]),
    deps = [":libsystem_kernel", ":libsystem_platform", ":libsystem_pthread", ":libsystem_malloc", ":libsystem_c",
            ":libsystem_blocks", ":libdispatch_dylib", ":libsystem_asl", ":llvm_runtimes"],
    script = "mdnsresponder/build.sh",
    srcs = "@apple_mdnsresponder//:all",
    sysroot = ":sysroot",
)

# Stand-ins for closed libraries: libcorecrypto, libxpc, libsystem_trace,
# libsystem_sandbox, libsystem_sanitizers, libsystem_featureflags, and
# libsystem_configuration until configd is built.
base_library(
    name = "standin_libs",
    data = ["//base/standins:srcs"],
    deps = [":libsystem_kernel", ":libsystem_platform", ":libsystem_malloc", ":libsystem_c", ":libsystem_blocks"],
    script = "//base/standins:build.sh",
    srcs = "//base/standins:srcs",
    sysroot = ":sysroot",
)

# dyld and libdyld. The libraries below libdyld in the build (kernel through
# libdispatch and the stand-ins) link it through the SDK's .tbd stub, which
# has the same install name; NeoDarwin's libdyld exports what they import.
base_library(
    name = "dyld_images",
    data = glob(["dyld/**"]) + ["//kernel/neodarwin/crypto:kernel_srcs", "@apple_xnu//:all", "@freebsd_crypto//:all"],
    deps = [":libsystem_kernel", ":libsystem_platform", ":libsystem_pthread", ":libsystem_malloc", ":libsystem_c",
            ":libsystem_blocks", ":libdispatch_dylib", ":llvm_runtimes", ":standin_libs", ":libxpc"],
    script = "dyld/build.sh",
    srcs = "@apple_dyld//:all",
    sysroot = ":sysroot",
)

base_library(
    name = "libsystem_b",
    data = glob(["libsystem/**"]),
    deps = [":libsystem_kernel", ":libsystem_platform", ":libsystem_pthread", ":libsystem_malloc", ":libsystem_c",
            ":libsystem_blocks", ":libdispatch_dylib", ":libmacho", ":libsystem_asl", ":libsystem_notify", ":libsystem_info",
            ":libsystem_m", ":libsystem_darwin", ":libsystem_collections", ":libcopyfile", ":libremovefile",
            ":libsystem_dnssd", ":llvm_runtimes", ":standin_libs", ":libxpc", ":dyld_images"],
    script = "libsystem/build.sh",
    srcs = "@apple_libsystem//:all",
    sysroot = ":sysroot",
)

sh_test(
    name = "libsystem_reexports_test",
    size = "small",
    srcs = ["libsystem/reexports_test.sh"],
    args = ["$(rootpath :libsystem_b)", "usr/lib/libSystem.B.dylib", "$(rootpath libsystem/reexports.txt)"],
    data = [":libsystem_b", "libsystem/reexports.txt"],
)

# launchd-842 (docs/base/session.md): liblaunch inside the libxpc stand-in,
# and the daemon, PID 1.
base_library(
    name = "libxpc",
    data = glob(["launchd/**"]) + ["//base/standins:srcs"],
    deps = [":libsystem_kernel", ":libsystem_platform", ":libsystem_pthread", ":libsystem_malloc",
            ":libsystem_c", ":libsystem_blocks", ":libdispatch_dylib", ":llvm_runtimes"],
    script = "launchd/build_libxpc.sh",
    srcs = "@apple_launchd//:all",
    sysroot = ":sysroot",
)

base_library(
    name = "launchd_daemon",
    data = glob(["launchd/**"]) + ["commands.sh"],
    deps = [":root"],
    script = "launchd/build.sh",
    srcs = "@apple_launchd//:all",
    sysroot = ":sysroot",
)

# The runtime root: every library above at its install path, for the HFS+
# image (//images:hello_root) and for linking programs against
# (rules/darwin_executable.bzl).
base_root(
    name = "root",
    libraries = [
        ":libsystem_kernel",
        ":libsystem_platform",
        ":libsystem_pthread",
        ":libsystem_malloc",
        ":libsystem_c",
        ":libsystem_blocks",
        ":libmacho",
        ":libdispatch_dylib",
        ":libsystem_asl",
        ":libsystem_notify",
        ":libsystem_info",
        ":libobjc",
        ":llvm_runtimes",
        ":libsystem_m",
        ":libsystem_darwin",
        ":libsystem_collections",
        ":libcopyfile",
        ":libremovefile",
        ":libsystem_dnssd",
        ":standin_libs",
        ":libxpc",
        ":libsystem_b",
        ":dyld_images",
    ],
)

# Commands and the libraries only they use, linked against the runtime root
# (base/commands.sh); none is part of //base:root, so there's no cycle.
base_library(
    name = "libutil_dylib",
    data = glob(["libutil/**"]) + ["commands.sh"],
    deps = [":root"],
    script = "libutil/build.sh",
    srcs = "@apple_libutil//:all",
    sysroot = ":sysroot",
)

base_library(
    name = "libxo_dylib",
    data = glob(["libxo/**"]) + ["commands.sh"],
    deps = [":root"],
    script = "libxo/build.sh",
    srcs = "@freebsd_libxo//:all",
    sysroot = ":sysroot",
)

base_library(
    name = "shell_commands",
    data = glob(["shell_cmds/**"]) + ["commands.sh"],
    deps = [":root"],
    script = "shell_cmds/build.sh",
    srcs = "@apple_shell_cmds//:all",
    sysroot = ":sysroot",
)

base_library(
    name = "system_commands",
    data = glob(["system_cmds/**"]) + ["commands.sh"],
    deps = [":root"],
    script = "system_cmds/build.sh",
    srcs = "@apple_system_cmds//:all",
    sysroot = ":sysroot",
)

base_library(
    name = "file_commands",
    data = glob(["file_cmds/**"]) + ["commands.sh"],
    deps = [":root", ":libutil_dylib", ":libxo_dylib"],
    script = "file_cmds/build.sh",
    srcs = "@apple_file_cmds//:all",
    sysroot = ":sysroot",
)

base_library(
    name = "text_commands",
    data = glob(["text_cmds/**"]) + ["commands.sh"],
    deps = [":root", ":libxo_dylib"],
    script = "text_cmds/build.sh",
    srcs = "@apple_text_cmds//:all",
    sysroot = ":sysroot",
)

base_library(
    name = "adv_commands",
    data = glob(["adv_cmds/**"]) + ["commands.sh"],
    deps = [":root"],
    script = "adv_cmds/build.sh",
    srcs = "@apple_adv_cmds//:all",
    sysroot = ":sysroot",
)

base_library(
    name = "etc_files",
    data = glob(["etc/**"]),
    script = "etc/build.sh",
    srcs = "@apple_files//:all",
    sysroot = ":sysroot",
)

base_library(
    name = "libncurses_dylib",
    data = glob(["ncurses/**"]) + ["commands.sh"],
    deps = [":root"],
    script = "ncurses/build.sh",
    srcs = "@apple_ncurses//:all",
    sysroot = ":sysroot",
)

base_library(
    name = "zsh_shell",
    data = glob(["zsh/**"]) + ["commands.sh"],
    deps = [":root", ":libncurses_dylib"],
    script = "zsh/build.sh",
    srcs = "@apple_zsh//:all",
    sysroot = ":sysroot",
)

# The system root: the runtime root with the commands and /etc.
base_root(
    name = "system_root",
    libraries = [
        ":root",
        ":libutil_dylib",
        ":libxo_dylib",
        ":shell_commands",
        ":system_commands",
        ":file_commands",
        ":text_commands",
        ":adv_commands",
        ":etc_files",
        ":libncurses_dylib",
        ":zsh_shell",
    ],
)

[sh_test(
    name = lib + "_exports_test",
    size = "small",
    srcs = ["//tools/base:exports_test.sh"],
    args = [
        "$(rootpath :%s)" % lib,
        "usr/lib/system/%s.dylib" % lib,
        "$(rootpath %s/exports.txt)" % project,
    ],
    data = [
        ":" + lib,
        project + "/exports.txt",
    ],
) for project, lib in [
    ("libsyscall", "libsystem_kernel"),
    ("libplatform", "libsystem_platform"),
    ("libpthread", "libsystem_pthread"),
    ("libmalloc", "libsystem_malloc"),
    ("libc", "libsystem_c"),
    ("libclosure", "libsystem_blocks"),
    ("syslog", "libsystem_asl"),
    ("libnotify", "libsystem_notify"),
    ("libinfo", "libsystem_info"),
    ("libm", "libsystem_m"),
    ("libdarwin", "libsystem_darwin"),
    ("libcollections", "libsystem_collections"),
    ("copyfile", "libcopyfile"),
    ("removefile", "libremovefile"),
    ("mdnsresponder", "libsystem_dnssd"),
]]

[sh_test(
    name = name + "_exports_test",
    size = "small",
    srcs = ["//tools/base:exports_test.sh"],
    args = [
        "$(rootpath %s)" % target,
        path,
        "$(rootpath %s)" % listed,
    ],
    data = [
        target,
        listed,
    ],
) for name, target, path, listed in [
    ("libdispatch", ":libdispatch_dylib", "usr/lib/system/libdispatch.dylib", "libdispatch/exports.txt"),
    ("libobjc", ":libobjc", "usr/lib/libobjc.A.dylib", "objc4/exports.txt"),
    ("libdyld", ":dyld_images", "usr/lib/system/libdyld.dylib", "dyld/exports.txt"),
    ("libutil", ":libutil_dylib", "usr/lib/libutil.dylib", "libutil/exports.txt"),
    ("libxo", ":libxo_dylib", "usr/lib/libxo.dylib", "libxo/exports.txt"),
    ("libxpc", ":libxpc", "usr/lib/system/libxpc.dylib", "launchd/exports.txt"),
    ("libncurses", ":libncurses_dylib", "usr/lib/libncurses.5.4.dylib", "ncurses/exports.txt"),
    ("libsystem", ":libsystem_b", "usr/lib/libSystem.B.dylib", "libsystem/exports.txt"),
    ("libcompiler_rt", ":llvm_runtimes", "usr/lib/system/libcompiler_rt.dylib", "llvm/exports/libcompiler_rt.txt"),
    ("libunwind", ":llvm_runtimes", "usr/lib/system/libunwind.dylib", "llvm/exports/libunwind.txt"),
    ("libc++abi", ":llvm_runtimes", "usr/lib/libc++abi.dylib", "llvm/exports/libc++abi.txt"),
    ("libc++.1", ":llvm_runtimes", "usr/lib/libc++.1.dylib", "llvm/exports/libc++.1.txt"),
]]

sh_test(
    name = "libmacho_exports_test",
    size = "small",
    srcs = ["//tools/base:exports_test.sh"],
    args = [
        "$(rootpath :libmacho)",
        "usr/lib/system/libmacho.dylib",
        "$(rootpath cctools/exports.txt)",
    ],
    data = [
        ":libmacho",
        "cctools/exports.txt",
    ],
)

lang_audit_test(
    name = "base_lang_audit",
    srcs = [
        "libdispatch/src/nd_work_interval_instance.c",
        "libplatform/src/nd_bitops.c",
        "llvm/src/nd_chkstk_darwin.c",
        "llvm/src/nd_typed_new_delete.cpp",
    ] + glob([
        "dyld/src/*.c",
        "launchd/include/*.h",
        "launchd/src/*.c",
        "dyld/sdk/*.h",
        "libdispatch/sdk/**/*.h",
        "libinfo/include/**/*.h",
        "libm/src/*.c",
        "libm/compat/**/*.h",
        "file_cmds/compat/*.h",
    ]),
)
