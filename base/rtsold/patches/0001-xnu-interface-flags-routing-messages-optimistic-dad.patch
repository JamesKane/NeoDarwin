From: NeoDarwin
Subject: [PATCH] rtsold: xnu's interface flags, routing messages, RA option
 structs, optimistic DAD

xnu keeps "IPv6 disabled" and "accepts router advertisements" as extended
interface flags (IFEF_IPV6_DISABLED, IFEF_ACCEPT_RTADV), which
IPConfiguration's interface requests set on macOS and netconfigd's on
NeoDarwin, not as the ND flags FreeBSD reads with SIOCGIFINFO_IN6 (private
on xnu, with another layout). interface_up() and -a read them with
SIOCGIFEFLAGS (nd_ifeflags(), compat/nd_rtsold_compat.h); -F, which sets
FreeBSD's flags, only warns. xnu has no RTM_IFANNOUNCE (an interface that
goes away is seen as down), and Darwin's SDK no <netinet6/ip6_var.h>, from
which rtsol.c uses nothing.

xnu gives a new link-local address optimistic DAD (RFC 4429), which
FreeBSD's rtsold doesn't know: it would solicit at once from it, with the
link-layer address option RFC 4429 forbids then. It waits for DAD instead,
as for a tentative address (network_cmds patch 0002 made the same change
to Apple's older rtsol).

xnu's struct nd_opt_rdnss and nd_opt_dnssl (<netinet/icmp6.h>) include
the first address and 8 octets of domains (24 and 16 bytes; FreeBSD's
are the 8-octet header), so taking the addresses at sizeof() skipped the
first: an RA with one RDNSS address gave no name server. offsetof() of
the address and domain fields is 8 on both.

Rebase-risk: low (guarded blocks in if.c, rtsold.c and rtsock.c).
--- a/if.c
+++ b/if.c
@@ -91,14 +91,20 @@
 interface_up(char *name)
 {
 	struct ifreq ifr;
+#ifdef __APPLE__
+	uint64_t eflags;
+#else
 	struct in6_ndireq nd;
-	int llflag;
 	int s;
+#endif
+	int llflag;
 
 	memset(&ifr, 0, sizeof(ifr));
 	strlcpy(ifr.ifr_name, name, sizeof(ifr.ifr_name));
+#ifndef __APPLE__
 	memset(&nd, 0, sizeof(nd));
 	strlcpy(nd.ifname, name, sizeof(nd.ifname));
+#endif
 
 	if (ioctl(ifsock, SIOCGIFFLAGS, (caddr_t)&ifr) < 0) {
 		warnmsg(LOG_WARNING, __func__, "ioctl(SIOCGIFFLAGS): %s",
@@ -112,6 +118,31 @@
 			    "ioctl(SIOCSIFFLAGS): %s", strerror(errno));
 		return (-1);
 	}
+#ifdef __APPLE__
+	/*
+	 * xnu keeps "IPv6 disabled" and "accepts router advertisements" as
+	 * extended interface flags, which IPConfiguration's interface requests
+	 * set (NeoDarwin's netconfigd makes the same), not as ND flags; -F
+	 * can't set them.
+	 */
+	if (nd_ifeflags(ifsock, name, &eflags) != 0) {
+		warnmsg(LOG_WARNING, __func__, "ioctl(SIOCGIFEFLAGS): %s",
+		    strerror(errno));
+		return (-1);
+	}
+
+	warnmsg(LOG_DEBUG, __func__, "checking if %s is ready...", name);
+
+	if (eflags & ND_IFEF_IPV6_DISABLED) {
+		warnmsg(LOG_WARNING, __func__, "%s is disabled.", name);
+		return (-1);
+	}
+	if (!(eflags & ND_IFEF_ACCEPT_RTADV)) {
+		warnmsg(LOG_WARNING, __func__,
+		    "%s does not accept Router Advertisement.", name);
+		return (-1);
+	}
+#else
 	if ((s = socket(AF_INET6, SOCK_DGRAM, 0)) < 0) {
 		warnmsg(LOG_WARNING, __func__, "socket(AF_INET6, SOCK_DGRAM): %s",
 		    strerror(errno));
@@ -161,6 +192,7 @@
 		}
 	}
 	close(s);
+#endif /* __APPLE__ */
 
 	if (cap_llflags_get(capllflags, name, &llflag) != 0) {
 		warnmsg(LOG_WARNING, __func__,
@@ -168,6 +200,17 @@
 		return (0);
 	}
 
+#ifdef IN6_IFF_OPTIMISTIC
+	/*
+	 * xnu starts a link-local address with optimistic DAD (RFC 4429),
+	 * which mustn't send a solicitation with a link-layer address option:
+	 * wait for DAD as for a tentative address.
+	 */
+	if (llflag & IN6_IFF_OPTIMISTIC) {
+		warnmsg(LOG_DEBUG, __func__, "%s is optimistic", name);
+		return (IFS_TENTATIVE);
+	}
+#endif
 	if (!(llflag & IN6_IFF_NOTREADY)) {
 		warnmsg(LOG_DEBUG, __func__, "%s is ready", name);
 		return (0);
--- a/rtsock.c
+++ b/rtsock.c
@@ -58,15 +58,19 @@
 #include <syslog.h>
 #include "rtsold.h"
 
+#ifdef RTM_IFANNOUNCE
 static int rtsock_input_ifannounce(int, struct rt_msghdr *, char *);
+#endif
 
 static struct {
 	u_char type;
 	size_t minlen;
 	int (*func)(int, struct rt_msghdr *, char *);
 } rtsock_dispatch[] = {
+#ifdef RTM_IFANNOUNCE
 	{ RTM_IFANNOUNCE, sizeof(struct if_announcemsghdr),
 	  rtsock_input_ifannounce },
+#endif
 	{ 0, 0, NULL },
 };
 
@@ -136,6 +140,7 @@
 	return (ret);
 }
 
+#ifdef RTM_IFANNOUNCE
 static int
 rtsock_input_ifannounce(int s __unused, struct rt_msghdr *rtm, char *lim)
 {
@@ -174,3 +179,4 @@
 
 	return (0);
 }
+#endif /* RTM_IFANNOUNCE */
--- a/rtsol.c
+++ b/rtsol.c
@@ -48,7 +48,9 @@
 #include <netinet/in.h>
 #undef 	__BSD_VISIBLE
 #include <netinet/ip6.h>
+#ifndef __APPLE__
 #include <netinet6/ip6_var.h>
+#endif
 #include <netinet/icmp6.h>
 
 #include <arpa/inet.h>
@@ -393,7 +395,13 @@
 				break;
 			}
 
-			addr = (struct in6_addr *)(void *)(raoptp + sizeof(*rdnss));
+			/*
+			 * The addresses follow the 8-octet header. xnu's
+			 * struct nd_opt_rdnss includes the first address
+			 * (its size is 24), FreeBSD's doesn't.
+			 */
+			addr = (struct in6_addr *)(void *)(raoptp +
+			    offsetof(struct nd_opt_rdnss, nd_opt_rdnss_addr));
 			while ((char *)addr < (char *)RA_OPT_NEXT_HDR(raoptp)) {
 				if (inet_ntop(AF_INET6, addr, ntopbuf,
 					sizeof(ntopbuf)) == NULL) {
@@ -476,7 +484,9 @@
 			p = (char *)RA_OPT_NEXT_HDR(raoptp);
 			*(p - 1) = '\0';
 
-			p = raoptp + sizeof(*dnssl);
+			/* As above: xnu's struct nd_opt_dnssl has 8 octets of domains. */
+			p = raoptp + offsetof(struct nd_opt_dnssl,
+			    nd_opt_dnssl_domains);
 			while (1 < (len = dname_labeldec(dname, sizeof(dname),
 			    p))) {
 				/* length == 1 means empty string */
--- a/rtsold.c
+++ b/rtsold.c
@@ -399,6 +399,11 @@
 		goto bad;
 	}
 
+#ifdef __APPLE__
+	if (Fflag)
+		warnmsg(LOG_WARNING, __func__, "-F: xnu's accept_rtadv is "
+		    "set by IPConfiguration's requests (netconfigd), not here");
+#else
 	if (Fflag) {
 		struct in6_ndireq nd;
 		int s;
@@ -424,6 +429,7 @@
 		}
 		(void)close(s);
 	}
+#endif /* __APPLE__ */
 
 	if ((ifi = malloc(sizeof(*ifi))) == NULL) {
 		warnmsg(LOG_ERR, __func__, "memory allocation failed");
@@ -838,7 +844,11 @@
 	char **a;
 	int s = 0, i, found;
 	struct ifaddrs *ifap, *ifa;
+#ifdef __APPLE__
+	uint64_t eflags;
+#else
 	struct in6_ndireq nd;
+#endif
 
 	/* initialize */
 	while (n--)
@@ -884,6 +894,17 @@
 		 * is disabled.
 		 */
 		if (!Fflag) {
+#ifdef __APPLE__
+			if (nd_ifeflags(s, ifa->ifa_name, &eflags) != 0) {
+				warnmsg(LOG_ERR, __func__,
+					"ioctl(SIOCGIFEFLAGS)");
+				exit(1);
+			}
+			if (eflags & ND_IFEF_IPV6_DISABLED)
+				continue;
+			if (!(eflags & ND_IFEF_ACCEPT_RTADV))
+				continue;
+#else
 			memset(&nd, 0, sizeof(nd));
 			strlcpy(nd.ifname, ifa->ifa_name, sizeof(nd.ifname));
 			if (ioctl(s, SIOCGIFINFO_IN6, (caddr_t)&nd) < 0) {
@@ -895,6 +916,7 @@
 				continue;
 			if (!(nd.ndi.flags & ND6_IFF_ACCEPT_RTADV))
 				continue;
+#endif
 		}
 
 		/* if we find multiple candidates, just warn. */
