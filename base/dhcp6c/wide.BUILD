# BUILD file for @wide_dhcpv6: the WIDE DHCPv6 client's sources (FreeBSD's
# net/dhcp6 port), pinned by wide.lock. base/dhcp6c/build.sh compiles them;
# this only exposes them.
package(default_visibility = ["//visibility:public"])

filegroup(
    name = "all",
    srcs = glob(["**"], exclude = ["BUILD.bazel"]),
)
