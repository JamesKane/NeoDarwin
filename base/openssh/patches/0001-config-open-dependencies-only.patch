From: NeoDarwin
Subject: [PATCH] config.h: only what NeoDarwin's base provides

openssh/config.h is Apple's, from configure-for-osx.sh (--with-pam
--with-audit=bsm --with-kerberos5=/usr), against macOS's closed libraries.
NeoDarwin builds OpenSSH from it, as Apple does, with what needs code the
base doesn't have turned off, as configure would leave it:

- GSSAPI and Kerberos (Heimdal, GSS.framework, Kerberos.framework):
  GSSAPI, KRB5 and their header and function checks;
- BSM audit (libbsm, not built yet): USE_BSM_AUDIT, HAVE_LIBBSM,
  HAVE_BSM_AUDIT_H, HAVE_GETAUDIT and HAVE_GETAUDIT_ADDR;
- zlib (not in the base): WITH_ZLIB and HAVE_LIBZ, so compression is
  never negotiated;
- Seatbelt: sandbox_init() is libsystem_sandbox's, which NeoDarwin stands
  in for without a policy. sshd-auth, the pre-authentication process,
  uses OpenSSH's rlimit sandbox instead (SANDBOX_RLIMIT: no new files,
  descriptors or processes), on top of privilege separation's chroot to
  /var/empty and the _sshd user.

--- a/openssh/config.h
+++ b/openssh/config.h
@@ -176,7 +176,7 @@
 /* #undef GLOB_HAS_GL_STATV */
 
 /* Define this if you want GSSAPI support in the version 2 protocol */
-#define GSSAPI 1
+/* #undef GSSAPI */
 
 /* Define if you want to use shadow password expire field */
 /* #undef HAS_SHADOW_EXPIRE */
@@ -266,7 +266,7 @@
 /* #undef HAVE_BSD_LIBUTIL_H */
 
 /* Define to 1 if you have the <bsm/audit.h> header file. */
-#define HAVE_BSM_AUDIT_H 1
+/* #undef HAVE_BSM_AUDIT_H */
 
 /* Define to 1 if you have the <bstring.h> header file. */
 /* #undef HAVE_BSTRING_H */
@@ -352,7 +352,7 @@
 
 /* Define to 1 if you have the declaration of `GSS_C_NT_HOSTBASED_SERVICE',
    and to 0 if you don't. */
-#define HAVE_DECL_GSS_C_NT_HOSTBASED_SERVICE 1
+/* #undef HAVE_DECL_GSS_C_NT_HOSTBASED_SERVICE */
 
 /* Define to 1 if you have the declaration of `howmany', and to 0 if you
    don't. */
@@ -640,10 +640,10 @@
 #define HAVE_GETADDRINFO 1
 
 /* Define to 1 if you have the `getaudit' function. */
-#define HAVE_GETAUDIT 1
+/* #undef HAVE_GETAUDIT */
 
 /* Define to 1 if you have the `getaudit_addr' function. */
-#define HAVE_GETAUDIT_ADDR 1
+/* #undef HAVE_GETAUDIT_ADDR */
 
 /* Define to 1 if you have the `getcwd' function. */
 #define HAVE_GETCWD 1
@@ -754,16 +754,16 @@
 /* #undef HAVE_GSSAPI_GENERIC_H */
 
