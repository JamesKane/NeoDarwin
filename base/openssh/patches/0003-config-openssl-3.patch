From: NeoDarwin
Subject: [PATCH] config.h: libcrypto is OpenSSL 3.5, not LibreSSL

openssh/config.h is configure's answer for macOS's libcrypto, LibreSSL
3.3.6. NeoDarwin's is OpenSSL 3.5 (docs/base/session.md, "Loopback and
sshd"), and these are the libcrypto checks of OpenSSH's configure that
answer differently against it (configure, cross-compiling, against
OpenSSL 3.5.9's headers and library):

- EVP_CIPHER_CTX_get_iv and EVP_CIPHER_CTX_set_iv are LibreSSL's; OpenSSL
  3 has EVP_CIPHER_CTX_get_updated_iv, and EVP_CIPHER_CTX_iv and
  EVP_CIPHER_CTX_iv_noconst (deprecated, still built);
- EVP_MD_CTX_cleanup, EVP_MD_CTX_init and HMAC_CTX_init went in OpenSSL
  1.1 (macros at most, so configure's link checks fail);
- EVP_PKEY_get_raw_private_key and EVP_PKEY_get_raw_public_key exist, and
  libcrypto has Ed25519 (OPENSSL_HAS_ED25519).

The rest (WITH_OPENSSL, OPENSSL_HAS_ECC and the NIST curves, EVP_chacha20,
OpenSSL_version and the others) answers the same. configure also finds
EVP_DigestSign and EVP_DigestVerify; Apple's config.h has no lines for
them and OpenSSH 10.0p2 doesn't test them, so they aren't added.

--- a/openssh/config.h
+++ b/openssh/config.h
@@ -496,19 +496,19 @@
 #define HAVE_EVP_CHACHA20 1
 
 /* Define to 1 if you have the `EVP_CIPHER_CTX_get_iv' function. */
-#define HAVE_EVP_CIPHER_CTX_GET_IV 1
+/* #undef HAVE_EVP_CIPHER_CTX_GET_IV */
 
 /* Define to 1 if you have the `EVP_CIPHER_CTX_get_updated_iv' function. */
-/* #undef HAVE_EVP_CIPHER_CTX_GET_UPDATED_IV */
+#define HAVE_EVP_CIPHER_CTX_GET_UPDATED_IV 1
 
 /* Define to 1 if you have the `EVP_CIPHER_CTX_iv' function. */
-/* #undef HAVE_EVP_CIPHER_CTX_IV */
+#define HAVE_EVP_CIPHER_CTX_IV 1
 
 /* Define to 1 if you have the `EVP_CIPHER_CTX_iv_noconst' function. */
-/* #undef HAVE_EVP_CIPHER_CTX_IV_NOCONST */
+#define HAVE_EVP_CIPHER_CTX_IV_NOCONST 1
 
 /* Define to 1 if you have the `EVP_CIPHER_CTX_set_iv' function. */
-#define HAVE_EVP_CIPHER_CTX_SET_IV 1
+/* #undef HAVE_EVP_CIPHER_CTX_SET_IV */
 
 /* Define to 1 if you have the `EVP_DigestFinal_ex' function. */
 #define HAVE_EVP_DIGESTFINAL_EX 1
@@ -517,19 +517,19 @@
 #define HAVE_EVP_DIGESTINIT_EX 1
 
 /* Define to 1 if you have the `EVP_MD_CTX_cleanup' function. */
-#define HAVE_EVP_MD_CTX_CLEANUP 1
+/* #undef HAVE_EVP_MD_CTX_CLEANUP */
 
 /* Define to 1 if you have the `EVP_MD_CTX_copy_ex' function. */
 #define HAVE_EVP_MD_CTX_COPY_EX 1
 
 /* Define to 1 if you have the `EVP_MD_CTX_init' function. */
-#define HAVE_EVP_MD_CTX_INIT 1
+/* #undef HAVE_EVP_MD_CTX_INIT */
 
 /* Define to 1 if you have the `EVP_PKEY_get_raw_private_key' function. */
-/* #undef HAVE_EVP_PKEY_GET_RAW_PRIVATE_KEY */
+#define HAVE_EVP_PKEY_GET_RAW_PRIVATE_KEY 1
 
 /* Define to 1 if you have the `EVP_PKEY_get_raw_public_key' function. */
-/* #undef HAVE_EVP_PKEY_GET_RAW_PUBLIC_KEY */
+#define HAVE_EVP_PKEY_GET_RAW_PUBLIC_KEY 1
 
 /* Define to 1 if you have the `EVP_sha256' function. */
 #define HAVE_EVP_SHA256 1
@@ -772,7 +772,7 @@
 #define HAVE_HEADER_AD 1
 
 /* Define to 1 if you have the `HMAC_CTX_init' function. */
-#define HAVE_HMAC_CTX_INIT 1
+/* #undef HAVE_HMAC_CTX_INIT */
 
 /* Define if you have ut_host in utmp.h */
 #define HAVE_HOST_IN_UTMP 1
@@ -1760,7 +1760,7 @@
 #define OPENSSL_HAS_ECC 1
 
 /* libcrypto has ed25519 support */
-/* #undef OPENSSL_HAS_ED25519 */
+#define OPENSSL_HAS_ED25519 1
 
 /* libcrypto has NID_X9_62_prime256v1 */
 #define OPENSSL_HAS_NISTP256 1
