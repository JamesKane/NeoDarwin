From: NeoDarwin
Subject: [PATCH] getrrsetbyname: fail without libresolv

getrrsetbyname() (DNS SSHFP records, for VerifyHostKeyDNS) queries through
libresolv's res_query(), which Apple's build links (-lresolv). NeoDarwin's
base has no libresolv yet. With NEODARWIN_NO_LIBRESOLV (set by
base/openssh/build.sh) every query fails with ERRSET_FAIL, as with no name
server; without it, upstream is unchanged.

--- a/openssh/openbsd-compat/getrrsetbyname.c
+++ b/openssh/openbsd-compat/getrrsetbyname.c
@@ -47,7 +47,7 @@
 
 #include "includes.h"
 
-#if !defined (HAVE_GETRRSETBYNAME) && !defined (HAVE_LDNS)
+#if !defined (HAVE_GETRRSETBYNAME) && !defined (HAVE_LDNS) && !defined (NEODARWIN_NO_LIBRESOLV)
 
 #include <stdlib.h>
 #include <string.h>
@@ -646,3 +646,30 @@
 }
 
 #endif /*  !defined (HAVE_GETRRSETBYNAME) && !defined (HAVE_LDNS) */
+
+#if !defined (HAVE_GETRRSETBYNAME) && !defined (HAVE_LDNS) && defined (NEODARWIN_NO_LIBRESOLV)
+#include <stdlib.h>
+#include "getrrsetbyname.h"
+
+/*
+ * NeoDarwin's base has no libresolv yet (libresolv-93; P4-24), whose
+ * res_query() this code calls, so no DNS lookup can be made: every query
+ * fails, as with no name server, and VerifyHostKeyDNS finds no SSHFP
+ * records.
+ */
+int
+getrrsetbyname(const char *hostname, unsigned int rdclass,
+    unsigned int rdtype, unsigned int flags,
+    struct rrsetinfo **res)
+{
+	(void)hostname; (void)rdclass; (void)rdtype; (void)flags;
+	*res = NULL;
+	return (ERRSET_FAIL);
+}
+
+void
+freerrset(struct rrsetinfo *rrset)
+{
+	(void)rrset;
+}
+#endif
