+/*
+ * xnu: pf stays enabled while any reference taken with -E is held (and
+ * after a plain -e); -X releases one, and pf stops with the last.
+ */
 int
+pfctl_enable_ref(int dev, int opts)
+{
+	u_int64_t token = 0;
+
+	if (ioctl(dev, DIOCSTARTREF, &token))
+		err(1, "DIOCSTARTREF");
+	if ((opts & PF_OPT_QUIET) == 0)
+		fprintf(stderr, "pf enabled\n");
+	printf("Token : %llu\n", (unsigned long long)token);
+	return (0);
+}
+
+int
+pfctl_release_ref(int dev, const char *token, int opts)
+{
+	struct pfioc_remove_token pfrt;
+	char *end;
+
+	memset(&pfrt, 0, sizeof(pfrt));
+	errno = 0;
+	pfrt.token_value = strtoull(token, &end, 10);
+	if (errno != 0 || *token == '\0' || *end != '\0')
+		errx(1, "invalid token: %s", token);
+	if (ioctl(dev, DIOCSTOPREF, &pfrt)) {
+		if (errno == ENOENT)
+			errx(1, "pf not enabled");
+		else if (errno == EINVAL)
+			errx(1, "no such token: %s", token);
+		else
+			err(1, "DIOCSTOPREF");
+	}
+	if ((opts & PF_OPT_QUIET) == 0) {
+		if (pfrt.refcount == 0)
+			fprintf(stderr, "pf disabled\n");
+		else
+			fprintf(stderr, "pf enable reference released, "
+			    "%llu remaining\n",
+			    (unsigned long long)pfrt.refcount);
+	}
+	return (0);
+}
+
+int
+pfctl_show_references(int dev, int opts)
+{
+	struct pfioc_tokens pt;
+	struct pfioc_token *tok;
+	int i, n;
+
+	memset(&pt, 0, sizeof(pt));
+	if (ioctl(dev, DIOCGETSTARTERS, &pt))
+		err(1, "DIOCGETSTARTERS");
+	if (opts & PF_OPT_SHOWALL)
+		pfctl_print_title("REFERENCES:");
+	if (pt.size <= 0) {
+		printf("No pf enable references\n");
+		return (0);
+	}
+	if ((pt.pgt_buf = calloc(1, pt.size)) == NULL)
+		err(1, "calloc");
+	if (ioctl(dev, DIOCGETSTARTERS, &pt))
+		err(1, "DIOCGETSTARTERS");
+	n = pt.size / sizeof(struct pfioc_token);
+	printf("%-8s %-20s %-20s %s\n", "PID", "Process Name", "TOKEN",
+	    "TIMESTAMP");
+	for (i = 0, tok = pt.pgt_tokens; i < n; i++, tok++)
+		printf("%-8d %-20.*s %-20llu %llu\n", (int)tok->pid,
+		    (int)sizeof(tok->proc_name), tok->proc_name,
+		    (unsigned long long)tok->token_value,
+		    (unsigned long long)tok->timestamp);
+	free(pt.pgt_buf);
+	return (0);
+}
