-		r->dst.port[1] = dst_port->port[1];
-		r->dst.port_op = dst_port->op;
+		r->dst.xport.range.port[0] = dst_port->port[0];
+		r->dst.xport.range.port[1] = dst_port->port[1];
+		r->dst.xport.range.op = dst_port->op;
 		r->uid.op = uid->op;
 		r->uid.uid[0] = uid->uid[0];
 		r->uid.uid[1] = uid->uid[1];
--- a/sbin/pfctl/pf_print_state.c
+++ b/sbin/pfctl/pf_print_state.c
@@ -167,7 +167,7 @@
 void
 print_host(struct pfsync_state_host *h, sa_family_t af, int opts)
 {
-	u_int16_t p = ntohs(h->port);
+	u_int16_t p = ntohs(h->xport.port);
 
