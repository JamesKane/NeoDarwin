 			printf(" -> ");
 		else
 			printf(" <- ");
 	}
-	print_host(&s->gwy, s->af, opts);
+	print_host(&s->gwy, s->af_gwy, opts);
 	if (s->direction == PF_OUT)
 		printf(" -> ");
 	else
 		printf(" <- ");
-	print_host(&s->ext, s->af, opts);
+	print_host(&s->ext_gwy, s->af_gwy, opts);
+	if (s->af_lan != s->af_gwy) {
+		printf(" (");
+		print_host(&s->ext_lan, s->af_lan, opts);
+		printf(")");
+	}
 
 	printf("    ");
 	if (s->proto == IPPROTO_TCP) {
@@ -285,12 +295,12 @@
