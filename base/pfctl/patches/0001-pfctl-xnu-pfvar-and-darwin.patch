-	    r->dst.port_op != PF_OP_EQ && r->dst.port_op != PF_OP_RRG) {
+	if (r->dst.xport.range.op &&
+	    r->dst.xport.range.op != PF_OP_EQ && r->dst.xport.range.op != PF_OP_RRG) {
 		yyerror("invalid port operator for rdr destination port");
 		problems++;
 	}
@@ -4966,14 +4967,14 @@
