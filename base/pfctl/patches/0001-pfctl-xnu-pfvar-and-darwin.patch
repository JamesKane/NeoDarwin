-	if (PF_ANEQ(&s->lan.addr, &s->gwy.addr, s->af) ||
-	    (s->lan.port != s->gwy.port)) {
-		print_host(&s->lan, s->af, opts);
+	/*
+	 * xnu keeps a family for each side of the translation (NAT64) and
+	 * the external host as seen from each side (ext_lan, ext_gwy).
+	 */
+	if (s->af_lan != s->af_gwy ||
+	    PF_ANEQ(&s->lan.addr, &s->gwy.addr, s->af_lan) ||
+	    (s->lan.xport.port != s->gwy.xport.port)) {
+		print_host(&s->lan, s->af_lan, opts);
