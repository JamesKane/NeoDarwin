# BUILD file for @freebsd_resolvconf: FreeBSD's openresolv (resolvconf(8)),
# pinned by freebsd.lock. base/resolvconf/build.sh installs it; this only
# exposes it.
package(default_visibility = ["//visibility:public"])

filegroup(
    name = "all",
    srcs = glob(["**"], exclude = ["BUILD.bazel"]),
)
