# BUILD file for @freebsd_libmd: FreeBSD's lib/libmd and the sys/crypto
# digests it builds, pinned by freebsd.lock. base/libmd/build.sh compiles
# them; this only exposes them.
package(default_visibility = ["//visibility:public"])

filegroup(
    name = "all",
    srcs = glob(["**"], exclude = ["BUILD.bazel"]),
)
