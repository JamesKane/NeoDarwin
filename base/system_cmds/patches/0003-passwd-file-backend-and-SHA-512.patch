From: NeoDarwin
Subject: [PATCH] passwd: the file backend only, with SHA-512 crypt

passwd changes a password through Open Directory (od_passwd.c, run as
root), PAM (pam_passwd.c: pam_opendirectory) or NIS; all need closed
frameworks, and OpenPAM's pam_unix, NeoDarwin's password module, can't
change a password (its pam_sm_chauthtok returns PAM_SERVICE_ERR). The
project's own file backend (file_passwd.c, iOS's) rewrites
/etc/master.passwd, which Libinfo's file module reads for root, so login
and su see the new password at once. With PW_FILES, NeoDarwin's switch
(without it upstream is unchanged), passwd.h defines INFO_FILE only, so
passwd.c and file_passwd.c build without the other backends. passwd is
installed setuid root, as FreeBSD's is.

The hash: getpasswd() makes a two-character traditional DES salt from
srandom(time()). With PW_FILES it writes SHA-512 crypt, FreeBSD's default
format (login.conf's passwd_format=sha512; NeoDarwin has no login.conf, so
the format is fixed): "$6$", 16 salt characters from arc4random, and the
scheme's default 5000 rounds. libc's crypt(3) has it since Libc patch 0001
(base/libc), and still takes the older formats, DES included, for the old
password. A crypt() that fails (NULL, which strcmp() would dereference) is
a wrong old password, and an error for the new one.
The closing warning about the login keychain is left out: NeoDarwin has
no keychain.

--- a/passwd/passwd.c
+++ b/passwd/passwd.c
@@ -50,7 +50,7 @@
 	char *p;
 	static char obuf[_PASSWORD_LEN+1];
 	static char nbuf[_PASSWORD_LEN+1];
-	char salt[9];
+	char salt[20];
 
 	printf("Changing password for %s.\n", name);
 
@@ -61,7 +61,8 @@
 	if ((isroot == 0) && (isNull == 0))
 	{
 		p = getpass("Old password:");
-		if (strcmp(crypt(p, old_pw), old_pw))
+		char *old_hash = crypt(p, old_pw);
+		if (old_hash == NULL || strcmp(old_hash, old_pw))
 		{
 			errno = EACCES;
 			fprintf(stderr, "Sorry\n");
@@ -131,6 +132,26 @@
 		printf("Mismatch; try again, EOF to quit.\n");
 	}
 
+#ifdef PW_FILES
+	/*
+	 * SHA-512 crypt, FreeBSD's default (login.conf's passwd_format=sha512):
+	 * "$6$", then 16 salt characters (96 bits) from arc4random, and the
+	 * scheme's default 5000 rounds. Every character of the password counts.
+	 * libc's crypt(3) also takes "$5$" SHA-256, "$2b$" bcrypt, "$1$" MD5 and
+	 * DES hashes, so accounts with those still log in; passwd writes SHA-512
+	 * alone (docs/base/session.md).
+	 */
+	strlcpy(salt, "$6$", sizeof(salt));
+	for (i = 3; i < 19; i++)
+		salt[i] = saltchars[arc4random_uniform((uint32_t)strlen(saltchars))];
+	salt[19] = '\0';
+	*new_pw = crypt(nbuf, salt);
+	if (*new_pw == NULL)
+	{
+		fprintf(stderr, "passwd: crypt: %s\n", strerror(errno));
+		exit(1);
+	}
+#else
 	/*
 	 * Create a random salt
 	 */
@@ -139,6 +160,7 @@
 	salt[1] = saltchars[random() % strlen(saltchars)];
 	salt[2] = '\0';
 	*new_pw = crypt(nbuf, salt);
+#endif
 
 	*old_clear = obuf;
 	*new_clear = nbuf;
@@ -284,6 +306,7 @@
 #endif
 	}
 
+#ifndef PW_FILES
 	if (res == 0)
 	{
 		printf("\n");
@@ -294,6 +317,7 @@
 		printf("###############################################################################\n");
 		printf("\n");
 	}
+#endif
 
 	if (free_user == 1)
 		free(user);
--- a/passwd/passwd.h
+++ b/passwd/passwd.h
@@ -25,7 +25,7 @@
 #include <TargetConditionals.h>
 
 #define INFO_FILE 1
-#if !(TARGET_OS_IPHONE && !TARGET_OS_SIMULATOR)
+#if !(TARGET_OS_IPHONE && !TARGET_OS_SIMULATOR) && !defined(PW_FILES)
 #define INFO_NIS 2
 #define INFO_OPEN_DIRECTORY 3
 #define INFO_PAM 4
