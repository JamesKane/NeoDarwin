From: NeoDarwin
Subject: [PATCH] passwd: the file backend only, with extended DES

passwd changes a password through Open Directory (od_passwd.c, run as
root), PAM (pam_passwd.c: pam_opendirectory) or NIS; all need closed
frameworks, and OpenPAM's pam_unix, NeoDarwin's password module, can't
change a password (its pam_sm_chauthtok returns PAM_SERVICE_ERR). The
project's own file backend (file_passwd.c, iOS's) rewrites
/etc/master.passwd, which Libinfo's file module reads for root, so login
and su see the new password at once. With PW_FILES, NeoDarwin's switch
(without it upstream is unchanged), passwd.h defines INFO_FILE only, so
passwd.c and file_passwd.c build without the other backends. passwd is
installed setuid root, as FreeBSD's is.

The salt: getpasswd() makes a two-character traditional DES salt from
srandom(time()). With PW_FILES it uses crypt(3)'s other format, BSDi's
extended DES ('_', 65537 rounds, a 24-bit salt from arc4random), in which
every character of the password counts; traditional DES uses only the
first eight. libc's crypt has no stronger scheme (docs/base/session.md).
The closing warning about the login keychain is left out: NeoDarwin has
no keychain.

--- a/passwd/passwd.c
+++ b/passwd/passwd.c
@@ -50,7 +50,7 @@ getpasswd(char *name, int isroot, int minlen, int mixcase, int nonalpha,
 	char *p;
 	static char obuf[_PASSWORD_LEN+1];
 	static char nbuf[_PASSWORD_LEN+1];
-	char salt[9];
+	char salt[10];
 
 	printf("Changing password for %s.\n", name);
 
@@ -131,6 +131,22 @@ getpasswd(char *name, int isroot, int minlen, int mixcase, int nonalpha,
 		printf("Mismatch; try again, EOF to quit.\n");
 	}
 
+#ifdef PW_FILES
+	/*
+	 * libc's crypt(3) has traditional DES (two salt characters; only the
+	 * first eight characters of the password count) and BSDi's extended
+	 * DES: '_', the rounds in four characters (base 64, low digit first),
+	 * then four characters of salt, and every character of the password
+	 * counts. Use the extended format with 65537 rounds (traditional DES
+	 * has 25; an odd count, as weak keys call for) and a random 24-bit
+	 * salt.
+	 */
+	snprintf(salt, sizeof(salt), "%c/.E.", _PASSWORD_EFMT1);
+	for (i = 5; i < 9; i++)
+		salt[i] = saltchars[arc4random_uniform((uint32_t)strlen(saltchars))];
+	salt[9] = '\0';
+	*new_pw = crypt(nbuf, salt);
+#else
 	/*
 	 * Create a random salt
 	 */
@@ -139,6 +155,7 @@ getpasswd(char *name, int isroot, int minlen, int mixcase, int nonalpha,
 	salt[1] = saltchars[random() % strlen(saltchars)];
 	salt[2] = '\0';
 	*new_pw = crypt(nbuf, salt);
+#endif
 
 	*old_clear = obuf;
 	*new_clear = nbuf;
@@ -284,6 +301,7 @@ main(int argc, char *argv[])
 #endif
 	}
 
+#ifndef PW_FILES
 	if (res == 0)
 	{
 		printf("\n");
@@ -294,6 +312,7 @@ main(int argc, char *argv[])
 		printf("###############################################################################\n");
 		printf("\n");
 	}
+#endif
 
 	if (free_user == 1)
 		free(user);
--- a/passwd/passwd.h
+++ b/passwd/passwd.h
@@ -25,7 +25,7 @@
 #include <TargetConditionals.h>
 
 #define INFO_FILE 1
-#if !(TARGET_OS_IPHONE && !TARGET_OS_SIMULATOR)
+#if !(TARGET_OS_IPHONE && !TARGET_OS_SIMULATOR) && !defined(PW_FILES)
 #define INFO_NIS 2
 #define INFO_OPEN_DIRECTORY 3
 #define INFO_PAM 4
