From: NeoDarwin
Subject: [PATCH] reboot: no kextd lock; launchd-842's reboot2()

Before rebooting, Apple's reboot asks kextd for its reboot lock over MIG
(kextmanager.defs, from IOKitUser's kextmanager_mig.defs) so that a kext
cache update can finish. NeoDarwin has no kextd, so reboot takes the path
the embedded platforms build, without the lock (ND_KEXTD 0). Without the
service the upstream code allows the reboot anyway; the patch only drops
the MIG stub and its IOKit header, which NeoDarwin doesn't have.
reboot3() is newer than NeoDarwin's launchd (842); its liblaunch exports
reboot2(), which asks launchd to reboot in the same way and returns NULL
on success.

--- a/reboot/reboot.c
+++ b/reboot/reboot.c
@@ -63,7 +63,9 @@
 
 #ifdef __APPLE__
 #include <TargetConditionals.h>
-#if !(TARGET_OS_IPHONE && !TARGET_OS_SIMULATOR)
+/* NeoDarwin has no kextd: no kext manager reboot lock, as on embedded. */
+#define ND_KEXTD 0
+#if ND_KEXTD
 #include "kextmanager.h"
 #include <IOKit/kext/kextmanager_types.h>
 #endif
@@ -78,7 +80,7 @@
 #ifndef __APPLE__
 static u_int get_pageins(void);
 #endif
-#if defined(__APPLE__) && !(TARGET_OS_IPHONE && !TARGET_OS_SIMULATOR)
+#if defined(__APPLE__) && ND_KEXTD
 static int reserve_reboot(void);
 #endif
 
@@ -183,7 +185,7 @@
 	}
 
 
-#if defined(__APPLE__) && !(TARGET_OS_IPHONE && !TARGET_OS_SIMULATOR)
+#if defined(__APPLE__) && ND_KEXTD
 	if (!qflag && !lflag) {	// shutdown(8) has already checked w/kextd
 		if ((errno = reserve_reboot()))
 			err(1, "couldn't lock for reboot");
@@ -316,7 +318,8 @@
 
 #ifdef __APPLE__
 	// launchd(8) handles reboot.  This call returns NULL on success.
-	exit(reboot3(howto) == 0 ? EXIT_SUCCESS : EXIT_FAILURE);
+	// NeoDarwin: launchd-842's reboot2(), which predates reboot3().
+	exit(reboot2(howto) == NULL ? EXIT_SUCCESS : EXIT_FAILURE);
 #else /* !__APPLE__ */
 	reboot(howto);
 	/* FALLTHROUGH */
@@ -362,7 +365,7 @@
 }
 #endif
 
-#if defined(__APPLE__) && !(TARGET_OS_IPHONE && !TARGET_OS_SIMULATOR)
+#if defined(__APPLE__) && ND_KEXTD
 // XX this routine is also in shutdown; it would be nice to share
 
 static bool
