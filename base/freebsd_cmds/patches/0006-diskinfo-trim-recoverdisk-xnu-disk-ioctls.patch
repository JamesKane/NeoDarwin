 #include <sys/time.h>
+#include "nd_disk.h"
 
+/*
+ * NeoDarwin: xnu has no GEOM. The sizes come from its DKIOC ioctls
+ * (compat/nd_disk.c); GEOM's descr, ident, attachment, rotation-rate and
+ * zone attributes and the firmware geometry have no counterpart, and
+ * there is no aio_waitcomplete(2) for -i and -S.
+ */
+#define	DISK_IDENT_SIZE	256
+
+static ssize_t
+aio_waitcomplete(struct aiocb **iocbp __unused, struct timespec *timeout __unused)
+{
+	errno = ENOSYS;
+	return (-1);
+}
+
 #define	NAIO	128
 #define	MAXTX	(8*1024*1024)
 #define	MEGATX	(1024*1024)
