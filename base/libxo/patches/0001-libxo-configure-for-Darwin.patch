From: NeoDarwin
Subject: [PATCH] libxo: configure for Darwin

lib/libxo/libxo/xo_config.h is the configure result for FreeBSD. On Darwin
there is no __isthreaded, no dlfunc(3) (encoders load with dlsym) and no
<threads.h> (__thread works through dyld's thread-local variables). Apple's
libxo links libSystem alone, so humanize_number comes from libxo's own
xo_humanize.h rather than libutil.

Rebase-risk: low (five configure results).
---
diff --git a/lib/libxo/libxo/xo_config.h b/lib/libxo/libxo/xo_config.h
--- a/lib/libxo/libxo/xo_config.h
+++ b/lib/libxo/libxo/xo_config.h
@@ -30,13 +30,13 @@
 
 /* Define to 1 if you have the declaration of `__isthreaded', and to 0 if you
    don't. */
-#define HAVE_DECL___ISTHREADED 1
+#define HAVE_DECL___ISTHREADED 0
 
 /* Define to 1 if you have the <dlfcn.h> header file. */
 #define HAVE_DLFCN_H 1
 
 /* Define to 1 if you have the `dlfunc' function. */
-#define HAVE_DLFUNC 1
+/* #undef HAVE_DLFUNC */
 
 /* Define to 1 if you have the <errno.h> header file. */
 #define HAVE_ERRNO_H 1
@@ -66,7 +66,7 @@
 #define HAVE_GETTIMEOFDAY 1
 
 /* humanize_number(3) */
-#define HAVE_HUMANIZE_NUMBER 1
+/* #undef HAVE_HUMANIZE_NUMBER */
 
 /* Define to 1 if you have the <inttypes.h> header file. */
 #define HAVE_INTTYPES_H 1
@@ -78,7 +78,7 @@
 #define HAVE_LIBM 1
 
 /* Define to 1 if you have the <libutil.h> header file. */
-#define HAVE_LIBUTIL_H 1
+/* #undef HAVE_LIBUTIL_H */
 
 /* Define to 1 if your system has a GNU libc compatible `malloc' function, and
    to 0 otherwise. */
@@ -164,7 +164,7 @@
 #define HAVE_SYS_TYPES_H 1
 
 /* Define to 1 if you have the <threads.h> header file. */
-#define HAVE_THREADS_H 1
+/* #undef HAVE_THREADS_H */
 
 /* thread-local setting */
 #define HAVE_THREAD_LOCAL THREAD_LOCAL_before
