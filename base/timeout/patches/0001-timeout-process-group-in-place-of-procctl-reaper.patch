From: NeoDarwin
Subject: [PATCH] timeout: a process group in place of procctl(2)'s reaper

FreeBSD's timeout makes itself a reaper (procctl(2) PROC_REAP_ACQUIRE) so
that, without --foreground, the signal reaches the command's descendants
(PROC_REAP_KILL) and it waits for all of them (PROC_REAP_STATUS). Darwin has
no reaper. Under __APPLE__ the command runs in a process group of its own
(setpgid(2) in the child and the parent, whichever runs first), signals go
to that group with killpg(2), and timeout returns once the command itself
has exited, as FreeBSD's did before the reaper (and GNU timeout does). A
descendant that leaves the group isn't signalled. pipe2(2), str2sig(3) and
sys_nsig, which Darwin's libc lacks, are local: pipe(2) with FD_CLOEXEC set
by fcntl(2), a lookup in sys_signame, and NSIG.
Rebase-risk: medium (main()'s reaper calls move with FreeBSD's changes).

--- a/timeout.c
+++ b/timeout.c
@@ -26,7 +26,9 @@
  * THIS SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.
  */
 
+#ifndef __APPLE__
 #include <sys/procctl.h>
+#endif
 #include <sys/resource.h>
 #include <sys/time.h>
 #include <sys/wait.h>
@@ -164,10 +166,64 @@
 	}
 }
 
+#ifdef __APPLE__
+/*
+ * Darwin has no reaper (procctl(2)): without --foreground the command runs
+ * in a process group of its own, and signals go to that group, which
+ * reaches its descendants unless they leave it.
+ */
+#define	sys_nsig	NSIG
+#define	pipe2		nd_pipe2
+#define	str2sig		nd_str2sig
+
+static int
+pipe2(int fd[2], int flags)
+{
+	if (pipe(fd) < 0)
+		return (-1);
+	if ((flags & O_CLOEXEC) != 0 &&
+	    (fcntl(fd[0], F_SETFD, FD_CLOEXEC) < 0 ||
+	    fcntl(fd[1], F_SETFD, FD_CLOEXEC) < 0)) {
+		close(fd[0]);
+		close(fd[1]);
+		return (-1);
+	}
+	return (0);
+}
+
+/* str2sig(3): a signal's number, or its name with or without "SIG". */
+static int
+str2sig(const char *str, int *signum)
+{
+	char *end;
+	long n;
+	int i;
+
+	if (*str >= '0' && *str <= '9') {
+		n = strtol(str, &end, 10);
+		if (*end != '\0' || n < 0 || n >= NSIG)
+			return (-1);
+		*signum = (int)n;
+		return (0);
+	}
+	if (strncasecmp(str, "SIG", 3) == 0)
+		str += 3;
+	for (i = 1; i < NSIG; i++) {
+		if (strcasecmp(str, sys_signame[i]) == 0) {
+			*signum = i;
+			return (0);
+		}
+	}
+	return (-1);
+}
+#endif /* __APPLE__ */
+
 static void
 send_sig(pid_t pid, int signo, bool foreground)
 {
+#ifndef __APPLE__
 	struct procctl_reaper_kill rk;
+#endif
 
