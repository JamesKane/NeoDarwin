From: NeoDarwin
Subject: [PATCH] dhclient-script: Darwin's ifconfig, NeoDarwin's resolv.conf

Darwin's ifconfig has no -n (FreeBSD's "don't load modules"), and the base
has no arp yet (network_cmds' arp is P4-24's): the flush is skipped without
it. FreeBSD hands the name servers to resolvconf(8), which NeoDarwin
doesn't have. The new default, resolvconf_enable=NEODARWIN, does what macOS
does: /etc/resolv.conf is a link to /var/run/resolv.conf, the script
replaces that file (RESOLV_CONF) and tells mDNSResponder, which answers
every lookup (Libinfo's mdns module) and reads it at start and on SIGHUP
(its pid file, /var/run/mDNSResponder.pid). An expired lease removes it.
The other settings of resolvconf_enable keep FreeBSD's behaviour. Looking
for the default route before there is one, Darwin's route prints "not in
table" on standard error, which now reaches the log; it is discarded.

Rebase-risk: low (one variable, one new case, two helpers).
--- a/dhclient-script
+++ b/dhclient-script
@@ -20,7 +20,7 @@
 
 ARP=/usr/sbin/arp
 HOSTNAME=/bin/hostname
-IFCONFIG='/sbin/ifconfig -n'
+IFCONFIG='/sbin/ifconfig'
 
 LOCALHOST=127.0.0.1
 
@@ -47,7 +47,8 @@
 }
 
 arp_flush() {
-	arp -an -i $interface | \
+	[ -x $ARP ] || return 0
+	$ARP -an -i $interface | \
 		sed -n -e 's/^.*(\(.*\)) at .*$/arp -d \1/p' | \
 		sh >/dev/null 2>&1
 }
@@ -201,7 +202,7 @@
 	# thus broke the script. This code creates the resolv.conf if either
 	# are provided.
 
-	local tmpres=/var/run/resolv.conf.${interface}
+	local tmpres=/var/run/resolv.conf.${interface}.new
 	rm -f $tmpres
 
 	if [ -n "$new_domain_search" ]; then
@@ -222,6 +223,15 @@
 		fi
 
 		case $resolvconf_enable in
+		# NeoDarwin, as macOS: /etc/resolv.conf is a link to
+		# /var/run/resolv.conf, which the DHCP client writes;
+		# mDNSResponder reads it again when signalled.
+		[Nn][Ee][Oo][Dd][Aa][Rr][Ww][Ii][Nn])
+			chmod 644 $tmpres
+			mv -f $tmpres $RESOLV_CONF
+			mdnsresponder_reconfigure
+			return 0
+			;;
 		# "no", "false", "off", or "0"
 		[Nn][Oo]|[Ff][Aa][Ll][Ss][Ee]|[Oo][Ff][Ff]|0)
 			# When resolv.conf is not changed actually, we don't
@@ -262,6 +272,13 @@
 	return 1
 }
 
+# mDNSResponder (the POSIX daemon) reads resolv.conf at start and on SIGHUP.
+mdnsresponder_reconfigure() {
+	if [ -f /var/run/mDNSResponder.pid ]; then
+		kill -HUP `cat /var/run/mDNSResponder.pid` >/dev/null 2>&1
+	fi
+}
+
 # Must be used on exit.   Invokes the local dhcp client exit hooks, if any.
 exit_with_hooks() {
 	exit_status=$1
@@ -276,7 +293,7 @@
 # commands that are available prior to /usr being mounted.
 is_default_interface()
 {
-	routeget="`route -n get -inet default`"
+	routeget="`route -n get -inet default 2>/dev/null`"
 	oldifs="$IFS"
 	IFS="
 "
@@ -312,7 +329,8 @@
 	fi
 fi
 
-: ${resolvconf_enable="YES"}
+: ${resolvconf_enable="NEODARWIN"}
+: ${RESOLV_CONF=/var/run/resolv.conf}
 
 case $reason in
 MEDIUM)
@@ -373,6 +391,10 @@
 				cat /etc/resolv.conf.save > /etc/resolv.conf
 			fi
 			;;
+		[Nn][Ee][Oo][Dd][Aa][Rr][Ww][Ii][Nn])
+			rm -f $RESOLV_CONF
+			mdnsresponder_reconfigure
+			;;
 		*)
 			/sbin/resolvconf -d ${interface}
 			;;
