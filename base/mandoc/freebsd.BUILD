# BUILD file for @freebsd_mandoc: FreeBSD's contrib/mandoc and usr.bin/soelim, pinned by
# freebsd.lock. base/mandoc/build.sh compiles them; this only exposes them.
package(default_visibility = ["//visibility:public"])

filegroup(
    name = "all",
    srcs = glob(["**"], exclude = ["BUILD.bazel"]),
)
