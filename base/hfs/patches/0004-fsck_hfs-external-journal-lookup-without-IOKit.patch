From: NeoDarwin
Subject: [PATCH] fsck_hfs: no external journal lookup without IOKit (HFS_NO_FRAMEWORKS)

OpenDeviceByUUID() finds a journal on another device by matching IOMedia
UUIDs through IOKit, which NeoDarwin's userland doesn't have. With
HFS_NO_FRAMEWORKS it returns -1, as when no device matches: a volume whose
journal is on another device is checked as one whose journal device is
missing. Journals inside the volume, the only kind newfs_hfs makes by
default, are unaffected. Without the switch nothing changes.

Rebase-risk: low (the function wrapped).
---
diff --git a/lib_fsck_hfs/dfalib/uuid.c b/lib_fsck_hfs/dfalib/uuid.c
--- a/lib_fsck_hfs/dfalib/uuid.c
+++ b/lib_fsck_hfs/dfalib/uuid.c
@@ -4,9 +4,11 @@
 #include <string.h>
 #include <sys/mount.h>
 #include <uuid/uuid.h>
+#if !HFS_NO_FRAMEWORKS
 #include <IOKit/IOBSD.h>
 #include <IOKit/IOKitLib.h>
 #include <IOKit/storage/IOMedia.h>
+#endif
 
 #include "check.h"
 
@@ -20,9 +22,18 @@
  *
  * It returns the file descriptor, or -1 on error.
  */
+#if HFS_NO_FRAMEWORKS
+/* No IOKit to find the IOMedia by its UUID: no external journal device. */
 int
 OpenDeviceByUUID(void *uuidp, char **namep)
 {
+    (void)uuidp; (void)namep;
+    return -1;
+}
+#else
+int
+OpenDeviceByUUID(void *uuidp, char **namep)
+{
     char devname[ MAXPATHLEN ];
     CFStringRef devname_string;
     int fd = -1;
@@ -62,3 +73,4 @@
 
     return fd;
 }
+#endif /* HFS_NO_FRAMEWORKS */
