load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//rules:swift.bzl", "nd_swift_binary")

package(default_visibility = ["//visibility:public"])

# dtdump: neoboot's ACPI parser, device-tree synthesis and DT-ABI check,
# compiled for the host from the same sources (docs/kernel/dt-abi.md).
nd_swift_binary(
    name = "dtdump",
    srcs = [
        "AcpiDump.swift",
        "main.swift",
        "//boot/neoboot:portable_srcs",
    ],
)

# QEMU virt's tables, captured with neoboot's dump-acpi option: the tree
# must pass DT-ABI v1 and match the reviewed output byte for byte.
sh_test(
    name = "qemu_virt_smp1_test",
    size = "small",
    srcs = ["dtdump_test.sh"],
    args = [
        "ok",
        "$(rootpath :dtdump)",
        "$(rootpath //boot/neoboot:testdata/qemu-virt-smp1.acpidump)",
        "$(rootpath testdata/qemu-virt-smp1.txt)",
    ],
    data = [
        ":dtdump",
        "testdata/qemu-virt-smp1.txt",
        "//boot/neoboot:testdata/qemu-virt-smp1.acpidump",
    ],
)

sh_test(
    name = "qemu_virt_smp4_test",
    size = "small",
    srcs = ["dtdump_test.sh"],
    args = [
        "ok",
        "$(rootpath :dtdump)",
        "$(rootpath //boot/neoboot:testdata/qemu-virt-smp4.acpidump)",
        "$(rootpath testdata/qemu-virt-smp4.txt)",
    ],
    data = [
        ":dtdump",
        "testdata/qemu-virt-smp4.txt",
        "//boot/neoboot:testdata/qemu-virt-smp4.acpidump",
    ],
)

# A distributor with two security states (GICD_CTLR.DS reads 0 from the
# Non-secure side, as under TrustZone firmware): the timer goes on Group 1.
sh_test(
    name = "qemu_virt_smp1_ds0_test",
    size = "small",
    srcs = ["dtdump_test.sh"],
    args = [
        "ok",
        "$(rootpath :dtdump)",
        "$(rootpath //boot/neoboot:testdata/qemu-virt-smp1.acpidump)",
        "$(rootpath testdata/qemu-virt-smp1-ds0.txt)",
        "--gicd-ctlr",
        "0x12",
    ],
    data = [
        ":dtdump",
        "testdata/qemu-virt-smp1-ds0.txt",
        "//boot/neoboot:testdata/qemu-virt-smp1.acpidump",
    ],
)

# QEMU virt with TF-A at EL3 and four CPUs (--machine virt-secure,
# docs/kernel/qemu-secure.md): the FADT reports no PSCI, since QEMU turns its
# own off, but the CPU implements EL3, so the PSCI conduit is SMC (P1-06).
sh_test(
    name = "qemu_virt_secure_smp4_test",
    size = "small",
    srcs = ["dtdump_test.sh"],
    args = [
        "ok",
        "$(rootpath :dtdump)",
        "$(rootpath //boot/neoboot:testdata/qemu-virt-secure-smp4.acpidump)",
        "$(rootpath testdata/qemu-virt-secure-smp4.txt)",
        "--gicd-ctlr",
        "0x12",
        "--el3",
    ],
    data = [
        ":dtdump",
        "testdata/qemu-virt-secure-smp4.txt",
        "//boot/neoboot:testdata/qemu-virt-secure-smp4.acpidump",
    ],
)

# QEMU sbsa-ref with four CPUs (--machine sbsa-ref, docs/kernel/qemu-sbsa-ref.md),
# captured with dump-acpi under TF-A and EDK2 SbsaQemu: tables from SbsaQemu's
# own ASL (OEM LINARO SBSAQEMU), not QEMU's generator. DRAM at 1 TiB, GICD at
# 0x40060000 with 64 MiB of redistributor space, PL011 at 0x60000000, PSCI
# over SMC as the FADT says, a 1 GHz counter; UEFI runs at EL2, and GICD_CTLR
# reads DS=0, so the timer goes on Group 1.
sh_test(
    name = "qemu_sbsa_ref_smp4_test",
    size = "small",
    srcs = ["dtdump_test.sh"],
    args = [
        "ok",
        "$(rootpath :dtdump)",
        "$(rootpath //boot/neoboot:testdata/qemu-sbsa-ref-smp4.acpidump)",
        "$(rootpath testdata/qemu-sbsa-ref-smp4.txt)",
        "--dram-base",
        "0x10000000000",
        "--dram-size",
        "0x7d7fc000",
        "--timebase",
        "1000000000",
        "--gicd-ctlr",
        "0x12",
        "--loader-el",
        "2",
    ],
    data = [
        ":dtdump",
        "testdata/qemu-sbsa-ref-smp4.txt",
        "//boot/neoboot:testdata/qemu-sbsa-ref-smp4.acpidump",
    ],
)

# Negative: a MADT cut short in the dump must be refused, not half-read.
sh_test(
    name = "truncated_madt_test",
    size = "small",
    srcs = ["dtdump_test.sh"],
    args = [
        "fail",
        "$(rootpath :dtdump)",
        "$(rootpath //boot/neoboot:testdata/qemu-virt-truncated-madt.acpidump)",
        "'ACPI: table truncated at [APIC]'",
    ],
    data = [
        ":dtdump",
        "//boot/neoboot:testdata/qemu-virt-truncated-madt.acpidump",
    ],
)

# Negative: a tree whose console phandle names no node must fail the check.
sh_test(
    name = "broken_tree_test",
    size = "small",
    srcs = ["dtdump_test.sh"],
    args = [
        "broken-tree",
        "$(rootpath :dtdump)",
        "$(rootpath //boot/neoboot:testdata/qemu-virt-smp1.acpidump)",
        "'DT-ABI v1 violation: /defaults serial-device names no node; phandle 0x9'",
    ],
    data = [
        ":dtdump",
        "//boot/neoboot:testdata/qemu-virt-smp1.acpidump",
    ],
)

# QEMU virt with 18 cortex-a76 CPUs, captured with dump-acpi: QEMU numbers 16
# CPUs per MPIDR Aff1, so cpu16 and cpu17 are 0x100 and 0x101, the DynamIQ
# form (core in Aff1) of the Radxa Dragon Q8B. Their reg keeps Aff1, and every
# cpu is in the one cluster (die-cluster-id 0, cluster-core-id = index; P1-17).
sh_test(
    name = "qemu_virt_a76_smp18_test",
    size = "small",
    srcs = ["dtdump_test.sh"],
    args = [
        "ok",
        "$(rootpath :dtdump)",
        "$(rootpath //boot/neoboot:testdata/qemu-virt-a76-smp18.acpidump)",
        "$(rootpath testdata/qemu-virt-a76-smp18.txt)",
    ],
    data = [
        ":dtdump",
        "testdata/qemu-virt-a76-smp18.txt",
        "//boot/neoboot:testdata/qemu-virt-a76-smp18.acpidump",
    ],
)

# Negative: the four-CPU tables with MPIDR Aff3 = 1 on the last GICC (the
# checksum fixed up). The kernel's CPU id is Aff2:Aff1:Aff0, so neoboot refuses.
sh_test(
    name = "mpidr_aff3_test",
    size = "small",
    srcs = ["dtdump_test.sh"],
    args = [
        "fail",
        "$(rootpath :dtdump)",
        "$(rootpath //boot/neoboot:testdata/qemu-virt-aff3.acpidump)",
        "'GICC MPIDR has a non-zero Aff3'",
    ],
    data = [
        ":dtdump",
        "//boot/neoboot:testdata/qemu-virt-aff3.acpidump",
    ],
)

# The single-CPU tables with the SPCR rewritten as the Radxa Dragon Q8B's:
# interface type 0x13, a Qualcomm GENI UART, at 0x884000 (the checksum fixed
# up). The kernel has no driver for it until P1-12. Without a framebuffer
# neoboot refuses; with one (--gop, as boot_args.Video) the tree leaves the
# UART out and the kernel's console is the framebuffer (DT-ABI v1.1).
sh_test(
    name = "spcr_geni_no_gop_test",
    size = "small",
    srcs = ["dtdump_test.sh"],
    args = [
        "fail",
        "$(rootpath :dtdump)",
        "$(rootpath //boot/neoboot:testdata/qemu-virt-spcr-geni.acpidump)",
        "'ACPI: SPCR names a UART the kernel has no driver for; interface type [SPCR] 0x13'",
    ],
    data = [
        ":dtdump",
        "//boot/neoboot:testdata/qemu-virt-spcr-geni.acpidump",
    ],
)

sh_test(
    name = "spcr_geni_gop_test",
    size = "small",
    srcs = ["dtdump_test.sh"],
    args = [
        "ok",
        "$(rootpath :dtdump)",
        "$(rootpath //boot/neoboot:testdata/qemu-virt-spcr-geni.acpidump)",
        "$(rootpath testdata/qemu-virt-spcr-geni-gop.txt)",
        "--gop",
        "1920x1080",
    ],
    data = [
        ":dtdump",
        "testdata/qemu-virt-spcr-geni-gop.txt",
        "//boot/neoboot:testdata/qemu-virt-spcr-geni.acpidump",
    ],
)

# Negative: that UART-less tree is DT-ABI v1.1 only with a framebuffer.
sh_test(
    name = "spcr_geni_tree_needs_gop_test",
    size = "small",
    srcs = ["dtdump_test.sh"],
    args = [
        "needs-gop",
        "$(rootpath :dtdump)",
        "$(rootpath //boot/neoboot:testdata/qemu-virt-spcr-geni.acpidump)",
        "'DT-ABI v1 violation: no /defaults serial-device and no framebuffer in boot_args (the kernel would have no console)'",
    ],
    data = [
        ":dtdump",
        "//boot/neoboot:testdata/qemu-virt-spcr-geni.acpidump",
    ],
)

# The Radxa Dragon Q8B's own tables (boot/neoboot/testdata/radxa-dragon-q8b.md):
# eight DynamIQ CPUs, MPIDR 0x000-0x700, in one cluster; GICv3 with eight
# 128 KiB redistributor frames; the virtual timer on PPI 27; PSCI over SMC,
# as the FADT says. Its SPCR UART is a Qualcomm GENI (type 0x13), so neoboot
# refuses the board without a framebuffer and, with one, boots it with no
# UART in the tree. The counter runs at 19.2 MHz. GICD_CTLR is not in the
# tables; the default (DS=1) is QEMU's, and the board's is still to read.
sh_test(
    name = "radxa_dragon_q8b_no_gop_test",
    size = "small",
    srcs = ["dtdump_test.sh"],
    args = [
        "fail",
        "$(rootpath :dtdump)",
        "$(rootpath //boot/neoboot:testdata/radxa-dragon-q8b.acpidump)",
        "'ACPI: SPCR names a UART the kernel has no driver for; interface type [SPCR] 0x13'",
    ],
    data = [
        ":dtdump",
        "//boot/neoboot:testdata/radxa-dragon-q8b.acpidump",
    ],
)

sh_test(
    name = "radxa_dragon_q8b_gop_test",
    size = "small",
    srcs = ["dtdump_test.sh"],
    args = [
        "ok",
        "$(rootpath :dtdump)",
        "$(rootpath //boot/neoboot:testdata/radxa-dragon-q8b.acpidump)",
        "$(rootpath testdata/radxa-dragon-q8b-gop.txt)",
        "--gop",
        "1920x1080",
        "--timebase",
        "19200000",
    ],
    data = [
        ":dtdump",
        "testdata/radxa-dragon-q8b-gop.txt",
        "//boot/neoboot:testdata/radxa-dragon-q8b.acpidump",
    ],
)
