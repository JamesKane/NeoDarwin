        "--gop",
        "1920x1080",
        "--uart-off",
        "--timebase",
        "19200000",
    ],
    data = [
        ":dtdump",
        "testdata/radxa-dragon-q8b-uart-off-gop.txt",
        "//boot/neoboot:testdata/radxa-dragon-q8b.acpidump",
    ],
)

sh_test(
    name = "radxa_dragon_q8b_uart_off_no_gop_test",
    size = "small",
    srcs = ["dtdump_test.sh"],
    args = [
        "fail",
        "$(rootpath :dtdump)",
        "$(rootpath //boot/neoboot:testdata/radxa-dragon-q8b.acpidump)",
