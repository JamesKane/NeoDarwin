# SPDX-License-Identifier: BSD-2-Clause
# Compile checks for the kernel scheduling contract (docs/kernel/scheduling-contract.md,
# spec-conventions.md §1): the header builds as a freestanding C23 library, and a test
# static_asserts every record layout (SC-T-001).

load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//rules:cc.bzl", "ND_C_COPTS", "lang_audit_test", "nd_cc_library")

exports_files(["scheduling-contract.md"])

nd_cc_library(
    name = "nd_sched",
    hdrs = ["nd_sched.h"],
    visibility = ["//visibility:public"],
)

cc_test(
    name = "nd_sched_layout_test",
    size = "small",
    srcs = ["nd_sched_layout.c"],
    copts = ND_C_COPTS + [
        "-Wpedantic",
        "-ffreestanding",
    ],
    deps = [":nd_sched"],
)

lang_audit_test(
    name = "nd_sched_layout_lang_audit",
    srcs = ["nd_sched_layout.c"],
)

# nd_sched.h must also compile as C++20 (spec-conventions.md §5). nd_cc_library
# fixes -std=c23, so this is a plain cc_library with the same warning policy,
# and its source is audited by hand below.
cc_library(
    name = "nd_sched_cxx",
    srcs = ["nd_sched_cxx.cpp"],
    copts = [
        "-std=c++20",
        "-Wall",
        "-Wextra",
        "-Werror",
        "-pedantic",
    ],
    deps = [":nd_sched"],
)

lang_audit_test(
    name = "nd_sched_cxx_lang_audit",
    srcs = ["nd_sched_cxx.cpp"],
)
