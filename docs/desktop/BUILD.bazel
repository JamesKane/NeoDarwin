# Compile checks for the desktop specification headers (spec-conventions.md §1, §5).
#
# Built here: desktop.h (the window protocol) and the toolkit API (ndtk.h, the
# NDToolkit.swift interface and its conformance script). style.h and
# agent.h are deliberately NOT built: they are unchanged reference copies
# from the plan-neo pilot (theme-engine.md, agent-protocol.md), not yet
# revised to the conventions, and adding them is the job of the epics that
# revise those specifications.

load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//rules:cc.bzl", "lang_audit_test", "nd_cc_library")
load("//rules:swift.bzl", "nd_swift_library")

# The window protocol header, version 2. Its lang_audit test checks the
# justification line.
nd_cc_library(
    name = "desktop",
    hdrs = ["desktop.h"],
    visibility = ["//visibility:public"],
)

# Includes desktop.h and static_asserts the size of every wire record and
# the offset of every field (WP-T-058). It also holds a main() that round-
# trips the pack and unpack helpers, run by the test below (WP-T-059).
nd_cc_library(
    name = "desktop_layout",
    srcs = ["desktop_layout.c"],
    deps = [":desktop"],
)

cc_test(
    name = "desktop_layout_test",
    size = "small",
    deps = [":desktop_layout"],
)

# desktop.h must also compile as C++ (C++ clients: SDL backends, Qt, Dawn,
# engines), which holds for every spec header. nd_cc_library fixes
# -std=c23, so this is a plain cc_library with the same warning policy,
# audited by hand (WP-T-152).
cc_library(
    name = "desktop_cxx",
    srcs = ["desktop_cxx.cpp"],
    copts = ["-std=c++20", "-Wall", "-Wextra", "-Werror", "-pedantic"],
    deps = [":desktop"],
)

lang_audit_test(
    name = "desktop_cxx_lang_audit",
    srcs = ["desktop_cxx.cpp"],
)

# ---------------------------------------------------------------------------
# The toolkit API (toolkit-api.md, prefix TK; epic P4-12): ndtk.h, the C ABI,
# and NDToolkit.swift, the Swift interface (spec-conventions.md §1, §5, §6).

# The C ABI header; its lang_audit test checks the justification line.
nd_cc_library(
    name = "ndtk",
    hdrs = ["ndtk.h"],
    visibility = ["//visibility:public"],
)

# Every record size and field offset, every enum width, and every constant
# the text says equals a window-protocol or scheduling-contract value, as
# C23 with -Wpedantic; main() round-trips the handle accessors (TK-T-001).
cc_test(
    name = "ndtk_layout_test",
    size = "small",
    srcs = ["ndtk_layout.c"],
    copts = ["-std=c23", "-Wall", "-Wextra", "-Werror", "-Wpedantic"],
    deps = [
        ":desktop",
        ":ndtk",
        "//docs/kernel:nd_sched",
    ],
)

lang_audit_test(
    name = "ndtk_layout_lang_audit",
    srcs = ["ndtk_layout.c"],
)

# ndtk.h as C++20 (TK-T-002); a plain cc_library for the same reason as
# desktop_cxx above, audited by hand.
cc_library(
    name = "ndtk_cxx",
    srcs = ["ndtk_cxx.cpp"],
    copts = ["-std=c++20", "-Wall", "-Wextra", "-Werror", "-pedantic"],
    deps = [":ndtk"],
)

lang_audit_test(
    name = "ndtk_cxx_lang_audit",
    srcs = ["ndtk_cxx.cpp"],
)

# The Swift interface, type-checked in Swift 6 with warnings as errors, and
# the S7 minimal program written against it (TK-T-003, TK-T-060). Never
# linked into a product.
nd_swift_library(
    name = "ndtoolkit_interface",
    srcs = [
        "NDToolkit.swift",
        "NDToolkitMinimal.swift",
    ],
    module_name = "NDToolkit",
)

# spec-conventions.md §3, §4.8 and §7 over toolkit-api.md: every MUST has an
# id and a test, ids are unique, and every WP and AU id the text cites exists
# in the lower specification (TK-T-004), including SC ids from
# docs/kernel:scheduling-contract.md.
sh_test(
    name = "toolkit_conformance_test",
    size = "small",
    srcs = ["toolkit_conformance_test.sh"],
    args = [
        "$(rootpath toolkit-api.md)",
        "WP=$(rootpath window-protocol.md)",
        "AU=$(rootpath //docs/audio:audio-service.md)",
        "SC=$(rootpath //docs/kernel:scheduling-contract.md)",
    ],
    data = [
        "toolkit-api.md",
        "window-protocol.md",
        "//docs/audio:audio-service.md",
        "//docs/kernel:scheduling-contract.md",
    ],
)
