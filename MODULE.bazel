# Apple's IOStorageFamily (IOStorageFamily-331, the macOS 26.0 release; APSL
# 2.0): block storage, IOMedia, the partition schemes and /dev/disk nodes,
# built into the SBSA kernel (kernel/neodarwin/storage, docs/kernel/storage.md).
# The headers are overlaid at iokit/ndstorage/include/IOKit/storage, where
# kext code finds them in the SDK. IOUserBlockStorageDevice (DriverKit), IORequest and
# IORequestsPool are left out: there is no DriverKit.
http_archive(
    name = "apple_iostoragefamily",
    build_file_content = """filegroup(
    name = "kernel_srcs",
    srcs = [
        "IOAppleLabelScheme.cpp",
        "IOApplePartitionScheme.cpp",
        "IOBlockStorageDevice.cpp",
        "IOBlockStorageDriver.cpp",
        "IOFDiskPartitionScheme.cpp",
        "IOFilterScheme.cpp",
        "IOGUIDPartitionScheme.cpp",
        "IOMedia.cpp",
        "IOMediaBSDClient.cpp",
        "IOPartitionScheme.cpp",
        "IOStorage.cpp",
    ],
    visibility = ["//visibility:public"],
)
filegroup(
    name = "headers",
    srcs = glob(["*.h"], exclude = ["IORequest.h", "IORequestsPool.h", "IOUserBlockStorageDevice_kext.h"]),
