# TrustZone firmware for QEMU virt,secure=on (docs/kernel/qemu-secure.md):
# TF-A at EL3 with EDK2's ArmVirtQemuKernel as BL33, built from these pinned
# sources by //third_party/qemu_firmware. TF-A is BSD-3-Clause, EDK2
# BSD-2-Clause-Patent; OpenSSL (Apache-2.0), Brotli (MIT) and libfdt
# (dual BSD-2-Clause/GPL-2.0) are the EDK2 submodules this platform compiles, at the
# commits edk2-stable202608 records.
_SRC_FILES = """filegroup(name = "all", srcs = glob(["**"], exclude = {exclude}), visibility = ["//visibility:public"])
exports_files(["{anchor}"])"""

http_archive(
    name = "arm_tf_a",
    build_file_content = _SRC_FILES.format(anchor = "Makefile", exclude = '["docs/**"]'),
