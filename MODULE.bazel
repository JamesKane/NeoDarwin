        "IOFilterScheme.cpp",
        "IOGUIDPartitionScheme.cpp",
        "IOMedia.cpp",
        "IOMediaBSDClient.cpp",
        "IOPartitionScheme.cpp",
        "IOStorage.cpp",
    ],
    visibility = ["//visibility:public"],
)
filegroup(
    name = "headers",
    srcs = glob(["*.h"], exclude = ["IORequest.h", "IORequestsPool.h", "IOUserBlockStorageDevice_kext.h"]),
    visibility = ["//visibility:public"],
)""",
    sha256 = "3b0bfb7a9b0170fb8f8cf4018813eadaa9be4491b3a79e7ac346ee4736fd646d",
    strip_prefix = "IOStorageFamily-IOStorageFamily-331",
