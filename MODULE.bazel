"""NeoDarwin: OpenDarwin rebuilt on XNU and Apple's open source."""

module(
    name = "neodarwin",
    version = "0.0.0",
    compatibility_level = 0,
)

# Pins are exact; bump deliberately (docs/architecture/build-system.md §2).
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "rules_cc", version = "0.2.25")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "apple_support", version = "2.9.1")
bazel_dep(name = "rules_swift", version = "4.1.2")

# ---------------------------------------------------------------------------
# Upstream Apple open source (docs/repository.md §3). The macOS 26.0 release
# set: distribution-macOS macos-260/release.json. Mirrors replace these URLs
# when mirror-* repositories exist (P0-01); hashes stay.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

_ALL_FILES = """filegroup(name = "all", srcs = glob(["**"]), visibility = ["//visibility:public"])"""

http_archive(
    name = "apple_xnu",
    build_file_content = _ALL_FILES,
    sha256 = "de41f52730e41c844c95e8172de02c1fcf2eb35e95343a4a12aaf7518fb4bf17",
    strip_prefix = "xnu-xnu-12377.1.9",
    urls = ["https://github.com/apple-oss-distributions/xnu/archive/refs/tags/xnu-12377.1.9.tar.gz"],
)

http_archive(
    name = "apple_availability_versions",
    build_file_content = _ALL_FILES,
    sha256 = "4116d620072474fdf58046393c55e534bb15e6c66719c430c387652fde4db6c5",
    strip_prefix = "AvailabilityVersions-AvailabilityVersions-155",
    urls = ["https://github.com/apple-oss-distributions/AvailabilityVersions/archive/refs/tags/AvailabilityVersions-155.tar.gz"],
)

http_archive(
    name = "apple_libdispatch",
    build_file_content = _ALL_FILES,
    sha256 = "e33dc6ebc77d543afb989dd6f0f318f9bf2bbc17f58704cba9b7a147a5c50bc2",
    strip_prefix = "libdispatch-libdispatch-1542.0.4",
    urls = ["https://github.com/apple-oss-distributions/libdispatch/archive/refs/tags/libdispatch-1542.0.4.tar.gz"],
)

# pthread's kernel half (kern/), built into the SBSA kernel (kernel/neodarwin/pthread).
http_archive(
    name = "apple_libpthread",
    build_file_content = """filegroup(
    name = "kernel_srcs",
    srcs = glob(["kern/*", "private/**", "include/**"]),
    visibility = ["//visibility:public"],
)""",
    sha256 = "a9786dd16427812da39bcb330b786f5e9d95a40e55d9540df14fffe200b724b7",
    strip_prefix = "libpthread-libpthread-539",
    urls = ["https://github.com/apple-oss-distributions/libpthread/archive/refs/tags/libpthread-539.tar.gz"],
)

# Apple's HFS+ (hfs-704.0.3.0.2, the macOS 26.0 release; APSL): the hfs and
# HFSEncodings kexts' sources, built into the SBSA kernel (kernel/neodarwin/hfs).
http_archive(
    name = "apple_hfs",
    build_file_content = """filegroup(
    name = "kernel_srcs",
    srcs = glob(["core/*.c", "core/*.cpp", "core/*.h", "hfs_encodings/*.c", "hfs_encodings/*.h"]),
    visibility = ["//visibility:public"],
)""",
    sha256 = "95e2508b9f38091f505111fd2154c97c8b1b13a8f01f0b61a1353b0fcfb80958",
    strip_prefix = "hfs-hfs-704.0.3.0.2",
    urls = ["https://github.com/apple-oss-distributions/hfs/archive/refs/tags/hfs-704.0.3.0.2.tar.gz"],
)

# xnu's corecrypto subset and headers, for ndcrypto's host tests: the same
# archive as apple_xnu (the repository cache serves it once), with its own
# BUILD file so the kernel's inputs are untouched.
http_archive(
    name = "apple_xnu_corecrypto",
    build_file = "//kernel/neodarwin/crypto:xnu_corecrypto.BUILD",
    sha256 = "de41f52730e41c844c95e8172de02c1fcf2eb35e95343a4a12aaf7518fb4bf17",
    strip_prefix = "xnu-xnu-12377.1.9",
    urls = ["https://github.com/apple-oss-distributions/xnu/archive/refs/tags/xnu-12377.1.9.tar.gz"],
)

# FreeBSD kernel crypto for ndcrypto, file by file (kernel/neodarwin/crypto/freebsd.lock).
pinned_files = use_repo_rule("//rules:pinned_files.bzl", "pinned_files")

pinned_files(
    name = "freebsd_crypto",
    build_file = "//kernel/neodarwin/crypto:freebsd.BUILD",
    lockfile = "//kernel/neodarwin/crypto:freebsd.lock",
    url_template = "https://raw.githubusercontent.com/freebsd/freebsd-src/{commit}/{path}",
)

# Embedded Swift toolchain (language policy T3) located on the host until the
# pinned NeoDarwin toolchain lands (P0-02). See toolchains/embedded/repo.bzl.
nd_embedded_swift = use_repo_rule("//toolchains/embedded:repo.bzl", "nd_embedded_swift")

nd_embedded_swift(name = "nd_embedded_swift")
