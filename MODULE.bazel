# LLVM's runtimes as Apple ships them (compiler-rt builtins, libunwind,
# libc++abi, libc++): Apple's fork at the Swift 6.2 release, LLVM 19.1.5,
# which Xcode 26 and macOS 26.0 carry (docs/base/libsystem.md).
http_archive(
    name = "llvm_project",
    build_file_content = """filegroup(name = "all", srcs = glob(["compiler-rt/lib/builtins/**", "libunwind/include/**", "libunwind/src/**", "libcxxabi/include/**", "libcxxabi/src/**", "libcxxabi/lib/**", "libcxx/include/**", "libcxx/src/**", "libcxx/lib/**", "libcxx/vendor/**"]), visibility = ["//visibility:public"])""",
    sha256 = "394a5ac36216820031f5ab70d78eeb8cf466d868ce436b20e857282d6408c5bd",
    strip_prefix = "llvm-project-swift-6.2-RELEASE",
    urls = ["https://github.com/swiftlang/llvm-project/archive/refs/tags/swift-6.2-RELEASE.tar.gz"],
)

