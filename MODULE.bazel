)""",
    sha256 = "3b0bfb7a9b0170fb8f8cf4018813eadaa9be4491b3a79e7ac346ee4736fd646d",
    strip_prefix = "IOStorageFamily-IOStorageFamily-331",
    urls = ["https://github.com/apple-oss-distributions/IOStorageFamily/archive/refs/tags/IOStorageFamily-331.tar.gz"],
)

