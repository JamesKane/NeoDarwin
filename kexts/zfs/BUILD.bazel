# OpenZFS for NeoDarwin (P3-01, docs/architecture/filesystems.md): zfs.kext
# and the zpool and zfs commands, from the OpenZFS on OS X fork's macOS OS
# layer (@openzfs, kexts/zfs/upstream.lock) with NeoDarwin's layer at
# os/neodarwin (patches/). CDDL-1.0 (THIRD_PARTY_NOTICES.md).
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//rules:base.bzl", "base_library")
load("//rules:cc.bzl", "lang_audit_test")
load("//rules:kext.bzl", "nd_kext")

package(default_visibility = ["//visibility:public"])

_PORT = glob([
    "include/*.h",
    "patches/*.patch",
]) + ["common.sh"]

# zfs.kext: SPL, ZFS, ICP, Lua and zstd in one kext, as on macOS; linked
# into //kernel:sbsa_zfs_kc.
nd_kext(
    name = "zfs",
    bundle = "zfs.kext",
    data = _PORT + [
        "kext_sources.txt",
        "//kernel/neodarwin/pthread:kernel_srcs",  # compat/TargetConditionals.h
    ],
    script = "kext.sh",
    srcs = "@openzfs//:all",
    upstream_headers = ["@apple_iostoragefamily//:headers"],
)

# The userland (user.sh): a private static zlib (Apple's zlib-100.120.1)
# until the base has zlib (P3-02), and the libraries as static archives
# (libs.sh: libzfs.a, libzpool.a), all in build-only usr/local paths.
_USER = _PORT + glob(["compat/*"]) + [
    "user.sh",
    "//base:commands.sh",
]

base_library(
    name = "zlib",
    data = ["//base:commands.sh"],
    deps = ["//base:root"],
    script = "zlib.sh",
    srcs = "@apple_zlib//:all",
    sysroot = "//base:sysroot",
)

base_library(
    name = "zfs_libs",
    data = _USER,
    deps = [
        "//base:root",
        "//base:libcrypto_dylib",
        ":zlib",
    ],
    script = "libs.sh",
    srcs = "@openzfs//:all",
    sysroot = "//base:sysroot",
)

_USER_DEPS = [
    "//base:root",
    "//base:libcrypto_dylib",
    ":zlib",
    ":zfs_libs",
]

# zpool and zfs at /sbin, zinject and zstream at /usr/bin, zdb and zhack at
# /usr/sbin (userland.sh).
base_library(
    name = "zfs_commands",
    data = _USER,
    deps = _USER_DEPS,
    script = "userland.sh",
    srcs = "@openzfs//:all",
    sysroot = "//base:sysroot",
)

# The test suite's helpers at /usr/share/zfs/zfs-tests/bin (test_commands.sh).
base_library(
    name = "zfs_test_commands",
    data = _USER,
    deps = _USER_DEPS,
    script = "test_commands.sh",
    srcs = "@openzfs//:tests",
    sysroot = "//base:sysroot",
)

# The OpenZFS test suite's scripts for the groups of tests/groups.txt, with
# tests/patches, and the runner, nd-zfs-tests (P3-01 checkpoint 2,
# docs/architecture/filesystems.md §7): usr/share/zfs. For
# //images:zfs_test_disk and //kernel:sbsa_zfs_suite_test.
base_library(
    name = "zfs_test_suite",
    data = glob(["tests/patches/*.patch"], allow_empty = True) + [
        "tests/groups.txt",
        "tests/nd-zfs-tests.ksh",
    ],
    script = "tests/suite.sh",
    srcs = "@openzfs//:tests",
    sysroot = "//base:sysroot",
)

exports_files([
    "tests/expected.tsv",
    "tests/groups.txt",
    "tests/suite_test.sh",
])

# The kext against the SBSA baseline (//kernel:sbsa_isa_audit's): no
# instruction past Armv8.2 except the runtime-gated ones in isa_audit.txt.
sh_test(
    name = "zfs_isa_audit",
    size = "small",
    srcs = ["//tools/xnu:isa_audit.sh"],
    args = [
        "--mattr +v8.2a,+rcpc,+dotprod,+aes,+sha2,+fullfp16",
        "$(rootpath :zfs)",
        "$(rootpath isa_audit.txt)",
    ],
    data = [
        "isa_audit.txt",
        ":zfs",
    ],
    tags = ["kernel"],
)

lang_audit_test(
    name = "zfs_lang_audit",
    srcs = glob([
        "compat/*",
        "include/*.h",
    ]),
)
