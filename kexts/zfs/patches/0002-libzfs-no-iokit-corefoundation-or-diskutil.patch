--- a/lib/libzfs_core/os/neodarwin/libzfs_core_ioctl.c
+++ b/lib/libzfs_core/os/neodarwin/libzfs_core_ioctl.c
@@ -22,7 +22,7 @@
 #include <sys/param.h>
 #include <sys/sysctl.h>
 #include <sys/zfs_ioctl.h>
-#include <os/macos/zfs/sys/zfs_ioctl_compat.h>
+#include <os/neodarwin/zfs/sys/zfs_ioctl_compat.h>
 #include <err.h>
 #include <libzfs_core.h>
 #include "libzfs_core_impl.h"
